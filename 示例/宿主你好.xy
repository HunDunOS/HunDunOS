@ ============================================================================
@  宿主版 hello —— 这个新语程序在 Linux 上直接跑，不用开 QEMU
@
@  看看它能用什么：
@    印串(串)   打字符串
@    印(数)     打数字
@    出(字节)   打一个字节（10 = 换行）
@    清()       清屏（用的是终端 ANSI 转义）
@    dy / rg / wx / 数组 / 结构体 …… 语言的全都一样
@  不能用的：
@    绘块 / 绘框 / 绘点 —— 终端里没有像素
@    端入 / 端出        —— 用户态没有端口权限
@ ============================================================================

hs 主() -> u32 {
    清()
    印串("════════════════════════════════")
    出(10)
    印串("  新语 · 宿主版（跑在 Linux 上）")
    出(10)
    印串("════════════════════════════════")
    出(10)
    出(10)

    印串("① 打字：印串 直接输出")
    出(10)
    印串("② 算数：1 到 10 的和 = ")
    kb i: u32 = 1
    kb 和: u32 = 0
    dy i <= 10 {
        和 = 和 + i
        i = i + 1
    }
    印(和)
    出(10)
    出(10)

    印串("③ 数组 + 循环：")
    出(10)
    kb 表[10]: u32
    i = 0
    dy i < 10 {
        表[i] = i * i
        i = i + 1
    }
    i = 0
    dy i < 10 {
        印串("   ")
        印(i)
        印串(" 的平方 = ")
        印(表[i])
        出(10)
        i = i + 1
    }
    出(10)

    印串("④ 危险块 wx 里能直接读写内存：")
    出(10)
    kb 缓[64]: u32
    kb 址: u32 = 0
    wx { 址 = 地址(缓) }
    wx { ^(址 + 0) = 72 }      @ 'H'
    wx { ^(址 + 1) = 101 }     @ 'e'
    wx { ^(址 + 2) = 108 }     @ 'l'
    wx { ^(址 + 3) = 108 }     @ 'l'
    wx { ^(址 + 4) = 111 }     @ 'o'
    wx { ^(址 + 5) = 0 }
    印串("   手写内存拼出来的串：")
    印串(址)
    出(10)
    出(10)

    印串("⑤ 函数：")
    出(10)
    印串("   斐波那契(20) = ")
    印(斐波(20))
    出(10)
    出(10)

    印串("跑完了。")
    出(10)
    fh 0
}

hs 斐波(n: u32) -> u32 {
    rg n < 2 { fh n }
    fh 斐波(n - 1) + 斐波(n - 2)
}
