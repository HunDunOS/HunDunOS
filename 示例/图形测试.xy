@ 图形能力自检 —— 验证帧缓冲、绘块、绘字、鼠标都在工作
hs 主() -> u32 {
    印("screen ")
    印(屏宽())
    印("x")
    印(屏高())
    印("  fb=")
    印(帧址())
    印("\n")

    @ 背景渐变
    kb y: u32 = 0
    xh {
        rg y >= 屏高() { tc }
        kb c: u32 = 16 + y * 40 / 600
        kb col: u32 = c * 65536 + (c + 20) * 256 + (c + 45)
        绘块(0, y, 屏宽(), 1, col)
        y = y + 1
    }

    @ 标题
    绘字(40, 40, "混沌 HunDun OS", 0xFFFFFF)
    绘字(40, 70, "自研引导器 · VBE 800x600 · 新语内核", 0xCCDDFF)

    @ 色块
    绘块(40, 120, 120, 80, 0xE0554A)
    绘块(180, 120, 120, 80, 0x4AA55A)
    绘块(320, 120, 120, 80, 0x4A7AE0)
    绘框(40, 120, 400, 80, 0xFFFFFF)

    @ 半透明面板
    绘块混(40, 230, 400, 120, 0x101820, 160)
    绘框(40, 230, 400, 120, 0x6A8AC0)
    绘字(60, 250, "鼠标移动看看", 0xFFFFFF)
    绘字(60, 280, "1234567890 abcXYZ", 0xFFFFFF)

    xh {
        kb mx: u32 = 鼠x()
        kb my: u32 = 鼠y()
        绘块(mx - 6, my - 6, 13, 13, 0xFFFFFF)
        绘块(mx - 4, my - 4, 9, 9, 0x203040)
        绘块(mx - 2, my - 2, 5, 5, 0xFFFFFF)
        睡(20)
    }
    fh 0
}
