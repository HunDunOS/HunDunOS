@ ============================================================================
@  网卡模块（网卡.xy）—— NE2000 驱动，全用新语写
@
@  为什么选 NE2000：
@    · 只用端口 I/O（我们有 端入/端出/端入字/端出字），不需要 MMIO
@    · 寄存器就 32 个，文档最短
@    · QEMU 支持：-device ne2k_pci
@
@  PCI 身份：厂商 0x10EC（Realtek）设备 0x8029
@  BAR0 = I/O 端口基址
@
@  这一版先做到【能跟芯片说上话】：找到它 → 复位 → 读回 MAC 地址。
@  收发帧在下一步。
@ ============================================================================

@ 借内核的东西（链接时合并）

@ ---- 网卡自己的状态 ----
qj 卡基址: u32              @ BAR0：I/O 端口基址
qj 卡在: u32                @ 0 = 没找到
qj 卡MAC[6]: u32            @ 物理地址（每槽一字节）

@ ---- 收发帧用的缓冲（每槽一字节，用 ^(址+k) 按字节读写）----
qj 帧缓[1600]: u32          @ 发出去的帧
qj 帧址: u32
qj 帧长: u32
qj 收缓[1600]: u32          @ 收回来的帧
qj 收址: u32
qj 卡醒: u32                @ 网卡已经初始化过了吗
qj 目标IP[4]: u32           @ 要 ping 谁的 IP
qj 网关MAC[6]: u32          @ 网关的 MAC（出网就靠它）
qj 回显序: u32              @ ICMP 序号

@ ---- 寄存器名字（有人读代码时好认）----
@   CR=0x00 PSTART=0x01 PSTOP=0x02 BNRY=0x03 TPSR=0x04
@   TBCR0=0x05 TBCR1=0x06 ISR=0x07 RSAR0=0x08 RSAR1=0x09
@   RBCR0=0x0A RBCR1=0x0B RCR=0x0C TCR=0x0D DCR=0x0E IMR=0x0F
@   DATA=0x10  复位=0x1F

hs 卡写(寄存器: u32, 值: u32) -> u32 {
    端出(卡基址 + 寄存器, 值)
    fh 0
}

hs 卡读(寄存器: u32) -> u32 {
    fh 端入(卡基址 + 寄存器)
}

@ ---------------------------------------------------------------------------
@  找网卡：扫 PCI，找 0x10EC:0x8029，把 BAR0（I/O 基址）取出来
@ ---------------------------------------------------------------------------
hs 网卡_找() -> u32 {
    卡在 = 0
    kb bus: u32 = 0
    dy bus < 8 {
        kb dev: u32 = 0
        dy dev < 32 {
            kb id: u32 = 机器_PCI读(bus, dev, 0, 0)
            rg id != 0xFFFFFFFF {
                @ ★ 注意括号：位与的优先级比 == 低，不加括号会变成 id wy (0xFFFF==0x10EC)
                rg (id wy 0xFFFF) == 0x10EC {
                    rg (id / 65536) == 0x8029 {
                        kb 条: u32 = 机器_PCI读(bus, dev, 0, 16)
                        rg (条 wy 1) == 1 {
                            卡基址 = 条 wy 0xFFFC
                            卡在 = 1
                            fh 1
                        }
                    }
                }
            }
            dev = dev + 1
        }
        bus = bus + 1
    }
    fh 0
}

@ ---------------------------------------------------------------------------
@  复位芯片：读一次复位端口，然后等 ISR 的 RST 位（bit7）置起来
@ ---------------------------------------------------------------------------
hs 网卡_复位() -> u32 {
    @ QEMU 的 ne2000：地址会 &0x1F，写 0x1F 才是复位（读 0x1F 会被当成 IMR）
    端出(卡基址 + 0x1F, 0)
    @ 给它一点时间（不用等 ISR，QEMU 不复位那一位）
    kb i: u32 = 0
    kb 空: u32 = 0
    dy i < 2000 { 空 = 空 + 1  i = i + 1 }
    fh 1
}


@ ---------------------------------------------------------------------------
@  从芯片的 PROM 区读 6 字节 MAC
@
@  ★ 为什么不能自己编一个 MAC：
@    QEMU 的收包过滤用的是【芯片 PROM 里那份】（复位时 memcpy 了 -device 配的 MAC，
@    再做一个"偶数位复制"）。我们写进 PAR 寄存器的那个只会进 s->phys，
@    QEMU 从来不把 phys 同步回 PROM → 过滤用的还是它的 MAC → 单播帧全被丢掉。
@    真驱动也是从 PROM 读，所以这不是迁就模拟器，是把驱动写对。
@ ---------------------------------------------------------------------------
hs 网卡_读PROM() -> u32 {
    kb i: u32 = 0
    dy i < 32 {
        wx { ^(收址 + i) = 0 }
        i = i + 1
    }
    卡写(0x08, 0x00)                    @ RSAR = 0（PROM 就在内部地址 0）
    卡写(0x09, 0x00)
    卡写(0x0A, 32)                      @ 读 32 字节
    卡写(0x0B, 0x00)
    卡写(0x00, 0x0A)                    @ 远端读（START，不能置 STOP）
    i = 0
    dy i < 16 {
        kb w: u32 = 端入字(卡基址 + 0x10)
        wx { ^(收址 + i * 2) = w wy 255 }
        wx { ^(收址 + i * 2 + 1) = (w / 256) wy 255 }
        i = i + 1
    }
    卡写(0x00, 0x22)
    i = 0
    dy i < 6 {
        kb v: u32 = 0
        wx { v = ^(收址 + i * 2) }      @ 偶数位才是 MAC
        卡MAC[i] = v
        i = i + 1
    }
    fh 1
}

@ ---------------------------------------------------------------------------
@  初始化 → 从 PROM 读 MAC
@ ---------------------------------------------------------------------------
hs 网卡_初始化() -> u32 {
    卡写(0x0F, 0x00)              @ IMR = 0，先关中断（我们轮询）
    卡写(0x0E, 0x49)              @ DCR：字传输、普通模式
    卡写(0x0C, 0x00)              @ RCR 先关
    卡写(0x0D, 0x02)              @ TCR：普通（不环回）
    卡写(0x08, 0x00)              @ RSAR0
    卡写(0x09, 0x00)              @ RSAR1
    卡写(0x0A, 0x00)              @ RBCR0
    卡写(0x0B, 0x00)              @ RBCR1
    卡写(0x00, 0x21)              @ CR：page0、不 DMA、停止

    @ 接收环：0x46 到 0x80 页（每页 256 字节）
    卡写(0x01, 0x46)              @ PSTART
    卡写(0x02, 0x80)              @ PSTOP
    卡写(0x03, 0x45)              @ BNRY = PSTART-1（这样【第一个包】就落在 BNRY+1 页）
    卡写(0x07, 0xFF)              @ 清中断
    卡写(0x00, 0x22)              @ ★ 远端 DMA 要求网卡是【启动】的，先放它起来

    @ ★ 先做一次远端读，证明 DMA 通了；顺便再取一遍真正的 MAC
    网卡_读PROM()

    @ 切到 page1，把读到的 MAC 写进 PAR（驱动自己也留一份）
    卡写(0x00, 0x61)              @ CR：page1、停止
    kb i: u32 = 0
    dy i < 6 {
        卡写(0x01 + i, 卡MAC[i])
        i = i + 1
    }
    卡写(0x07, 0x46)              @ CURR（page1 的 0x07）
    卡写(0x00, 0x22)              @ 回 page0

    @ 打开接收：收广播 + 收发给自己
    卡写(0x0C, 0x04)
    卡写(0x0D, 0x00)
    卡写(0x0F, 0x00)
    卡写(0x07, 0xFF)
    卡写(0x00, 0x22)              @ CR：page0、启动
    fh 1
}

@ ---------------------------------------------------------------------------
@  自检：找 → 复位 → 初始化 → 打印 MAC
@ ---------------------------------------------------------------------------
hs 网卡_自检() -> u32 {
    屏设色(0x8FA6C8)
    屏串("  [网卡] 扫 PCI 找 NE2000…")
    屏换行()
    rg 网卡_找() == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 没找到（QEMU 要加 -device ne2k_pci）")
        屏换行()
        fh 0
    }
    屏设色(0x37C46A)
    屏串("  [网卡] 找到了，I/O 基址 0x")
    打十六(卡基址)
    屏换行()

    rg 网卡_复位() == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 复位超时")
        屏换行()
        fh 0
    }
    屏串("  [网卡] 复位完成，ISR=0x")
    打十六(卡读(0x07))
    屏换行()

    网卡_初始化()
    屏串("  [网卡] MAC = ")
    kb i: u32 = 0
    dy i < 6 {
        kb v: u32 = 卡MAC[i]
        kb 高: u32 = v / 16
        kb 低: u32 = v % 16
        rg 高 < 10 { 屏出(48 + 高) }
        rg 高 >= 10 { 屏出(87 + 高) }
        rg 低 < 10 { 屏出(48 + 低) }
        rg 低 >= 10 { 屏出(87 + 低) }
        rg i < 5 { 屏出(58) }
        i = i + 1
    }
    屏换行()
    wx {
        帧址 = 地址(帧缓)
        收址 = 地址(收缓)
    }
    卡醒 = 1
    @ ★ 这里以前跑一次「自环试」—— 现已去掉：QEMU 的 ne2000 模型
    @   根本没实现 TCR 的环回位（源码里 qemu_send_packet 之后直接返回，
    @   没有任何 s->tcr & EN_TCR_LB0 的判断）。真芯片能环回，QEMU 不能。
    @   收发的验证改用真网络：见 wen（ARP 问一次）。
    fh 1
}


@ ============================================================================
@  收发帧
@
@  NE2000 没有 MMIO，全靠【远端 DMA】：先把"芯片内部地址 + 字节数"写进
@  RSAR/RBCR，再把 CR 的命令位置成"远端读/写"，然后一个字一个字地过 0x10
@  这个数据口。发完之后还要单独下"发送"命令，再轮询 ISR 等它发完。
@ ============================================================================

@ 发一个帧：把 长 个字节从 址 送进芯片的 0x4000，然后让它发出去
hs 网卡_发帧(址: u32, 长: u32) -> u32 {
    rg 卡在 == 0 { fh 0 }
    kb 实长: u32 = 长                   @ 参数是不可变绑定，改不了它，另起一个
    rg 实长 < 60 { 实长 = 60 }          @ 以太网最小帧 60 字节（不含 FCS）
    rg 实长 > 1514 { fh 0 }
    kb 双: u32 = (实长 + 1) / 2         @ 字传输：取整到偶数个字节
    kb 字: u32 = 双 * 2

    卡写(0x00, 0x22)                    @ ★ 不能停网卡（STOP）：一停，进来的包全丢
    卡写(0x0F, 0x00)                    @ 关中断（我们只会轮询）
    卡写(0x08, 0x00)                    @ RSAR0 = 0x4000 低
    卡写(0x09, 0x40)                    @ RSAR1 = 0x40 → 芯片内部 0x4000
    卡写(0x0A, 字 wy 255)               @ RBCR0
    卡写(0x0B, (字 / 256) wy 255)       @ RBCR1
    卡写(0x00, 0x12)                    @ 远端写 DMA，开始

    kb i: u32 = 0
    dy i < 双 {
        kb a: u32 = 0
        kb b: u32 = 0
        wx { a = ^(址 + i * 2) }
        rg i * 2 + 1 < 实长 { wx { b = ^(址 + i * 2 + 1) } }
        端出字(卡基址 + 0x10, a + b * 256)
        i = i + 1
    }
    卡写(0x00, 0x22)                    @ 停 DMA

    卡写(0x04, 0x40)                    @ TPSR：从 0x40 页开始
    卡写(0x05, 字 wy 255)               @ TBCR0
    卡写(0x06, (字 / 256) wy 255)       @ TBCR1
    卡写(0x00, 0x26)                    @ 发送

    @ ★ 等发送结果要读【读表】的 0x04 = TSR，不是写表的 0x04 = TPSR。
    @   NE2000 的读写两个表是【不同】的寄存器 —— 这是最容易踩的一脚。
    @   TSR: bit0 = PTX（发成功）  bit1 = COL  bit2 = ABT  bit3 = CRS
    kb n: u32 = 0
    dy n < 2000000 {
        kb s: u32 = 卡读(0x04)
        rg (s wy 1) == 1 {
            卡写(0x07, 0x0A)            @ 应答 ISR 的 PTX 位
            卡写(0x00, 0x22)
            帧长 = 实长
            fh 1
        }
        n = n + 1
    }
    卡写(0x00, 0x22)
    fh 0
}

@ 收一帧：有就复制到 出址，返回它有多长；没有就返回 0
hs 网卡_收帧(出址: u32) -> u32 {
    rg 卡在 == 0 { fh 0 }
    @ ★ 有没有包，看 ISR 的 bit0（ENISR_RX）。以前这里读 0x07 当 CURR ——
    @   但 page 0 的 0x07 是【ISR】，CURR 只能在 page 1 读，所以那个判断一直是错的。
    kb isr: u32 = 卡读(0x07)
    rg (isr wy 1) == 0 { fh 0 }
    kb bnry: u32 = 卡读(0x03)           @ BNRY：最后一个【已经读过】的页
    @ ★ 下一个要读的包在 BNRY+1 页。在 BNRY 页读只会一遍遍重读上一个包 ——
    @   第一次能成，是因为 curpag 初值正好等于 BNRY，纯属巧合。
    kb 读页: u32 = bnry + 1
    rg 读页 >= 0x80 { 读页 = 0x46 }      @ 绕回 PSTART

    @ 先读 4 字节包头：状态、下一页、长度(低/高)
    卡写(0x08, 0x00)
    卡写(0x09, 读页)
    卡写(0x0A, 4)
    卡写(0x0B, 0)
    卡写(0x00, 0x0A)                    @ ★ 远端读 = NODMA 去掉 + START = 0x0A
                                        @   （写成 0x21 会置 STOP 位，QEMU 直接丢包）
    kb w0: u32 = 端入字(卡基址 + 0x10)
    kb w1: u32 = 端入字(卡基址 + 0x10)
    卡写(0x00, 0x22)

    @ ★ NE2000 的 4 字节包头是：p[0]=状态、p[1]=下一页页号、p[2..3]=长度(含头)
    @   （QEMU 源码：p[0]=rsr; p[1]=next>>8; p[2]=total_len; p[3]=total_len>>8）
    kb 次页: u32 = (w0 / 256) wy 255    @ p[1]
    kb 全长: u32 = w1 wy 0xFFFF         @ p[2..3]
    rg 全长 < 18 { fh 0 }               @ 包头 4 + 最小以太帧 14
    rg 全长 > 1518 { fh 0 }
    全长 = 全长 - 4
    rg 次页 < 0x46 { fh 0 }             @ 环外的指针不算（防野数据）
    rg 次页 > 0x80 { fh 0 }

    @ 再读正文
    卡写(0x08, 4)                       @ ★ 跳过那 4 字节包头
    卡写(0x09, 读页)                    @ ★ 数据在【本页】(BNRY)*256 + 4，
                                        @   不是 次页 —— 次页是【下一个包】的起点。
    kb 双: u32 = (全长 + 1) / 2
    卡写(0x0A, (双 * 2) wy 255)
    卡写(0x0B, ((双 * 2) / 256) wy 255)
    卡写(0x00, 0x0A)
    kb i: u32 = 0
    dy i < 双 {
        kb w: u32 = 端入字(卡基址 + 0x10)
        wx { ^(出址 + i * 2) = w wy 255 }
        rg i * 2 + 1 < 全长 { wx { ^(出址 + i * 2 + 1) = (w / 256) wy 255 } }
        i = i + 1
    }
    卡写(0x00, 0x22)
    卡写(0x07, 0x01)                    @ 应答 ISR 的 RX 位，不然下次还会读到同一页
    卡写(0x03, 次页 - 1)                @ BNRY 前进到刚收的那一页
    卡写(0x00, 0x22)                    @ 重新启动
    帧长 = 全长
    fh 全长
}

@ ---------------------------------------------------------------------------
@  自环试：把 TCR 设成环回，发一帧再自己收回来
@  这一步不需要 ARP、不需要对端 —— 它证明【发】和【收】两个方向都通了
@ ---------------------------------------------------------------------------
hs 网卡_自环试() -> u32 {
    屏设色(0x8FA6C8)
    屏串("  [网卡] 自环试：TCR 置环回，发 60 字节再收回来…")
    屏换行()
    卡写(0x0D, 0x02)                    @ TCR：LB0 = 1，环回模式
    卡写(0x0C, 0x0D)                    @ RCR：PROM + 多播 + 广播，先全收（自环时地址是假的）
    卡写(0x00, 0x22)

    @ 造一帧：前 6 字节必须是【广播地址】，否则网卡按地址过滤会直接丢掉它
    kb i: u32 = 0
    dy i < 6 {
        wx { ^(帧址 + i) = 0xFF }
        i = i + 1
    }
    dy i < 60 {
        wx { ^(帧址 + i) = i wy 255 }
        i = i + 1
    }

    rg 网卡_发帧(帧址, 60) == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 发失败（ISR 一直没置 PTX）")
        屏换行()
        @ ---- 诊断：把关键寄存器的值打出来 ----
        屏串("    TSR=0x")
        打十六(卡读(0x04))
        屏串("  ISR=0x")
        打十六(卡读(0x07))
        屏串("  BNRY=0x")
        打十六(卡读(0x03))
        屏串("  RSR=0x")
        打十六(卡读(0x0C))
        屏换行()
        卡写(0x0D, 0x00)
        fh 0
    }
    屏设色(0x37C46A)
    屏串("  [网卡] 发出去了")
    屏换行()

    @ 等它出现在接收环里
    kb n: u32 = 0
    kb 得: u32 = 0
    dy n < 200000 {
        kb l: u32 = 网卡_收帧(收址)
        rg l > 0 {
            得 = l
            tc
        }
        n = n + 1
    }
    rg 得 == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 没收到（自环没成）")
        屏换行()
        卡写(0x0D, 0x00)
        fh 0
    }
    屏设色(0x9AC4FF)
    屏串("  [网卡] 收到 ")
    屏数(得)
    屏串(" 字节")
    屏换行()

    @ 逐字节比对前 60 字节
    kb 同: u32 = 1
    kb j: u32 = 0
    dy j < 60 {
        kb a: u32 = 0
        kb b: u32 = 0
        wx { a = ^(帧址 + j) }
        wx { b = ^(收址 + j) }
        rg a != b { 同 = 0 }
        j = j + 1
    }
    rg 同 == 1 {
        屏设色(0x37C46A)
        屏串("  [网卡] 逐字节一致 ✓ —— 收发两个方向都通了")
        屏换行()
    }
    rg 同 == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 字节不一致 ✗")
        屏换行()
    }
    卡写(0x0D, 0x00)                    @ 退出环回
    卡写(0x0C, 0x04)                    @ 恢复：只收广播
    卡写(0x00, 0x22)
    fh 同
}

@ ============================================================================
@  七、ARP —— 问「某个 IP 的 MAC 是多少」
@
@  ★ 为什么先做 ARP 而不是 ping：
@    发 IP 包之前必须先知道对方的 MAC。ARP 一次就能同时验证
@    【发得出去】和【收得回来】两件事 —— 而且不用先有 IP/ICMP。
@
@  QEMU 用户网络的固定值：本机 10.0.2.15   网关 10.0.2.2   DNS 10.0.2.3
@ ============================================================================

@ 造一个 ARP 请求帧，问 a.b.c.d 的 MAC
hs 网卡_ARP问(a: u32, b: u32, c: u32, d: u32) -> u32 {
    rg 卡在 == 0 { fh 0 }
    kb i: u32 = 0

    @ 以太头：目的 = 广播
    i = 0
    dy i < 6 {
        wx { ^(帧址 + i) = 0xFF }
        i = i + 1
    }
    @ 源 = 我们自己的 MAC
    i = 0
    dy i < 6 {
        wx { ^(帧址 + 6 + i) = 卡MAC[i] }
        i = i + 1
    }
    @ 类型 = 0x0806（ARP）
    wx { ^(帧址 + 12) = 0x08 }
    wx { ^(帧址 + 13) = 0x06 }

    @ ARP 正文
    wx { ^(帧址 + 14) = 0x00 }
    wx { ^(帧址 + 15) = 0x01 }          @ 硬件类型 = 以太网
    wx { ^(帧址 + 16) = 0x08 }
    wx { ^(帧址 + 17) = 0x00 }          @ 协议类型 = IPv4
    wx { ^(帧址 + 18) = 6 }             @ 硬件地址长度
    wx { ^(帧址 + 19) = 4 }             @ 协议地址长度
    wx { ^(帧址 + 20) = 0x00 }
    wx { ^(帧址 + 21) = 0x01 }          @ 操作 = 请求
    i = 0
    dy i < 6 {
        wx { ^(帧址 + 22 + i) = 卡MAC[i] }   @ 发送方 MAC
        i = i + 1
    }
    wx { ^(帧址 + 28) = 10 }            @ 发送方 IP 10.0.2.15
    wx { ^(帧址 + 29) = 0 }
    wx { ^(帧址 + 30) = 2 }
    wx { ^(帧址 + 31) = 15 }
    i = 0
    dy i < 6 {
        wx { ^(帧址 + 32 + i) = 0 }     @ 目标 MAC：问的时候还不知道，填 0
        i = i + 1
    }
    wx { ^(帧址 + 38) = a }             @ 目标 IP
    wx { ^(帧址 + 39) = b }
    wx { ^(帧址 + 40) = c }
    wx { ^(帧址 + 41) = d }

    @ 补到 60 字节（以太网最小帧）
    i = 42
    dy i < 60 {
        wx { ^(帧址 + i) = 0 }
        i = i + 1
    }
    fh 网卡_发帧(帧址, 60)
}

@ 等一个 ARP 回复。收到就返回帧长，超时返回 0
hs 网卡_ARP等() -> u32 {
    kb n: u32 = 0
    dy n < 400000 {
        kb l: u32 = 网卡_收帧(收址)
        rg l > 0 {
            kb t1: u32 = 0
            kb t2: u32 = 0
            wx { t1 = ^(收址 + 12) }
            wx { t2 = ^(收址 + 13) }
            rg t1 == 0x08 {
                rg t2 == 0x06 {
                    kb op: u32 = 0
                    wx { op = ^(收址 + 21) }
                    rg op == 2 { fh l }         @ 2 = 应答
                }
            }
        }
        n = n + 1
    }
    fh 0
}

@ 把 收址 + off 起的 n 个字节按 MAC 格式打出来
hs 印MAC(off: u32) -> u32 {
    kb i: u32 = 0
    dy i < 6 {
        kb v: u32 = 0
        wx { v = ^(收址 + off + i) }
        kb 高: u32 = v / 16
        kb 低: u32 = v % 16
        rg 高 < 10 { 屏出(48 + 高) }
        rg 高 >= 10 { 屏出(87 + 高) }
        rg 低 < 10 { 屏出(48 + 低) }
        rg 低 >= 10 { 屏出(87 + 低) }
        rg i < 5 { 屏出(58) }
        i = i + 1
    }
    fh 0
}

@ 完整一次：问 → 等 → 打印
hs 网卡_问(a: u32, b: u32, c: u32, d: u32) -> u32 {
    屏设色(0x8FA6C8)
    屏串("  [网卡] 问 ")
    屏数(a)
    屏出(46)
    屏数(b)
    屏出(46)
    屏数(c)
    屏出(46)
    屏数(d)
    屏串(" 的 MAC…")
    屏换行()
    rg 网卡_卡起来() == 0 { fh 0 }

    rg 网卡_ARP问(a, b, c, d) == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 发不出去（TSR 没置 PTX）")
        屏换行()
        fh 0
    }
    屏设色(0x8FA6C8)
    屏串("  [网卡] 发出去了，等回复…")
    屏换行()

    rg 网卡_ARP等() == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 没收到回复（超时）")
        屏换行()
        @ ---- 诊断 ----
        屏串("    ISR=0x")
        打十六(卡读(0x07))
        屏串("  BNRY=0x")
        打十六(卡读(0x03))
        屏串("  TSR=0x")
        打十六(卡读(0x04))
        屏换行()
        卡写(0x00, 0x42)
        屏串("    CURPAG=0x")
        打十六(卡读(0x07))
        卡写(0x00, 0x22)
        卡写(0x00, 0x82)
        屏串("  PSTART=0x")
        打十六(卡读(0x01))
        屏串("  PSTOP=0x")
        打十六(卡读(0x02))
        卡写(0x00, 0x22)
        屏换行()
        屏串("    我们的 MAC=")
        kb q: u32 = 0
        dy q < 6 {
            kb v: u32 = 卡MAC[q]
            kb 高: u32 = v / 16
            kb 低: u32 = v % 16
            rg 高 < 10 { 屏出(48 + 高) }
            rg 高 >= 10 { 屏出(87 + 高) }
            rg 低 < 10 { 屏出(48 + 低) }
            rg 低 >= 10 { 屏出(87 + 低) }
            rg q < 5 { 屏出(58) }
            q = q + 1
        }
        屏换行()
        fh 0
    }
    屏设色(0x37C46A)
    屏串("  [网卡] 收到回复！")
    屏换行()
    屏设色(0xE8F0FF)
    屏串("         ")
    屏数(a)
    屏出(46)
    屏数(b)
    屏出(46)
    屏数(c)
    屏出(46)
    屏数(d)
    屏串("  的 MAC = ")
    印MAC(22)                            @ ARP 回复里发送方 MAC 在第 22 字节
    屏换行()
    fh 1
}

@ 叫醒网卡（找 + 复位 + 初始化 + 把缓冲地址填好）；已经醒了就直接返回 1
hs 网卡_卡起来() -> u32 {
    rg 卡醒 == 1 { fh 1 }
    wx {
        帧址 = 地址(帧缓)
        收址 = 地址(收缓)
    }
    rg 网卡_找() == 0 { fh 0 }
    网卡_复位()
    网卡_初始化()
    卡醒 = 1
    fh 1
}

@ ============================================================================
@  八、IP + ICMP —— ping
@
@  要出网（比如 8.8.8.8）和 ping 网段内（比如 10.0.2.2），做法只差一步：
@    以太头的目的 MAC 永远填【网关的 MAC】（网段外）
@    IP 头的目的地址填【真正的目标】
@  剩下交给 slirp 去 NAT。
@ ============================================================================

@ 解析 "a.b.c.d" 进 目标IP。解析不了返回 0
hs 解析IP(s: u32) -> u32 {
    kb i: u32 = 0
    kb k: u32 = 0
    kb v: u32 = 0
    kb 有: u32 = 0
    dy k < 4 {
        目标IP[k] = 0
        k = k + 1
    }
    k = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        rg c == 46 {
            目标IP[k] = v
            k = k + 1
            v = 0
            i = i + 1
            jx
        }
        rg c < 48 { tc }
        rg c > 57 { tc }
        v = v * 10 + (c - 48)
        有 = 1
        i = i + 1
    }
    rg 有 == 0 { fh 0 }
    rg k != 3 { fh 0 }
    目标IP[3] = v
    fh 1
}

@ 16 位补码校验和（IP 头和 ICMP 都用它）。长必须是偶数
hs 校验和(址: u32, 长: u32) -> u32 {
    kb s: u32 = 0
    kb i: u32 = 0
    dy i < 长 {
        kb a: u32 = 0
        kb b: u32 = 0
        wx { a = ^(址 + i) }
        wx { b = ^(址 + i + 1) }
        s = s + a + b * 256
        i = i + 2
    }
    s = (s wy 0xFFFF) + (s / 65536)     @ 折叠进位，两次就够
    s = (s wy 0xFFFF) + (s / 65536)
    fh (s wy 0xFFFF) yh 0xFFFF          @ 取反
}

@ 印 a.b.c.d
hs 印IP4(a: u32, b: u32, c: u32, d: u32) -> u32 {
    屏数(a)
    屏出(46)
    屏数(b)
    屏出(46)
    屏数(c)
    屏出(46)
    屏数(d)
    fh 0
}

@ 印 目标IP
hs 印目标() -> u32 {
    印IP4(目标IP[0], 目标IP[1], 目标IP[2], 目标IP[3])
    fh 0
}

@ 造一个 ICMP 回显请求，发给 目标IP（以太头走 网关MAC）
hs 网卡_发PING() -> u32 {
    kb i: u32 = 0
    kb b: u32 = 0

    @ ---- 以太头 0..13 ----
    i = 0
    dy i < 6 {
        wx { ^(帧址 + i) = 网关MAC[i] }
        i = i + 1
    }
    i = 0
    dy i < 6 {
        wx { ^(帧址 + 6 + i) = 卡MAC[i] }
        i = i + 1
    }
    wx { ^(帧址 + 12) = 0x08 }
    wx { ^(帧址 + 13) = 0x00 }

    @ ---- IP 头 14..33 ----
    wx { ^(帧址 + 14) = 0x45 }          @ 版本 4 / 头长 5（20 字节）
    wx { ^(帧址 + 15) = 0x00 }          @ TOS
    wx { ^(帧址 + 16) = 0x00 }          @ 总长：20 + 40 = 60
    wx { ^(帧址 + 17) = 60 }
    wx { ^(帧址 + 18) = 0x12 }          @ 标识
    wx { ^(帧址 + 19) = 0x34 }
    wx { ^(帧址 + 20) = 0x00 }          @ 不分片
    wx { ^(帧址 + 21) = 0x00 }
    wx { ^(帧址 + 22) = 64 }            @ TTL
    wx { ^(帧址 + 23) = 1 }             @ 协议 = ICMP
    wx { ^(帧址 + 24) = 0 }             @ 校验和先填 0，算完再回填
    wx { ^(帧址 + 25) = 0 }
    wx { ^(帧址 + 26) = 10 }            @ 源 10.0.2.15
    wx { ^(帧址 + 27) = 0 }
    wx { ^(帧址 + 28) = 2 }
    wx { ^(帧址 + 29) = 15 }
    i = 0
    dy i < 4 {
        wx { ^(帧址 + 30 + i) = 目标IP[i] }
        i = i + 1
    }
    b = 校验和(帧址 + 14, 20)
    wx { ^(帧址 + 24) = b wy 255 }
    wx { ^(帧址 + 25) = (b / 256) wy 255 }

    @ ---- ICMP 34..73（8 字节头 + 32 字节载荷）----
    wx { ^(帧址 + 34) = 8 }             @ 类型 8 = 回显请求
    wx { ^(帧址 + 35) = 0 }             @ 代码
    wx { ^(帧址 + 36) = 0 }
    wx { ^(帧址 + 37) = 0 }             @ 校验和先填 0
    wx { ^(帧址 + 38) = 0x1D }          @ 标识
    wx { ^(帧址 + 39) = 0x01 }
    回显序 = 回显序 + 1
    wx { ^(帧址 + 40) = 回显序 wy 255 }
    wx { ^(帧址 + 41) = (回显序 / 256) wy 255 }
    i = 0
    dy i < 32 {
        wx { ^(帧址 + 42 + i) = 97 + i }    @ 载荷
        i = i + 1
    }
    b = 校验和(帧址 + 34, 40)
    wx { ^(帧址 + 36) = b wy 255 }
    wx { ^(帧址 + 37) = (b / 256) wy 255 }

    fh 网卡_发帧(帧址, 74)
}

@ 等一个 ICMP 回显应答
hs 网卡_等PING() -> u32 {
    kb n: u32 = 0
    dy n < 600000 {
        kb l: u32 = 网卡_收帧(收址)
        rg l > 0 {
            kb t1: u32 = 0
            kb t2: u32 = 0
            wx { t1 = ^(收址 + 12) }
            wx { t2 = ^(收址 + 13) }
            rg t1 == 0x08 {
                rg t2 == 0x00 {
                    kb 头长: u32 = 0
                    wx { 头长 = ^(收址 + 14) }
                    头长 = (头长 wy 15) * 4          @ IHL，报文头不一定是 20 字节
                    kb 协: u32 = 0
                    wx { 协 = ^(收址 + 23) }
                    rg 协 == 1 {
                        kb ty: u32 = 0
                        wx { ty = ^(收址 + 14 + 头长) }
                        rg ty == 0 { fh l }          @ 0 = 回显应答
                    }
                }
            }
        }
        n = n + 1
    }
    fh 0
}

@ ping 一次：ARP 网关 → 发 ICMP → 等应答
hs 网卡_PING(参址: u32) -> u32 {
    rg 网卡_卡起来() == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 找不到网卡")
        屏换行()
        fh 0
    }
    @ 没给参数就默认 8.8.8.8
    rg 解析IP(参址) == 0 {
        目标IP[0] = 8
        目标IP[1] = 8
        目标IP[2] = 8
        目标IP[3] = 8
    }

    屏设色(0x8FA6C8)
    屏串("  [网卡] ping ")
    印目标()
    屏串(" …")
    屏换行()

    @ 第一步：问网关的 MAC（网段外的目标要发给网关）
    屏串("  [网卡] 先问网关 10.0.2.2 的 MAC…")
    屏换行()
    rg 网卡_ARP问(10, 0, 2, 2) == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] ARP 发不出去")
        屏换行()
        fh 0
    }
    rg 网卡_ARP等() == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 网关没应答")
        屏换行()
        fh 0
    }
    kb i: u32 = 0
    dy i < 6 {
        kb v: u32 = 0
        wx { v = ^(收址 + 22 + i) }
        网关MAC[i] = v
        i = i + 1
    }
    屏串("  [网卡] 网关 MAC = ")
    印MAC(22)
    屏换行()

    @ 第二步：发 ICMP 回显，计时
    kb 起: u32 = 毫秒()
    rg 网卡_发PING() == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] ICMP 发不出去")
        屏换行()
        fh 0
    }
    屏串("  [网卡] 包发出去了，等回显应答…")
    屏换行()

    @ 第三步：等应答
    rg 网卡_等PING() == 0 {
        屏设色(0xE0554A)
        屏串("  [网卡] 没等到回显应答（超时）")
        屏换行()
        fh 0
    }
    kb 停: u32 = 毫秒()
    屏设色(0x37C46A)
    屏串("  [网卡] 收到回显应答！ ")
    印目标()
    屏串("  往返 ")
    屏数(停 - 起)
    屏串(" 毫秒")
    屏换行()
    fh 1
}
