# ============================================================================
#  混沌 包模块（包.xy）—— 读 .bao v2
#  装包 = 把包里的对象子图【合并】进对象区（不是解压）
# ============================================================================

# ---- 全部全局声明都放这里：新语是【先声明后用】 ----
qj 盘缓冲[512]: u32
qj 盘对象数: u32
qj 盘索引起: u32
qj 盘追加: u32
qj 包缓冲[16384]: u32          @ 从盘上读进来的包（每槽一字节）
qj 包缓冲址: u32
qj 包址: u32                   @ 包在内存里的地址
qj 包起始LBA: u32
qj 包扇区数: u32
qj 包成员数: u32
qj 包清单: u32                 @ 清单在包里的【偏移】（不是地址！包取32 收的是偏移）
qj 包数据: u32                 @ 数据区开始地址
qj 包长: u32
qj 包清单哈希: u32
qj 包世代: u32
qj 包能力: u32
qj 视图能力[4]: u32          @ 与 视图.xy 共享（.comm 合并成一份）

@ ---- shou（手）：插件表。装一个包 = 长出一条命令 ----
qj 插件名[16]: u32          @ 命令名的哈希
qj 插件口[16]: u32          @ 入口地址（已经搬到 0x400000 之后的绝对地址）
qj 插件数: u32
qj 当前视图: u32             @ 同上
qj 包可执行入口: u32
qj 包可执行偏移: u32
qj 包可执行长: u32
qj 包加载址: u32
qj 包装进数: u32
qj 包名址: u32
qj 包名[128]: u32
qj 包装[512]: u32
qj 包装址: u32

# ============================================================================
#  混沌 包模块（包.xy）—— 读 .bao v2
#
#  包 = 一个对象。装包 = 把包里的对象子图【合并】进对象区（不是解压）。
#
#  v2 包头（40 字节）
#    +0  魔数 "BAO2"      +4  版本       +8  成员数     +12 清单长度
#    +16 清单哈希         +20 世代       +24 上一个包    +28 能力位图
#    +32 包头自校验       +36 数据区长度  +40 成员清单开始
#
#  成员项（32 字节）
#    +0 名字哈希  +4 名字偏移  +8 名字长度  +12 内容哈希
#    +16 长度     +20 偏移     +24 类型     +28 入口偏移
# ============================================================================

@ 借用内核里的东西（链接时合并成同一份，这里只声明）


@ ---- 逐扇区从盘上读到缓冲 ----
hs 包_读盘(lba: u32, 扇区数: u32) -> u32 {
    kb i: u32 = 0
    dy i < 扇区数 {
        盘读扇区(lba + i)
        kb j: u32 = 0
        dy j < 256 {
            wx {
                ^(包缓冲址 + i * 512 + j * 2) = 盘缓冲[j * 2]
                ^(包缓冲址 + i * 512 + j * 2 + 1) = 盘缓冲[j * 2 + 1]
            }
            j = j + 1
        }
        i = i + 1
    }
    fh 1
}

@ ---- 从缓冲里按字节取 ----
hs 包取8(off: u32) -> u32 {
    kb v: u32 = 0
    wx { v = ^(包址 + off) }
    fh v
}

hs 包取32(off: u32) -> u32 {
    fh 包取8(off) + 包取8(off + 1) * 256 + 包取8(off + 2) * 65536 + 包取8(off + 3) * 16777216
}

@ ---- 校验：魔数 + 包头自校验 ----
hs 包_校验() -> u32 {
    rg 包取32(0) != 0x324F4142 { fh 0 }        @ "BAO2"
    rg 包取32(4) != 2 { fh 0 }
    kb h: u32 = 2166136261
    kb i: u32 = 0
    dy i < 32 {
        h = h yh 包取8(i)
        h = h * 16777619
        i = i + 1
    }
    rg h != 包取32(32) { fh 0 }
    包成员数 = 包取32(8)
    包清单 = 40                    @ ★ 偏移，不是地址 —— 包取32 自己会加 包址
    包数据 = 包址 + 40 + 包取32(12)  @ 这个才是地址（下面用 ^(包数据+…) 直接寻址）
    包长 = 包取32(36)
    包清单哈希 = 包取32(16)
    包世代 = 包取32(20)
    包能力 = 包取32(28)
    fh 1
}

@ ---- 第 i 个成员的名字（拷到出，返回长度）----
hs 包_成员名(i: u32, 出: u32) -> u32 {
    kb o: u32 = 包清单 + i * 32
    kb noff: u32 = 包取32(o + 4)
    kb nlen: u32 = 包取32(o + 8)
    kb j: u32 = 0
    dy j < nlen {
        kb v: u32 = 0
        wx {
            v = ^(包数据 + noff + j)
            ^(出 + j) = v
        }
        j = j + 1
    }
    wx { ^(出 + nlen) = 0 }
    fh nlen
}

hs 包_成员类型(i: u32) -> u32 {
    fh 包取32(包清单 + i * 32 + 24)
}

hs 包_成员长(i: u32) -> u32 {
    fh 包取32(包清单 + i * 32 + 16)
}

hs 包_成员哈希(i: u32) -> u32 {
    fh 包取32(包清单 + i * 32 + 12)
}

hs 包_能力名(v: u32) -> u32 {
    rg v == 0 { 屏串("数据")  fh 0 }
    rg v == 1 { 屏串("可执行")  fh 0 }
    rg v == 2 { 屏串("文档")  fh 0 }
    rg v == 3 { 屏串("字库")  fh 0 }
    屏串("?")
    fh 0
}

@ ---- 列清单 ----
hs 包_列() -> u32 {
    屏设色(0x9AC4FF)
    屏串("  包里 ")
    屏数(包成员数)
    屏串(" 个成员 · 世代 ")
    屏数(包世代)
    屏串(" · 清单哈希 ")
    打十六_包(包清单哈希)
    屏换行()
    kb i: u32 = 0
    dy i < 包成员数 {
        kb o: u32 = 包清单 + i * 32
        屏设色(0x6E86A8)
        屏串("    ")
        屏数(i + 1)
        屏串(". ")
        屏设色(0xE8F0FF)
        包_成员名(i, 包名址)
        屏串(包名址)
        屏设色(0x5F7A9C)
        屏串("  ")
        包_能力名(包_成员类型(i))
        屏串("  ")
        屏数(包_成员长(i))
        屏串(" 字节  内容哈希 ")
        打十六_包(包_成员哈希(i))
        rg 包_成员类型(i) == 1 {
            屏串("  入口 0x")
            打十六_包(包取32(o + 28))
        }
        屏换行()
        i = i + 1
    }
    fh 0
}

@ 打十六的小工具（避免和壳里的重名）
hs 打十六_包(v: u32) -> u32 {
    kb i: u32 = 0
    xh {
        kb 移: u32 = (7 - i) * 4
        kb t: u32 = (v / (1 << 移)) % 16
        rg t < 10 { 屏出(48 + t) }
        rg t >= 10 { 屏出(87 + t) }
        i = i + 1
        rg i >= 8 { tc }
    }
    fh 0
}


@ ---- FNV-1a：一个字符串的"名字哈希"（用来查插件表）----
hs 名字哈希(址: u32) -> u32 {
    kb h: u32 = 2166136261
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(址 + i) }
        rg c == 0 { tc }
        h = h yh c
        h = h * 16777619
        i = i + 1
    }
    rg h == 0 { h = 1 }                 @ 0 留给"没有"
    fh h
}

@ ---- 按命令名找插件并调用它。找到并跑了返回 1 ----
hs 插件_跑(名址: u32, 参址: u32) -> u32 {
    rg 插件数 == 0 { fh 0 }
    kb h: u32 = 名字哈希(名址)
    kb i: u32 = 0
    dy i < 插件数 {
        rg 插件名[i] == h {
            @ ★ 调用(地址,a,b,c,d) 压栈后【最后压的】落在 [esp+4]。
            @   插件声明的是单参数 插件体(参)，所以参数要放在最后一个位置。
            调用(插件口[i], 0, 0, 0, 参址)
            fh 1
        }
        i = i + 1
    }
    fh 0
}

@ ---- 列出装进来的手 ----
hs 插件_列() -> u32 {
    rg 插件数 == 0 { fh 0 }
    屏设色(0x8FA6C8)
    屏串("  装进来的手：")
    屏数(插件数)
    屏串(" 只")
    屏换行()
    kb i: u32 = 0
    dy i < 插件数 {
        屏串("    0x")
        打十六_包(插件名[i])
        屏串("  →  0x")
        打十六_包(插件口[i])
        屏换行()
        i = i + 1
    }
    fh 0
}

@ ---- 装包：把每个成员的内容当成对象存进对象区 ----
hs 包_装() -> u32 {
    包装进数 = 0
    kb i: u32 = 0
    dy i < 包成员数 {
        kb o: u32 = 包清单 + i * 32
        kb off: u32 = 包取32(o + 20)
        kb ln: u32 = 包取32(o + 16)
        @ 把这一段的字节拷到取回缓冲
        kb j: u32 = 0
        dy j < ln {
            kb v: u32 = 0
            wx {
                v = ^(包数据 + off + j)
                ^(包装址 + j) = v
            }
            j = j + 1
        }
        wx { ^(包装址 + ln) = 0 }
        盘存对象(包装址)
        @ ★ shou：类型 4 = 命令。这一条成员让包里"长出一只手"
        rg 包_成员类型(i) == 4 {
            rg 插件数 < 16 {
                包_成员名(i, 包名址)
                插件名[插件数] = 名字哈希(包名址)
                @ ★ 包里的「入口」本来就是【绝对地址】（xbao 写的是 0x400000+n），
                @   不能再加一遍 包加载址 —— 那会变成 0x800000，一敲就跳空地。
                插件口[插件数] = 包取32(o + 28)
                插件数 = 插件数 + 1
                屏设色(0x37C46A)
                屏串("    ↑ 长出一只手：")
                屏串(包名址)
                屏换行()
            }
        }
        包装进数 = 包装进数 + 1
        i = i + 1
    }
    屏设色(0x37C46A)
    屏串("  装包完成：")
    屏数(包装进数)
    屏串(" 个成员，对象区现有 ")
    屏数(盘对象数)
    屏串(" 个对象")
    屏换行()
    fh 1
}


@ ---- 找可执行成员，把代码搬到 0x400000，返回入口 ----
hs 包_跑() -> u32 {
    kb i: u32 = 0
    dy i < 包成员数 {
        kb 可装: u32 = 0
        rg 包_成员类型(i) == 1 { 可装 = 1 }
        rg 包_成员类型(i) == 4 { 可装 = 1 }
        rg 可装 == 1 {
            kb off: u32 = 包取32(包清单 + i * 32 + 20)
            kb ln: u32 = 包取32(包清单 + i * 32 + 16)
            kb ent: u32 = 包取32(包清单 + i * 32 + 28)
            @ 先把装载区清零（包里的 .bss 不进文件）
            kb k: u32 = 0
            dy k < 16384 {
                wx { ^(包加载址 + k) = 0 }
                k = k + 1
            }
            @ 搬代码
            kb j: u32 = 0
            dy j < ln {
                kb v: u32 = 0
                wx {
                    v = ^(包数据 + off + j)
                    ^(包加载址 + j) = v
                }
                j = j + 1
            }
            包可执行入口 = ent
            包可执行偏移 = off
            包可执行长 = ln
            屏设色(0x37C46A)
            屏串("  可执行成员 ")
            屏数(ln)
            屏串(" 字节 → 已搬到 0x")
            打十六_包(包加载址)
            屏串("，入口 0x")
            打十六_包(ent)
            屏换行()
            fh ent
        }
        i = i + 1
    }
    fh 0
}

@ ---- 从盘上读包 + 校验 + 列 ----
hs 包_从盘装() -> u32 {
    wx {
        包加载址 = 0x400000          @ 包里的代码固定装到这里
        包名址 = 地址(包名)
        包装址 = 地址(包装)
    }
    包址 = 包缓冲址
    屏设色(0x8FA6C8)
    屏串("  从盘上读包（LBA ")
    屏数(包起始LBA)
    屏串("）…")
    屏换行()
    rg 包_读盘(包起始LBA, 包扇区数) == 0 {
        屏设色(0xE0554A)
        屏串("  读包失败")
        屏换行()
        fh 0
    }
    rg 包_校验() == 0 {
        屏设色(0xE0554A)
        屏串("  这不是一个合法的 .bao v2 包")
        屏换行()
        fh 0
    }
    @ ★ 包自己声明了"我需要哪些能力"（.bao 头 +28 那个位图）。
    @   以前这个字段读出来就扔了 —— 现在【装载前】就校验：
    @   当前视图给不起，直接拒绝，别等装完了才发现用不了。
    rg 视图_给得起(包能力) == 0 {
        屏设色(0xE0554A)
        屏串("  这个包要的能力（0x")
        打十六_包(包能力)
        屏串("），当前视图只有 0x")
        打十六_包(视图能力[当前视图])
        屏换行()
        fh 0
    }
    包_列()
    包_装()
    @ ★ 装完还要【把代码搬到位】—— 插件表里记的入口是 0x400000+n，
    @   不搬的话一敲那条命令就跳进空地。包_跑 只搬不跳。
    包_跑()
    fh 1
}

@ ---- 装包 + 跑里面的可执行成员 ----
hs 包_装并跑() -> u32 {
    rg 包_从盘装() == 0 { fh 0 }
    kb e: u32 = 包_跑()
    rg e == 0 {
        屏设色(0xE0554A)
        屏串("  包里没有可执行成员")
        屏换行()
        fh 0
    }
    调用(e, 0, 0, 屏宽(), 屏高())
    屏设色(0x37C46A)
    屏串("  程序已退出")
    屏换行()
    fh 1
}
