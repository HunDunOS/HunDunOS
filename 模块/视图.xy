# ============================================================================
#  混沌 视图模块（视图.xy）—— 公理 4 / 6 的实现
#
#  视图 = 一组锚点 + 一个映射引用
#  做实：一个视图 = 一句名字 + 一套能力 + 一张「名字 → 哈希」表
#
#  对象区是全局的（一份），名字是视图内的（各自）
#  → 所以「共享」不需要机制，「隔离」也不需要机制
# ============================================================================

qj 视图数: u32
qj 当前视图: u32
# ---- 借用内核（内核对象.xy）的当前映射表：链接时合并成同一份 ----
qj 名表[16]: u32
qj 名指[16]: u32
qj 映射数: u32

qj 视图名[64]: u32          @ 每视图 16 槽（一槽一字节）
qj 当前名缓[32]: u32        @ 当前视图名的【连续字节】缓冲（屏串要用）
qj 当前名址: u32              # 4 视图 × 16 字节（每槽一字节）
qj 视图能力[4]: u32
qj 视图父[4]: u32
qj 视图映射数[4]: u32
qj 视图池[400]: u32             # 4 视图 × 5 条 × 20 字节（名字16 + 哈希4）
qj 名区[80]: u32                # 5 条 × 16 字节：名字的暂存区（载入/存回的中转）
qj 池址: u32
qj 名址: u32

# 借用内核（链接时合并成同一份）
qj 盘缓冲[512]: u32
qj 盘索引起: u32
qj 盘追加: u32
qj 盘对象数: u32

# ---- 池里第 i 视图第 j 条、第 off 字节的槽号 ----
hs 池位(i: u32, j: u32, off: u32) -> u32 {
    fh (i * 5 + j) * 20 + off
}

# ============================================================================
#  把当前视图的映射【存回】视图池
#
#  ★ 池就是唯一的那份数据（视图_加映射 直接往池里写），所以这里
#    只需要把计数记下来。以前这里是把 名表/名指 拷回池里 —— 但
#    名表/名指 只有 视图_载入 会填，刚启动时是 0 号地址 → 拷的是野数据，
#    会把刚存进去的名字抹掉。（池址恒为 0 那会儿，它读的正好就是池
#    自己，才碰巧没暴露。）
# ============================================================================
hs 视图_存回(i: u32) -> u32 {
    rg i == 当前视图 {
        kb n: u32 = 映射数
        rg n > 5 { n = 5 }
        视图映射数[i] = n
    }
    fh 0
}

# ============================================================================
#  把视图池【载入】当前内存
# ============================================================================
hs 视图_取名字(i: u32) -> u32 {
    kb k: u32 = 0
    dy k < 16 {
        kb c: u32 = 视图名[i * 16 + k]
        wx { ^(当前名址 + k) = c }
        k = k + 1
    }
    wx { ^(当前名址 + 16) = 0 }
    fh 0
}

hs 视图_载入(i: u32) -> u32 {
    视图_取名字(i)
    kb n: u32 = 视图映射数[i]
    rg n > 5 { n = 5 }
    kb j: u32 = 0
    dy j < n {
        kb k: u32 = 0
        dy k < 16 {
            kb c: u32 = 0
            wx { c = ^(池址 + 池位(i, j, k)) }
            wx { ^(名址 + j * 16 + k) = c }
            k = k + 1
        }
        名表[j] = 名址 + j * 16
        kb h: u32 = 0
        wx { h = ^(池址 + 池位(i, j, 16)) }
        kb h1: u32 = 0
        wx { h1 = ^(池址 + 池位(i, j, 17)) }
        kb h2: u32 = 0
        wx { h2 = ^(池址 + 池位(i, j, 18)) }
        kb h3: u32 = 0
        wx { h3 = ^(池址 + 池位(i, j, 19)) }
        名指[j] = h + h1 * 256 + h2 * 65536 + h3 * 16777216
        j = j + 1
    }
    映射数 = n
    fh 0
}

# ============================================================================
#  切换视图（存回旧的 → 载入新的）★ 这就是公理 7 的「单一原子动作」
# ============================================================================
hs 视图_切换(i: u32) -> u32 {
    rg i >= 视图数 { fh 0 }
    rg i == 当前视图 { fh 1 }
    视图_存回(当前视图)
    视图_载入(i)
    当前视图 = i
    fh 1
}

# ============================================================================
#  签发一个分身：新视图【继承】父当前的映射一份
#  name 是一个字符串指针；能力是位图
# ============================================================================
hs 视图_签发(名: u32, 能力: u32) -> u32 {
    @ ★ 只有本源（视图 0）能签发。这是「本源」这个词唯一的实现依据 ——
    @   否则它只是"第 0 个视图"而已，分身可以自己繁衍。
    rg 当前视图 != 0 {
        屏设色(0xE0554A)
        屏串("  只有本源（♂）能签发分身")
        换行()
        fh 0
    }
    rg 视图数 >= 4 { fh 0 }
    kb 新: u32 = 视图数
    视图数 = 视图数 + 1
    视图能力[新] = 能力
    视图父[新] = 当前视图
    # 名字抄进 视图名[新]
    kb k: u32 = 0
    xh {
        kb c: u32 = 0
        rg k >= 15 { tc }
        wx { c = ^(名 + k) }
        视图名[新 * 16 + k] = c
        rg c == 0 { tc }
        k = k + 1
    }
    dy k < 16 {
        视图名[新 * 16 + k] = 0
        k = k + 1
    }
    # 继承父的映射（注释说继承，代码以前没做）
    视图_存回(当前视图)
    kb jj: u32 = 0
    dy jj < 5 {
        kb kk: u32 = 0
        dy kk < 20 {
            kb cc: u32 = 0
            wx { cc = 读8(池址 + 池位(当前视图, jj, kk)) }
            rg cc != 0 { wx { ^(池址 + 池位(新, jj, kk)) = cc } }
            kk = kk + 1
        }
        jj = jj + 1
    }
    视图映射数[新] = 视图映射数[当前视图]
    当前视图 = 新
    视图_载入(新)
    fh 1
}

# ---- 当前视图的名字（给提示符用）----
hs 视图_当前名() -> u32 {
    fh 当前名址
}

# ---- 视图池 → 盘（LBA 2）----
hs 视图_存盘() -> u32 {
    rg 盘就绪吗() == 0 { fh 0 }
    # 头 16 字节：视图数、当前视图、保留
    kb i: u32 = 0
    dy i < 512 {
        盘缓冲[i] = 0
        i = i + 1
    }
    盘缓冲[0] = 视图数 % 256
    盘缓冲[1] = 当前视图 % 256
    # 元数据：每视图 20 字节（名字16 + 能力2 + 映射数1 + 父1）
    i = 0
    dy i < 4 {
        kb k: u32 = 0
        dy k < 16 {
            盘缓冲[16 + i * 20 + k] = 视图名[i * 16 + k]
            k = k + 1
        }
        盘缓冲[16 + i * 20 + 16] = 视图能力[i] % 256
        盘缓冲[16 + i * 20 + 17] = (视图能力[i] / 256) % 256
        盘缓冲[16 + i * 20 + 18] = 视图映射数[i]
        盘缓冲[16 + i * 20 + 19] = 视图父[i]
        i = i + 1
    }
    rg 盘写扇区(2) == 0 { fh 0 }
    # 映射池：400 字节 → 从 LBA 3 起
    i = 0
    dy i < 400 {
        盘缓冲[i] = 读8(池址 + i)
        i = i + 1
    }
    盘写扇区(3)
    fh 1
}

# ---- 盘 → 视图池（LBA 2）----
hs 视图_读盘() -> u32 {
    rg 盘就绪吗() == 0 { fh 0 }
    rg 盘读扇区(2) == 0 { fh 0 }
    rg 盘缓冲[0] == 0 { fh 0 }
    视图数 = 盘缓冲[0]
    rg 视图数 > 4 { 视图数 = 4 }
    当前视图 = 盘缓冲[1]
    rg 当前视图 >= 视图数 { 当前视图 = 0 }
    kb i: u32 = 0
    dy i < 4 {
        kb k: u32 = 0
        dy k < 16 {
            视图名[i * 16 + k] = 盘缓冲[16 + i * 20 + k]
            k = k + 1
        }
        视图能力[i] = 盘缓冲[16 + i * 20 + 16] + 盘缓冲[16 + i * 20 + 17] * 256
        视图映射数[i] = 盘缓冲[16 + i * 20 + 18]
        视图父[i] = 盘缓冲[16 + i * 20 + 19]
        i = i + 1
    }
    盘读扇区(3)
    i = 0
    dy i < 400 {
        wx { ^(池址 + i) = 盘缓冲[i] }
        i = i + 1
    }
    视图_载入(当前视图)
    fh 1
}

hs 视图_初始化() -> u32 {
    wx {
        当前名址 = 地址(当前名缓)
        名址 = 地址(名区)
        池址 = 地址(视图池)
    }
    视图名[0] = 104
    视图名[1] = 117
    视图名[2] = 110
    视图名[3] = 100
    视图名[4] = 117
    视图名[5] = 110
    kb i: u32 = 6
    dy i < 16 {
        视图名[i] = 0
        i = i + 1
    }
    视图能力[0] = 31
    视图父[0] = 0xFFFFFFFF
    视图映射数[0] = 0
    视图数 = 1
    当前视图 = 0
    视图_取名字(0)
    fh 0
}

hs 视图_自检() -> u32 {
    屏设色(0x9AC4FF)
    屏串("  视图 ")
    屏串(视图_当前名())
    屏串("  能力 0x")
    打十六(视图能力[当前视图])
    屏串("  映射 ")
    屏数(视图映射数[当前视图])
    屏串("  个")
    换行()
    rg 当前视图 == 0 {
        屏设色(0x8FA6C8)
        屏串("        ← 本源（♂），全权")
        换行()
    }
    rg 当前视图 != 0 {
        屏设色(0x8FA6C8)
        屏串("        ← 分身（♀），只有父给的那几位")
        换行()
    }
    fh 0
}

# ============================================================================
#  能力即引用（公理 5）
#
#  能力不是"权限位"，是【看得见 / 说得出来】。
#  没有"盘"这一位，就不该有"存"这个动作 —— 所以检查放在命令入口，
#  而不是放在盘驱动里。
# ============================================================================
@ 位数 → 名字（给报错用）
hs 能力名(位: u32) -> u32 {
    rg 位 == 1 { fh "屏幕" }
    rg 位 == 2 { fh "键盘" }
    rg 位 == 4 { fh "鼠标" }
    rg 位 == 8 { fh "盘" }
    rg 位 == 16 { fh "网络" }
    fh "未知"
}

@ 当前视图有没有这一位能力
hs 视图_有能力(位: u32) -> u32 {
    kb 有: u32 = 视图能力[当前视图] wy 位
    rg 有 != 0 { fh 1 }
    fh 0
}

@ 当前视图能不能【覆盖】这一整组能力（位图）
@ 要的是"我有的比你要求的还全"： (要 wy 有) == 要
hs 视图_给得起(位: u32) -> u32 {
    kb 交集: u32 = 视图能力[当前视图] wy 位
    rg 交集 == 位 { fh 1 }
    fh 0
}

@ 要能力 —— 没有就当场拒绝，返回 0
@ ★ 括号不能省：位与 `wy` 的优先级比 `==` 低，写 `a wy b != 0` 会解析成 `a wy (b != 0)`
hs 视图_要能力(位: u32) -> u32 {
    rg 视图_有能力(位) == 1 { fh 1 }
    屏设色(0xE0554A)
    屏串("  这个分身没有「")
    屏串(能力名(位))
    屏串("」能力")
    换行()
    屏设色(0x8FA6C8)
    屏串("  （能力不是权限位 —— 是这个视图里根本没有这个东西）")
    换行()
    fh 0
}


hs 视图_加映射(名: u32, 哈希: u32) -> u32 {
    kb v: u32 = 当前视图
    kb n: u32 = 视图映射数[v]
    rg n >= 5 { fh 0 }
    kb b: u32 = v * 100 + n * 20
    kb k: u32 = 0
    xh {
        kb c: u32 = 0
        rg k >= 15 { tc }
        wx { c = ^(名 + k) }
        wx { ^(池址 + b + k) = c }
        rg c == 0 { tc }
        k = k + 1
    }
    dy k < 16 {
        wx { ^(池址 + b + k) = 0 }
        k = k + 1
    }
    wx { ^(池址 + b + 16) = 哈希 wy 255 }
    wx { ^(池址 + b + 17) = (哈希 / 256) wy 255 }
    wx { ^(池址 + b + 18) = (哈希 / 65536) wy 255 }
    wx { ^(池址 + b + 19) = (哈希 / 16777216) wy 255 }
    视图映射数[v] = n + 1
    rg v == 当前视图 { 映射数 = n + 1 }   @ ★ 同步活计数，否则切视图时会被旧的 0 抹掉
    fh 1
}

hs 视图_列映射() -> u32 {
    kb v: u32 = 当前视图
    kb n: u32 = 视图映射数[v]
    rg n == 0 {
        屏串("  （这个视图里还没有名字）")
        换行()
        fh 0
    }
    kb i: u32 = 0
    dy i < n {
        kb b: u32 = v * 100 + i * 20
        kb k: u32 = 0
        kb 权: u32 = 1
        kb h: u32 = 0
        dy k < 4 {
            h = h + 读8(池址 + b + 16 + k) * 权
            权 = 权 * 256
            k = k + 1
        }
        屏串("    ")
        屏串(池址 + b)
        屏串("   →   0x")
        打十六(h)
        换行()
        i = i + 1
    }
    fh 0
}


@ 视图名是(i, 名)：第 i 个视图的名字是不是「名」
hs 视图_名是(i: u32, 名: u32) -> u32 {
    kb k: u32 = 0
    xh {
        kb a: u32 = 视图名[i * 16 + k]
        kb b: u32 = 0
        wx { b = ^(名 + k) }
        rg a != b { fh 0 }
        rg a == 0 { fh 1 }
        k = k + 1
        rg k >= 16 { fh 1 }
    }
    fh 0
}

@ 按【名字】切换视图
hs 视图_切换名(名: u32) -> u32 {
    kb i: u32 = 0
    dy i < 视图数 {
        rg 视图_名是(i, 名) == 1 { fh 视图_切换(i) }
        i = i + 1
    }
    屏设色(0xE0554A)
    屏串("  没有叫这个的视图：")
    屏串(名)
    换行()
    fh 0
}
