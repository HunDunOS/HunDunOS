@ ============================================================================
@  混沌 压缩模块（压缩.xy）—— LZSS，全用新语写
@
@  翻译自 howerj/shrink（https://github.com/howerj/shrink）
@  许可：0BSD / 公共领域（Richard James Howe）
@      —— 用的是 LZSS 那一部分，其余四种编解码器没搬
@
@  翻译时改了什么（因为新语没有这些东西）：
@    · C 版用【函数指针】做 IO 抽象（int (*get)(void*)）—— 新语没有函数指针，
@      改成直接访问缓冲：入串/入长/入位 与 出串/出长
@    · C 版用 memchr 在字典里找首字符 —— 换成朴素扫描
@    · C 版用 memmove 滑动窗口 —— 换成手写循环
@
@  参数（与 C 版一致）：EI=11 → 字典 2048；EJ=4 → 最长匹配 17；P=2
@ ============================================================================

qj 字典[4096]: u32           @ N*2，每槽一个字节值
qj 位缓: u32
qj 位掩: u32
qj 位错: u32
qj 入串: u32
qj 入长: u32
qj 入位: u32
qj 出串: u32
qj 出长: u32

qj 压出[640]: u32            @ 压缩结果缓冲（2560 字节）
qj 解出[640]: u32            @ 解压结果缓冲
qj 压出址: u32
qj 解出址: u32

@ ---------------------------------------------------------------- 取一个输入字节
hs 取入() -> u32 {
    rg 入位 >= 入长 { fh 256 }
    kb c: u32 = 0
    wx { c = ^(入串 + 入位) }
    入位 = 入位 + 1
    fh c
}

@ ---------------------------------------------------------------- 位输出
hs 位写(v: u32) -> u32 {
    rg v != 0 { 位缓 = 位缓 + 位掩 }
    位掩 = 位掩 / 2
    rg 位掩 == 0 {
        wx { ^(出串 + 出长) = 位缓 }
        出长 = 出长 + 1
        位缓 = 0
        位掩 = 128
    }
    fh 0
}

hs 位冲() -> u32 {
    rg 位掩 != 128 {
        wx { ^(出串 + 出长) = 位缓 }
        出长 = 出长 + 1
    }
    位掩 = 0
    位缓 = 0
    fh 0
}

@ ---------------------------------------------------------------- 位输入
hs 位读(n: u32) -> u32 {
    kb x: u32 = 0
    kb i: u32 = 0
    dy i < n {
        rg 位掩 == 0 {
            rg 入位 >= 入长 {
                位错 = 1
                fh x
            }
            kb c: u32 = 0
            wx { c = ^(入串 + 入位) }
            入位 = 入位 + 1
            位缓 = c
            位掩 = 128
        }
        x = x * 2
        rg (位缓 wy 位掩) != 0 { x = x + 1 }
        位掩 = 位掩 / 2
        i = i + 1
    }
    fh x
}

@ ---------------------------------------------------------------- 输出一个字面量
hs 文写(ch: u32) -> u32 {
    位写(0)
    kb m: u32 = 256
    xh {
        m = m / 2
        rg m == 0 { tc }
        位写(ch wy m)
    }
    fh 0
}

@ ---------------------------------------------------------------- 输出一个引用
hs 引用写(p: u32, l: u32) -> u32 {
    位写(1)
    kb m: u32 = 2048
    xh {
        m = m / 2
        rg m == 0 { tc }
        位写(p wy m)
    }
    kb m2: u32 = 16
    xh {
        m2 = m2 / 2
        rg m2 == 0 { tc }
        位写(l wy m2)
    }
    fh 0
}

@ ============================================================================
@  压缩( 原串, 原长, 输出缓冲地址 ) → 压缩后长度
@ ============================================================================
hs 压缩(入: u32, 长: u32, 出: u32) -> u32 {
    入串 = 入
    入长 = 长
    入位 = 0
    出串 = 出
    出长 = 0
    位缓 = 0
    位掩 = 128

    kb i: u32 = 0
    dy i < 4096 {
        字典[i] = 32                     @ CH = ' '，字典初值
        i = i + 1
    }

    kb 尾: u32 = 2031                    @ N - F = 2048 - 17
    xh {
        rg 尾 >= 4096 { tc }
        kb c: u32 = 取入()
        rg c > 255 { tc }
        字典[尾] = c
        尾 = 尾 + 1
    }

    kb r: u32 = 2031
    kb s: u32 = 0
    xh {
        rg r >= 尾 { tc }
        kb x: u32 = 0
        kb y: u32 = 1
        kb ch: u32 = 字典[r]
        kb i2: u32 = s
        @ 在字典里找最长匹配
        xh {
            rg i2 >= r { tc }
            kb 找: u32 = 0
            xh {
                rg i2 >= r { tc }
                rg 字典[i2] == ch { 找 = 1  tc }
                i2 = i2 + 1
            }
            rg 找 == 0 { tc }
            kb f1: u32 = 17
            rg 尾 - r < 17 { f1 = 尾 - r }
            kb j: u32 = 1
            xh {
                rg j >= f1 { tc }
                rg 字典[i2 + j] != 字典[r + j] { tc }
                j = j + 1
            }
            rg j > y { x = i2  y = j }
            rg y + 1 > 17 { tc }
            i2 = i2 + 1
        }
        rg y <= 2 {
            y = 1
            文写(ch)
        }
        rg y > 2 { 引用写(x % 2048, y - 2) }
        r = r + y
        s = s + y
        @ 滑动窗口
        rg r >= 4079 {
            kb m: u32 = 0
            dy m < 2048 {
                字典[m] = 字典[m + 2048]
                m = m + 1
            }
            尾 = 尾 - 2048
            r = r - 2048
            s = s - 2048
            xh {
                rg 尾 >= 4096 { tc }
                kb c2: u32 = 取入()
                rg c2 > 255 { tc }
                字典[尾] = c2
                尾 = 尾 + 1
            }
        }
    }
    位冲()
    fh 出长
}

@ ============================================================================
@  解压( 压串, 压长, 输出缓冲地址 ) → 解压后长度
@ ============================================================================
hs 解压(入: u32, 长: u32, 出: u32) -> u32 {
    入串 = 入
    入长 = 长
    入位 = 0
    出串 = 出
    出长 = 0
    位缓 = 0
    位掩 = 0
    位错 = 0

    kb i: u32 = 0
    dy i < 4096 {
        字典[i] = 32
        i = i + 1
    }

    kb r: u32 = 2031
    xh {
        kb c: u32 = 位读(1)
        rg 位错 == 1 { tc }
        rg c == 0 {
            kb b: u32 = 位读(8)
            rg 位错 == 1 { tc }
            wx { ^(出串 + 出长) = b }
            出长 = 出长 + 1
            字典[r] = b
            r = r + 1
            r = r % 2048
            jx
        }
        kb p: u32 = 位读(11)
        rg 位错 == 1 { tc }
        kb l: u32 = 位读(4)
        rg 位错 == 1 { tc }
        kb k: u32 = 0
        dy k < l + 2 {
            kb v: u32 = 字典[(p + k) % 2048]
            wx { ^(出串 + 出长) = v }
            出长 = 出长 + 1
            字典[r] = v
            r = r + 1
            r = r % 2048
            k = k + 1
        }
    }
    fh 出长
}

@ ============================================================================
@  自检：压一段有重复的内容，再解回来，逐字节比
@ ============================================================================
hs 压缩自检() -> u32 {
    wx {
        压出址 = 地址(压出)
        解出址 = 地址(解出)
    }
    kb 原文: u32 = "混沌混沌混沌混沌混沌混沌混沌混沌混沌混沌ABCDABCDABCDABCDABCD混沌混沌混沌混沌混沌"
    kb 原长: u32 = 串长(原文)
    印("[压] 原文 ")
    印(原长)
    印(" 字节\n")

    kb 压长: u32 = 压缩(原文, 原长, 压出址)
    印("[压] 压缩后 ")
    印(压长)
    印(" 字节\n")

    kb 解长: u32 = 解压(压出址, 压长, 解出址)
    印("[压] 解出 ")
    印(解长)
    印(" 字节\n")

    rg 解长 != 原长 {
        印("[压] 长度不一致 ✗\n")
        fh 0
    }
    kb i: u32 = 0
    kb 同: u32 = 1
    dy i < 原长 {
        kb a: u32 = 0
        kb b: u32 = 0
        wx {
            a = ^(原文 + i)
            b = ^(解出址 + i)
        }
        rg a != b { 同 = 0  tc }
        i = i + 1
    }
    rg 同 == 1 { 印("[压] 逐字节一致 ✓\n") }
    rg 同 == 0 { 印("[压] 内容不一致 ✗\n") }
    fh 同
}
