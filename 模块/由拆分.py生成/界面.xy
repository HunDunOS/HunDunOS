# ============================================================================
#  界面  ——  由 拆分.py 从 桌面.xy 拆出，可单独编译
#  界面层：绘图基元 + 混沌UI（译自 microui 架构）+ 部件与图标。
# ============================================================================

jg 矩形 { x: u32  y: u32  w: u32  h: u32 }

jg 容器 {
    x: u32  y: u32  w: u32  h: u32
    cx: u32 cy: u32 cw: u32 ch: u32
    游标x: u32  游标y: u32
    行高: u32   间隙: u32
}

# ---- 全局（用 .comm 声明，链接器合并成一份）----
qj 容器[8]: 容器
qj 容器数: u32
qj 徽标[8]: u32
qj 当x: u32
qj 当y: u32
qj 当w: u32
qj 当h: u32
qj 鼠标x: u32
qj 鼠标y: u32
qj 鼠标键: u32
qj 键已按: u32
qj 新点击: u32
qj 热控件: u32
qj 活动控件: u32
qj 控件号: u32
qj 备份[484]: u32
qj 旧鼠标x: u32
qj 旧鼠标y: u32
qj 首帧: u32
qj 需要重绘: u32
qj 旧秒: u32
qj 窗口x: u32
qj 窗口y: u32
qj 窗口宽: u32
qj 窗口高: u32
qj 拖动中: u32
qj 拖动偏x: u32
qj 拖动偏y: u32
qj 窗: u32
qj 算显: u32
qj 算存: u32
qj 算运: u32
qj 算输: u32
qj 画色: u32
qj 笔画中: u32
qj 笔旧x: u32
qj 笔旧y: u32
qj 开机刻: u32
qj 时钟秒: u32
qj 勾选甲: u32
qj 勾选乙: u32
qj 滑条值: u32
qj 对象哈希[16]: u32        @ 身份 = 内容哈希
qj 对象串[16]: u32          @ 内容（字符串指针）
qj 对象长[16]: u32
qj 对象数: u32
qj 名表[16]: u32            @ 映射：名字
qj 名指[16]: u32            @       指向的对象下标
qj 映射数: u32
qj 史名[128]: u32        @ 视图历史（换回去用）
qj 史指[128]: u32
qj 史映射数[8]: u32
qj 史数: u32
qj 轴[8]: u32               @ 轴：只增不减的操作记录
qj 轴数: u32
qj 高亮对象: u32

hs 点判定(mx: u32, my: u32, x: u32, y: u32, w: u32, h: u32) -> u32 {
    rg mx >= x {
        rg mx < x + w {
            rg my >= y {
                rg my < y + h { fh 1 }
            }
        }
    }
    fh 0
}

hs 根(n: u32) -> u32 {
    kb i: u32 = 0
    xh {
        rg i * i > n { fh i - 1 }
        i = i + 1
        rg i > 2000 { fh 2000 }
    }
    fh 0
}

hs 文宽(s: *u8) -> u32 {
    kb n: u32 = 0
    kb i: u32 = 0
    xh {
        wx {
            kb c: u8 = ^(s + i)
            rg c == 0 { tc }
            rg c < 128 { n = n + 8 }
            rg c >= 128 { n = n + 16 }
        }
        i = i + 1
    }
    fh n
}

hs 圆角内缩(i: u32, 高: u32) -> u32 {
    kb a: u32 = 0
    kb b: u32 = 0
    rg i < 8 { a = 徽标[i] }
    kb j: u32 = 高 - 1 - i
    rg j < 8 { b = 徽标[j] }
    rg b > a { fh b }
    fh a
}

hs 圆角块(x: u32, y: u32, w: u32, h: u32, c: u32) -> u32 {
    kb i: u32 = 0
    dy i < h {
        kb ins: u32 = 圆角内缩(i, h)
        绘块(x + ins, y + i, w - ins - ins, 1, c)
        i = i + 1
    }
    fh 0
}

hs 圆角块混(x: u32, y: u32, w: u32, h: u32, c: u32, a: u32) -> u32 {
    kb i: u32 = 0
    dy i < h {
        kb ins: u32 = 圆角内缩(i, h)
        绘块混(x + ins, y + i, w - ins - ins, 1, c, a)
        i = i + 1
    }
    fh 0
}

hs 圆角框(x: u32, y: u32, w: u32, h: u32, c: u32) -> u32 {
    kb i: u32 = 0
    dy i < h {
        kb ins: u32 = 圆角内缩(i, h)
        绘块(x + ins, y + i, 1, 1, c)
        绘块(x + w - 1 - ins, y + i, 1, 1, c)
        rg i == 0 { 绘块(x + ins, y, w - ins - ins, 1, c) }
        rg i == h - 1 { 绘块(x + ins, y + h - 1, w - ins - ins, 1, c) }
        i = i + 1
    }
    fh 0
}

hs 阴影(x: u32, y: u32, w: u32, h: u32) -> u32 {
    kb k: u32 = 7
    dy k > 0 {
        圆角块混(x - k, y + k, w + k + k, h + k, 0x000000, 9)
        k = k - 1
    }
    fh 0
}

hs 光斑(cx: u32, cy: u32, r: u32, c: u32, a: u32) -> u32 {
    kb row: u32 = 0
    dy row < r {
        kb d: u32 = r - row
        kb s: u32 = 根(r * r - d * d)
        kb w: u32 = r - s
        绘块混(cx - w, cy - row - 1, w + w, 1, c, a)
        绘块混(cx - w, cy + row, w + w, 1, c, a)
        row = row + 1
    }
    fh 0
}

hs 直线(x0: u32, y0: u32, x1: u32, y1: u32, c: u32) -> u32 {
    kb px: u32 = x0
    kb py: u32 = y0
    kb gx: u32 = 0
    kb gy: u32 = 0
    kb sx: u32 = 1
    kb sy: u32 = 1
    rg x0 < x1 { gx = x1 - x0 }
    rg x0 >= x1 { gx = x0 - x1  sx = 0xFFFFFFFF }
    rg y0 < y1 { gy = y1 - y0 }
    rg y0 >= y1 { gy = y0 - y1  sy = 0xFFFFFFFF }
    kb err: u32 = gx
    xh {
        绘块(px, py, 2, 2, c)
        rg px == x1 {
            rg py == y1 { fh 0 }
        }
        kb e2: u32 = err + err
        rg e2 > gy { err = err - gy  px = px + sx }
        rg e2 < gx { err = err + gx  py = py + sy }
    }
    fh 0
}

hs 界面开始() -> u32 {
    容器数 = 0
    热控件 = 0
    控件号 = 0
    鼠标x = 鼠x()
    鼠标y = 鼠y()
    鼠标键 = 鼠钮()
    新点击 = 0
    rg 鼠标键 == 1 {
        rg 键已按 == 0 { 新点击 = 1 }
    }
    fh 0
}

hs 界面结束() -> u32 {
    rg 活动控件 > 0 {
        rg 鼠标键 == 0 { 活动控件 = 0 }
    }
    键已按 = 鼠标键
    新点击 = 0
    fh 0
}

hs 当前() -> u32 {
    rg 容器数 == 0 { fh 0 }
    fh 容器数 - 1
}

hs 布局行(高: u32) -> u32 {
    kb i: u32 = 当前()
    容器[i].游标x = 0
    容器[i].游标y = 容器[i].游标y + 容器[i].行高
    容器[i].行高 = 高
    fh 0
}

hs 间隔(px: u32) -> u32 {
    kb i: u32 = 当前()
    容器[i].游标x = 容器[i].游标x + px
    fh 0
}

hs 控位(w: u32, h: u32) -> u32 {
    kb i: u32 = 当前()
    当x = 容器[i].cx + 容器[i].游标x
    当y = 容器[i].cy + 容器[i].游标y
    当w = w
    当h = h
    容器[i].游标x = 容器[i].游标x + w + 容器[i].间隙
    fh 0
}

hs 控位满(h: u32) -> u32 {
    kb i: u32 = 当前()
    kb w: u32 = 容器[i].cw - 容器[i].游标x
    控位(w, h)
    fh 0
}

hs 命中() -> u32 {
    fh 点判定(鼠标x, 鼠标y, 当x, 当y, 当w, 当h)
}

hs 新号() -> u32 {
    控件号 = 控件号 + 1
    fh 控件号
}

hs 进控件(号: u32) -> u32 {
    kb 在: u32 = 命中()
    rg 在 == 1 { 热控件 = 号 }
    rg 活动控件 == 号 {
        rg 鼠标键 == 0 {
            rg 在 == 1 { fh 2 }
        }
        fh 1
    }
    rg 在 == 1 {
        rg 新点击 == 1 {
            活动控件 = 号
            fh 1
        }
    }
    fh 0
}

hs 文字(x: u32, y: u32, s: u32, c: u32) -> u32 {
    绘字(x, y, s, c)
    fh 0
}

hs 按钮(标: u32, 宽: u32, 高: u32, 底: u32) -> u32 {
    kb 号: u32 = 新号()
    控位(宽, 高)
    kb 态: u32 = 进控件(号)
    kb 色: u32 = 底
    rg 态 == 1 { 色 = 底 + 0x141C28 }
    rg 热控件 == 号 { 色 = 底 + 0x0A1018 }
    圆角块(当x, 当y, 当w, 当h, 色)
    kb tw: u32 = 文宽(标)
    kb dx: u32 = 0
    rg 当w > tw { dx = (当w - tw) / 2 }
    绘字(当x + dx, 当y + (当h - 16) / 2, 标, 0xFFFFFF)
    rg 态 == 2 { fh 1 }
    fh 0
}

hs 复选框(标: u32, 选中: u32) -> u32 {
    kb 号: u32 = 新号()
    控位满(24)
    kb 态: u32 = 进控件(号)
    圆角块(当x, 当y + 3, 18, 18, 0x26334E)
    rg 选中 == 1 { 圆角块(当x + 3, 当y + 6, 12, 12, 0x4C8DFF) }
    绘字(当x + 28, 当y + 4, 标, 0xAEC3E0)
    rg 态 == 2 {
        rg 选中 == 1 { fh 0 }
        fh 1
    }
    fh 选中
}

hs 滑块(值: u32, 最大: u32, 标: u32) -> u32 {
    kb v: u32 = 值
    kb 号: u32 = 新号()
    kb i: u32 = 当前()
    控位(容器[i].cw - 70, 24)
    kb 态: u32 = 进控件(号)
    rg 态 == 1 {
        kb n: u32 = (鼠标x - 当x) * 最大 / 当w
        rg n > 最大 { n = 最大 }
        v = n
    }
    圆角块(当x, 当y + 9, 当w, 6, 0x1B2740)
    kb w2: u32 = v * 当w / 最大
    rg w2 > 6 { 圆角块(当x, 当y + 9, w2, 6, 0x4C8DFF) }
    绘块(当x + w2 - 3, 当y + 5, 6, 14, 0xFFFFFF)
    绘字(当x + 当w + 10, 当y + 4, 标, 0x8FA6C8)
    绘数(当x + 当w + 10 + 文宽(标) + 8, 当y + 4, v, 0xFFFFFF)
    fh v
}

hs 面板开始(x: u32, y: u32, w: u32, h: u32, 标: u32, 画阴: u32) -> u32 {
    kb i: u32 = 容器数
    容器[i].x = x
    容器[i].y = y
    容器[i].w = w
    容器[i].h = h
    容器[i].cx = x + 16
    容器[i].cy = y + 46
    容器[i].cw = w - 32
    容器[i].ch = h - 60
    容器[i].游标x = 0
    容器[i].游标y = 0
    容器[i].行高 = 0
    容器[i].间隙 = 0            @ 间距由 间隔() 显式给，控位不再自带
    容器数 = 容器数 + 1

    rg 画阴 == 1 { 阴影(x, y, w, h) }
    圆角块(x, y, w, h, 0x121A2E)
    圆角块(x + 1, y + 1, w - 2, 34, 0x1B2740)
    圆角框(x, y, w, h, 0x33456E)

    绘块(x + 14, y + 15, 4, 12, 0x4C8DFF)
    绘块(x + 20, y + 19, 4, 8, 0x6FA8FF)
    绘块(x + 26, y + 23, 4, 4, 0x9AC4FF)
    绘字(x + 40, y + 12, 标, 0xFFFFFF)

    @ 关闭按钮
    kb 结号: u32 = 新号()
    当x = x + w - 36
    当y = y + 8
    当w = 26
    当h = 26
    kb 结态: u32 = 进控件(结号)
    rg 结态 > 0 { 圆角块(当x, 当y, 26, 26, 0xE0554A) }
    kb 啊: u32 = 0
    dy 啊 < 11 {
        绘块(当x + 8 + 啊, 当y + 8 + 啊, 2, 2, 0xFFFFFF)
        绘块(当x + 16 - 啊, 当y + 8 + 啊, 2, 2, 0xFFFFFF)
        啊 = 啊 + 1
    }
    rg 结态 == 2 { fh 1 }
    fh 0
}

hs 面板结束() -> u32 {
    rg 容器数 > 0 { 容器数 = 容器数 - 1 }
    fh 0
}

hs 画壁纸() -> u32 {
    kb y: u32 = 0
    kb 高: u32 = 屏高()
    kb 宽: u32 = 屏宽()
    dy y < 高 {
        kb t: u32 = y * 100 / 高
        绘块(0, y, 宽, 1, (18 + t / 4) * 65536 + (30 + t / 3) * 256 + (58 + t / 2))
        y = y + 1
    }
    光斑(屏宽() / 6, 屏高() / 5, 屏高() / 4, 0x3A6BFF, 40)
    光斑(屏宽() * 5 / 6, 屏高() * 4 / 5, 屏高() / 3, 0x8A4CFF, 32)
    光斑(屏宽() / 2, 屏高() / 2, 屏高() / 5, 0x1FB6FF, 18)
    光斑(屏宽() / 3, 屏高() * 9 / 10, 屏高() / 4, 0x00C2A8, 16)
    fh 0
}

hs 两位(n: u32, x: u32, y: u32, c: u32) -> u32 {
    rg n < 10 {
        绘字(x, y, "0", c)
        绘数(x + 8, y, n, c)
        fh 0
    }
    绘数(x, y, n, c)
    fh 0
}

hs 画顶栏() -> u32 {
    圆角块(8, 6, 屏宽() - 16, 30, 0x111A2E)
    绘块(24, 15, 4, 12, 0x4C8DFF)
    绘块(30, 19, 4, 8, 0x6FA8FF)
    绘块(36, 23, 4, 4, 0x9AC4FF)
    绘字(48, 12, "混沌 OS", 0xFFFFFF)
    绘字(132, 12, "自研引导器 · 新语内核 · 混沌UI", 0x6E86A8)
    kb h: u32 = 时()
    kb m: u32 = 分()
    kb 钟x: u32 = 屏宽() - 168
    两位(h, 钟x, 12, 0xFFFFFF)
    绘字(钟x + 16, 12, ":", 0x9FB4D0)
    两位(m, 钟x + 24, 12, 0xFFFFFF)
    绘字(钟x + 40, 12, ":", 0x9FB4D0)
    两位(时钟秒, 钟x + 48, 12, 0x9FB4D0)
    fh 0
}

hs 画图标(kind: u32, x: u32, y: u32, s: u32, c: u32) -> u32 {
    kb u: u32 = s / 16
    rg u < 1 { u = 1 }
    rg kind == 1 {
        绘块(x + 7 * u, y + 2 * u, 2 * u, 2 * u, c)
        绘块(x + 6 * u, y + 4 * u, 4 * u, 2 * u, c)
        绘块(x + 5 * u, y + 6 * u, 2 * u, 2 * u, c)
        绘块(x + 9 * u, y + 6 * u, 2 * u, 2 * u, c)
        绘块(x + 4 * u, y + 8 * u, 2 * u, 6 * u, c)
        绘块(x + 10 * u, y + 8 * u, 2 * u, 6 * u, c)
        绘块(x + 6 * u, y + 10 * u, 4 * u, 2 * u, c)
        绘块(x + 7 * u, y + 12 * u, 2 * u, 2 * u, c)
        fh 0
    }
    rg kind == 2 {
        绘块(x + 2 * u, y + 1 * u, 12 * u, 14 * u, c)
        绘块(x + 4 * u, y + 3 * u, 8 * u, 3 * u, 0x101828)
        绘块(x + 4 * u, y + 8 * u, 3 * u, 2 * u, 0x101828)
        绘块(x + 7 * u, y + 8 * u, 3 * u, 2 * u, 0x101828)
        绘块(x + 10 * u, y + 8 * u, 3 * u, 2 * u, 0x101828)
        绘块(x + 4 * u, y + 11 * u, 3 * u, 2 * u, 0x101828)
        绘块(x + 7 * u, y + 11 * u, 3 * u, 2 * u, 0x101828)
        绘块(x + 10 * u, y + 11 * u, 3 * u, 2 * u, 0x101828)
        fh 0
    }
    rg kind == 3 {
        绘块(x + 1 * u, y + 12 * u, 5 * u, 2 * u, c)
        绘块(x + 4 * u, y + 10 * u, 3 * u, 3 * u, c)
        绘块(x + 6 * u, y + 8 * u, 3 * u, 3 * u, c)
        绘块(x + 8 * u, y + 6 * u, 3 * u, 3 * u, c)
        绘块(x + 10 * u, y + 4 * u, 3 * u, 3 * u, c)
        绘块(x + 12 * u, y + 2 * u, 2 * u, 2 * u, c)
        fh 0
    }
    rg kind == 4 {
        绘块(x + 5 * u, y + 3 * u, 6 * u, 2 * u, c)
        绘块(x + 4 * u, y + 5 * u, 2 * u, 3 * u, c)
        绘块(x + 10 * u, y + 5 * u, 2 * u, 3 * u, c)
        绘块(x + 6 * u, y + 8 * u, 5 * u, 2 * u, c)
        绘块(x + 8 * u, y + 10 * u, 2 * u, 2 * u, c)
        绘块(x + 7 * u, y + 12 * u, 2 * u, 2 * u, c)
        fh 0
    }
    rg kind == 5 {
        @ 对象区：三个节点连成的【图】，不是树
        绘块(x + 2 * u, y + 3 * u, 5 * u, 5 * u, c)
        绘块(x + 9 * u, y + 2 * u, 5 * u, 5 * u, c)
        绘块(x + 8 * u, y + 10 * u, 5 * u, 5 * u, c)
        绘块(x + 7 * u, y + 5 * u, 2 * u, 2 * u, c)
        绘块(x + 7 * u, y + 7 * u, 2 * u, 4 * u, c)
        绘块(x + 4 * u, y + 8 * u, 4 * u, 2 * u, c)
        fh 0
    }
    fh 0
}

hs 坞图标(i: u32, x: u32, y: u32) -> u32 {
    kb 亮: u32 = 点判定(鼠标x, 鼠标y, x, y, 56, 56)
    kb c1: u32 = 0x3D74E0
    rg i == 1 { c1 = 0x2FA85A }
    rg i == 2 { c1 = 0x8650D8 }
    rg i == 3 { c1 = 0xD2912F }
    rg i == 4 { c1 = 0x1E9E8A }
    kb up: u32 = 亮 * 5
    rg 亮 == 1 { 阴影(x, y - up, 56, 56) }
    圆角块(x, y - up, 56, 56, c1)
    绘块(x + 8, y + 8 - up, 40, 4, c1 + 0x141414)
    画图标(i + 1, x + 8, y + 8 - up, 40, 0xFFFFFF)
    fh 0
}

hs 画坞() -> u32 {
    kb w: u32 = 5 * 72 + 20
    kb x: u32 = 屏宽() / 2 - w / 2
    kb 坞y: u32 = 屏高() - 88
    阴影(x, 坞y, w, 76)
    圆角块(x, 坞y, w, 76, 0x121B2E)
    圆角框(x, 坞y, w, 76, 0x2A3A5C)
    kb i: u32 = 0
    dy i < 5 {
        坞图标(i, x + 14 + i * 72, 坞y + 10)
        i = i + 1
    }
    fh 0
}

hs 画鼠标(x: u32, y: u32) -> u32 {
    kb r: u32 = 0
    dy r < 13 {
        绘块(x, y + r, 1 + r / 2, 1, 0x08101C)
        r = r + 1
    }
    绘块(x + 2, y + 10, 6, 7, 0x08101C)
    绘块(x + 3, y + 16, 4, 4, 0x08101C)
    kb q: u32 = 0
    dy q < 12 {
        绘块(x, y + q, 1 + q / 2, 1, 0xFFFFFF)
        q = q + 1
    }
    绘块(x + 2, y + 10, 5, 6, 0xFFFFFF)
    绘块(x + 3, y + 15, 3, 4, 0xFFFFFF)
    fh 0
}

hs 存光标(x: u32, y: u32) -> u32 {
    kb i: u32 = 0
    dy i < 22 {
        kb j: u32 = 0
        dy j < 22 {
            备份[i * 22 + j] = 取点(x + j, y + i)
            j = j + 1
        }
        i = i + 1
    }
    fh 0
}

hs 还光标(x: u32, y: u32) -> u32 {
    kb i: u32 = 0
    dy i < 22 {
        kb j: u32 = 0
        dy j < 22 {
            绘点(x + j, y + i, 备份[i * 22 + j])
            j = j + 1
        }
        i = i + 1
    }
    fh 0
}
