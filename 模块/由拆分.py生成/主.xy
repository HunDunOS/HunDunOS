# ============================================================================
#  主  ——  由 拆分.py 从 桌面.xy 拆出，可单独编译
#  主模块：唯一带 _start 的模块。
# ============================================================================

jg 矩形 { x: u32  y: u32  w: u32  h: u32 }

jg 容器 {
    x: u32  y: u32  w: u32  h: u32
    cx: u32 cy: u32 cw: u32 ch: u32
    游标x: u32  游标y: u32
    行高: u32   间隙: u32
}

# ---- 全局（用 .comm 声明，链接器合并成一份）----
qj 容器[8]: 容器
qj 容器数: u32
qj 徽标[8]: u32
qj 当x: u32
qj 当y: u32
qj 当w: u32
qj 当h: u32
qj 鼠标x: u32
qj 鼠标y: u32
qj 鼠标键: u32
qj 键已按: u32
qj 新点击: u32
qj 热控件: u32
qj 活动控件: u32
qj 控件号: u32
qj 备份[484]: u32
qj 旧鼠标x: u32
qj 旧鼠标y: u32
qj 首帧: u32
qj 需要重绘: u32
qj 旧秒: u32
qj 窗口x: u32
qj 窗口y: u32
qj 窗口宽: u32
qj 窗口高: u32
qj 拖动中: u32
qj 拖动偏x: u32
qj 拖动偏y: u32
qj 窗: u32
qj 算显: u32
qj 算存: u32
qj 算运: u32
qj 算输: u32
qj 画色: u32
qj 笔画中: u32
qj 笔旧x: u32
qj 笔旧y: u32
qj 开机刻: u32
qj 时钟秒: u32
qj 勾选甲: u32
qj 勾选乙: u32
qj 滑条值: u32
qj 对象哈希[16]: u32        @ 身份 = 内容哈希
qj 对象串[16]: u32          @ 内容（字符串指针）
qj 对象长[16]: u32
qj 对象数: u32
qj 名表[16]: u32            @ 映射：名字
qj 名指[16]: u32            @       指向的对象下标
qj 映射数: u32
qj 史名[128]: u32        @ 视图历史（换回去用）
qj 史指[128]: u32
qj 史映射数[8]: u32
qj 史数: u32
qj 轴[8]: u32               @ 轴：只增不减的操作记录
qj 轴数: u32
qj 高亮对象: u32

hs 初始化() -> u32 {
    徽标[0] = 5
    徽标[1] = 3
    徽标[2] = 2
    徽标[3] = 1
    徽标[4] = 1
    徽标[5] = 0
    徽标[6] = 0
    徽标[7] = 0
    窗口x = 120
    窗口y = 70
    窗口宽 = 560
    窗口高 = 430
    窗 = 0
    需要重绘 = 1
    画色 = 0xE0554A
    滑条值 = 60
    旧鼠标x = 400
    旧鼠标y = 300
    首帧 = 1
    开机刻 = 毫秒()
    高亮对象 = 0xFFFFFFFF
    盘自检()
    盘格式自检()
    压缩自检()
    fh 0
}

hs 主() -> u32 {
    初始化()
    xh {
        kb mx: u32 = 鼠x()
        kb my: u32 = 鼠y()
        kb s: u32 = 秒()
        时钟秒 = s

        @ 先把上一帧的光标擦掉 —— 必须在画场景之前
        还光标(旧鼠标x, 旧鼠标y)
        rg 首帧 == 1 {
            需要重绘 = 3
            首帧 = 0
        }

        kb cx: u32 = mx
        kb cy: u32 = my
        rg cx > 屏宽() - 24 { cx = 屏宽() - 24 }
        rg cy > 屏高() - 24 { cy = 屏高() - 24 }

        界面开始()

        rg s != 旧秒 {
            旧秒 = s
            rg 需要重绘 == 0 { 需要重绘 = 1 }
        }

        @ 画板每帧都要收鼠标（不能只在重绘里跑，否则涂不上）
        画板输入()

        @ 坞：点图标开窗 / 再点关窗
        kb 点开: u32 = 坞点击(mx, my)
        rg 点开 > 0 {
            rg 窗 == 点开 { 窗 = 0 }
            rg 窗 != 点开 { 窗 = 点开 }
            需要重绘 = 3
        }

        @ 拖动窗口标题栏
        rg 窗 > 0 {
            rg 点判定(mx, my, 窗口x, 窗口y, 窗口宽, 34) == 1 {
                rg 鼠标键 == 1 {
                    rg 键已按 == 0 {
                        拖动偏x = mx - 窗口x
                        拖动偏y = my - 窗口y
                        拖动中 = 1
                    }
                }
            }
            rg 鼠标键 == 0 { 拖动中 = 0 }
            rg 拖动中 == 1 {
                窗口x = mx - 拖动偏x
                窗口y = my - 拖动偏y
                rg 窗口x > 屏宽() - 44 { 窗口x = 屏宽() - 44 }
                rg 窗口y > 屏高() - 100 { 窗口y = 屏高() - 100 }
                需要重绘 = 3
            }
        }

        @ 3 = 整屏  2 = 窗口+坞  1 = 只顶栏（每秒刷新时钟走这条）
        rg 需要重绘 == 3 {
            需要重绘 = 0
            画壁纸()
            画顶栏()
            画窗口(1)
            画坞()
        }
        rg 需要重绘 == 2 {
            需要重绘 = 0
            画窗口(0)
            画坞()
        }
        rg 需要重绘 == 1 {
            需要重绘 = 0
            画顶栏()
        }

        @ ★ 窗口（画板除外）每帧重画一次：按钮的点击检测就发生在绘制里，
        @   只在"需要重绘"时画的话，按钮一秒只能收到一次鼠标。
        @   画板例外 —— 它的画布没有内存备份，重画会把涂的东西擦掉；
        @   它的输入由 画板输入() 每帧单独处理。
        rg 窗 > 0 {
            rg 窗 != 3 { 画窗口(0) }
        }

        界面结束()

        @ 存下光标底下的背景，再画光标
        存光标(cx, cy)
        画鼠标(cx, cy)
        旧鼠标x = cx
        旧鼠标y = cy
    }
    fh 0
}
