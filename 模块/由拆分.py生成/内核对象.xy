# ============================================================================
#  内核对象  ——  由 拆分.py 从 桌面.xy 拆出，可单独编译
#  内核层：内容寻址的对象区。全场唯一共享的状态就在这里。
#  因为全局用 .comm 声明，链接器会把它们合并成一份 ——
#  不管多少个模块都用它，内存里只有一个对象区。
# ============================================================================

jg 矩形 { x: u32  y: u32  w: u32  h: u32 }

jg 容器 {
    x: u32  y: u32  w: u32  h: u32
    cx: u32 cy: u32 cw: u32 ch: u32
    游标x: u32  游标y: u32
    行高: u32   间隙: u32
}

# ---- 全局（用 .comm 声明，链接器合并成一份）----
qj 容器[8]: 容器
qj 容器数: u32
qj 徽标[8]: u32
qj 当x: u32
qj 当y: u32
qj 当w: u32
qj 当h: u32
qj 鼠标x: u32
qj 鼠标y: u32
qj 鼠标键: u32
qj 键已按: u32
qj 新点击: u32
qj 热控件: u32
qj 活动控件: u32
qj 控件号: u32
qj 备份[484]: u32
qj 旧鼠标x: u32
qj 旧鼠标y: u32
qj 首帧: u32
qj 需要重绘: u32
qj 旧秒: u32
qj 窗口x: u32
qj 窗口y: u32
qj 窗口宽: u32
qj 窗口高: u32
qj 拖动中: u32
qj 拖动偏x: u32
qj 拖动偏y: u32
qj 窗: u32
qj 算显: u32
qj 算存: u32
qj 算运: u32
qj 算输: u32
qj 画色: u32
qj 笔画中: u32
qj 笔旧x: u32
qj 笔旧y: u32
qj 开机刻: u32
qj 时钟秒: u32
qj 勾选甲: u32
qj 勾选乙: u32
qj 滑条值: u32
qj 对象哈希[16]: u32        @ 身份 = 内容哈希
qj 对象串[16]: u32          @ 内容（字符串指针）
qj 对象长[16]: u32
qj 对象数: u32
qj 名表[16]: u32            @ 映射：名字
qj 名指[16]: u32            @       指向的对象下标
qj 映射数: u32
qj 史名[128]: u32        @ 视图历史（换回去用）
qj 史指[128]: u32
qj 史映射数[8]: u32
qj 史数: u32
qj 轴[8]: u32               @ 轴：只增不减的操作记录
qj 轴数: u32
qj 高亮对象: u32

hs 串长(s: *u8) -> u32 {
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        i = i + 1
    }
    fh i
}

hs 串等(a: u32, b: u32) -> u32 {
    kb j: u32 = 0
    xh {
        kb ca: u32 = 0
        kb cb: u32 = 0
        wx {
            ca = ^(a + j)
            cb = ^(b + j)
        }
        rg ca != cb { fh 0 }
        rg ca == 0 { fh 1 }
        j = j + 1
    }
    fh 0
}

hs 摘要(s: *u8) -> u32 {          @ FNV-1a 32 位：名字就是它
    kb h: u32 = 2166136261
    kb i: u32 = 0
    kb c: u32 = 0
    xh {
        c = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        h = h yh c
        h = h * 16777619
        i = i + 1
    }
    fh h
}

hs 记轴(s: u32) -> u32 {
    kb i: u32 = 7
    dy i > 0 {
        轴[i] = 轴[i - 1]
        i = i - 1
    }
    轴[0] = s
    rg 轴数 < 8 { 轴数 = 轴数 + 1 }
    fh 0
}

hs 找对象(h: u32) -> u32 {
    kb i: u32 = 0
    dy i < 对象数 {
        rg 对象哈希[i] == h { fh i }
        i = i + 1
    }
    fh 0xFFFFFFFF
}

hs 存对象(s: *u8) -> u32 {
    kb h: u32 = 摘要(s)
    kb k: u32 = 找对象(h)
    rg k != 0xFFFFFFFF {
        高亮对象 = k
        记轴("哈希已存在 → 复用，未占新空间")
        fh k
    }
    kb i: u32 = 对象数
    rg i >= 16 { fh 0xFFFFFFFF }
    对象哈希[i] = h
    对象串[i] = s
    对象长[i] = 串长(s)
    对象数 = 对象数 + 1
    高亮对象 = i
    记轴("追加新对象（只追加，永不原地改）")
    fh i
}

hs 找名字(名: u32) -> u32 {
    kb i: u32 = 0
    dy i < 映射数 {
        rg 串等(名表[i], 名) == 1 { fh i }
        i = i + 1
    }
    fh 0xFFFFFFFF
}

hs 加名(名: u32, 对象: u32) -> u32 {       @ 映射(名, 引用)
    kb i: u32 = 找名字(名)
    rg i != 0xFFFFFFFF {
        名指[i] = 对象
        fh 0
    }
    rg 映射数 >= 16 { fh 0 }
    名表[映射数] = 名
    名指[映射数] = 对象
    映射数 = 映射数 + 1
    fh 0
}

hs 删名(名: u32) -> u32 {                  @ 撤销
    kb i: u32 = 找名字(名)
    rg i == 0xFFFFFFFF { fh 0 }
    kb j: u32 = i
    dy j < 映射数 - 1 {
        名表[j] = 名表[j + 1]
        名指[j] = 名指[j + 1]
        j = j + 1
    }
    映射数 = 映射数 - 1
    fh 0
}

hs 改名(旧: u32, 新: u32) -> u32 {
    kb i: u32 = 找名字(旧)
    rg i == 0xFFFFFFFF { fh 0 }
    kb k: u32 = 找名字(新)
    rg k != 0xFFFFFFFF {
        名指[k] = 名指[i]
        删名(旧)
        fh 0
    }
    名表[i] = 新
    fh 0
}

hs 存视图() -> u32 {                       @ 换视图前留一份，用于"换回去"
    rg 史数 >= 8 { fh 0 }
    kb i: u32 = 0
    dy i < 映射数 {
        史名[史数 * 16 + i] = 名表[i]
        史指[史数 * 16 + i] = 名指[i]
        i = i + 1
    }
    史映射数[史数] = 映射数
    史数 = 史数 + 1
    fh 0
}

hs 恢复视图() -> u32 {                     @ 原子换回上一个视图
    rg 史数 == 0 { fh 0 }
    史数 = 史数 - 1
    kb i: u32 = 0
    dy i < 史映射数[史数] {
        名表[i] = 史名[史数 * 16 + i]
        名指[i] = 史指[史数 * 16 + i]
        i = i + 1
    }
    映射数 = 史映射数[史数]
    记轴("视图根引用已原子切换（无 undo 日志）")
    fh 0
}

hs 对象区自检() -> u32 {
    kb a: u32 = 存对象("混沌")
    kb b: u32 = 存对象("混沌")
    rg a == b { fh 1 }
    fh 0
}
