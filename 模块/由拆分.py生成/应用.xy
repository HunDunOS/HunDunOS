# ============================================================================
#  应用  ——  由 拆分.py 从 桌面.xy 拆出，可单独编译
#  应用层：四个应用 + 对象区窗口。只通过内核原语访问对象。
# ============================================================================

jg 矩形 { x: u32  y: u32  w: u32  h: u32 }

jg 容器 {
    x: u32  y: u32  w: u32  h: u32
    cx: u32 cy: u32 cw: u32 ch: u32
    游标x: u32  游标y: u32
    行高: u32   间隙: u32
}

# ---- 全局（用 .comm 声明，链接器合并成一份）----
qj 容器[8]: 容器
qj 容器数: u32
qj 徽标[8]: u32
qj 当x: u32
qj 当y: u32
qj 当w: u32
qj 当h: u32
qj 鼠标x: u32
qj 鼠标y: u32
qj 鼠标键: u32
qj 键已按: u32
qj 新点击: u32
qj 热控件: u32
qj 活动控件: u32
qj 控件号: u32
qj 备份[484]: u32
qj 旧鼠标x: u32
qj 旧鼠标y: u32
qj 首帧: u32
qj 需要重绘: u32
qj 旧秒: u32
qj 窗口x: u32
qj 窗口y: u32
qj 窗口宽: u32
qj 窗口高: u32
qj 拖动中: u32
qj 拖动偏x: u32
qj 拖动偏y: u32
qj 窗: u32
qj 算显: u32
qj 算存: u32
qj 算运: u32
qj 算输: u32
qj 画色: u32
qj 笔画中: u32
qj 笔旧x: u32
qj 笔旧y: u32
qj 开机刻: u32
qj 时钟秒: u32
qj 勾选甲: u32
qj 勾选乙: u32
qj 滑条值: u32
qj 对象哈希[16]: u32        @ 身份 = 内容哈希
qj 对象串[16]: u32          @ 内容（字符串指针）
qj 对象长[16]: u32
qj 对象数: u32
qj 名表[16]: u32            @ 映射：名字
qj 名指[16]: u32            @       指向的对象下标
qj 映射数: u32
qj 史名[128]: u32        @ 视图历史（换回去用）
qj 史指[128]: u32
qj 史映射数[8]: u32
qj 史数: u32
qj 轴[8]: u32               @ 轴：只增不减的操作记录
qj 轴数: u32
qj 高亮对象: u32

hs 信息行(x: u32, y: u32, k: u32, v: u32, c: u32) -> u32 {
    圆角块(x, y + 6, 7, 7, c)
    绘字(x + 16, y, k, 0x8FA6C8)
    绘字(x + 110, y, v, 0xE8F0FF)
    fh 0
}

hs 画信息(x: u32, y: u32, w: u32, h: u32) -> u32 {
    @ 左边标志
    kb lx: u32 = x + 34
    kb ly: u32 = y + 66
    圆角块(lx, ly, 130, 130, 0x1B2740)
    圆角框(lx, ly, 130, 130, 0x3A5180)
    圆角块(lx + 20, ly + 26, 14, 78, 0x4C8DFF)
    圆角块(lx + 40, ly + 40, 14, 64, 0x6FA8FF)
    圆角块(lx + 60, ly + 54, 14, 50, 0x9AC4FF)
    圆角块(lx + 80, ly + 68, 14, 36, 0xC8DEFF)
    绘字(lx + 22, ly + 108, "混沌", 0xFFFFFF)
    绘字(lx + 30, ly + 130, "HunDun", 0x8FA6C8)

    @ 右边信息
    kb rx: u32 = x + 200
    kb ry: u32 = y + 40
    绘字(rx, ry, "混沌 HunDun OS", 0xFFFFFF)
    绘字(rx, ry + 20, "----------------------------", 0x33456E)
    信息行(rx, ry + 42, "引导器", "xboot · XBP 协议", 0x4C8DFF)
    信息行(rx, ry + 64, "内核", "新语 XinYu v0.4", 0x37C46A)
    信息行(rx, ry + 86, "界面", "混沌UI（译自 microui 架构）", 0x9B5CF6)
    信息行(rx, ry + 108, "显示", "800 x 600 x 32 位", 0xF2A93B)
    信息行(rx, ry + 130, "帧缓冲", "0xFD000000（VBE 线性）", 0xE0554A)
    信息行(rx, ry + 152, "内存", "512 MB", 0x00BFA5)
    信息行(rx, ry + 174, "开机", "已运行", 0x8FA6C8)
    绘数(rx + 110 + 48, ry + 174, (毫秒() - 开机刻) / 1000, 0xE8F0FF)
    绘字(rx + 110 + 48 + 56, ry + 174, "秒", 0x8FA6C8)
    fh 0
}

hs 算键(动作: u32, 标: u32, 宽: u32) -> u32 {
    kb 底: u32 = 0x26334E
    rg 动作 >= 10 { 底 = 0x2F5FA8 }
    rg 动作 == 99 { 底 = 0xE0554A }
    kb r: u32 = 按钮(标, 宽, 40, 底)
    rg r == 1 {
        计算器按键(动作)
        需要重绘 = 2
    }
    fh r
}

hs 计算器按键(a: u32) -> u32 {
    rg a <= 9 {
        rg 算输 == 1 {
            算显 = 算显 * 10 + a
            rg 算显 > 99999999 { 算显 = 99999999 }
        }
        rg 算输 == 0 { 算显 = a }
        算输 = 1
        fh 0
    }
    rg a == 10 {
        算存 = 算显
        算运 = 1
        算输 = 0
        fh 0
    }
    rg a == 11 {
        算存 = 算显
        算运 = 2
        算输 = 0
        fh 0
    }
    rg a == 12 {
        算存 = 算显
        算运 = 3
        算输 = 0
        fh 0
    }
    rg a == 13 {
        算存 = 算显
        算运 = 4
        算输 = 0
        fh 0
    }
    rg a == 14 {
        rg 算运 == 1 { 算显 = 算存 + 算显 }
        rg 算运 == 2 { 算显 = 算存 - 算显 }
        rg 算运 == 3 { 算显 = 算存 * 算显 }
        rg 算运 == 4 {
            rg 算显 > 0 { 算显 = 算存 / 算显 }
        }
        算运 = 0
        算输 = 0
        fh 0
    }
    rg a == 99 {
        算显 = 0
        算存 = 0
        算运 = 0
        算输 = 0
        fh 0
    }
    fh 0
}

hs 画计算器(x: u32, y: u32, w: u32, h: u32) -> u32 {
    @ 显示屏
    圆角块(x + 16, y + 46, w - 32, 62, 0x0B1220)
    圆角框(x + 16, y + 46, w - 32, 62, 0x2A3A5C)
    kb 长: u32 = 0
    kb t: u32 = 算显
    xh {
        长 = 长 + 1
        t = t / 10
        rg t == 0 { tc }
    }
    绘数(x + w - 32 - 长 * 8 - 14, y + 68, 算显, 0x7FD4FF)
    rg 算运 == 1 { 绘字(x + 28, y + 68, "+", 0x8FA6C8) }
    rg 算运 == 2 { 绘字(x + 28, y + 68, "-", 0x8FA6C8) }
    rg 算运 == 3 { 绘字(x + 28, y + 68, "*", 0x8FA6C8) }
    rg 算运 == 4 { 绘字(x + 28, y + 68, "/", 0x8FA6C8) }

    @ 键盘 4x4（先空一行，避开上面的显示屏）
    kb bw: u32 = (w - 32 - 24) / 4
    布局行(70)
    布局行(48)
    算键(99, "C", bw)
    间隔(8)
    算键(1, "7", bw)
    间隔(8)
    算键(2, "8", bw)
    间隔(8)
    算键(3, "9", bw)
    布局行(48)
    算键(13, "/", bw)
    间隔(8)
    算键(4, "4", bw)
    间隔(8)
    算键(5, "5", bw)
    间隔(8)
    算键(6, "6", bw)
    布局行(48)
    算键(12, "*", bw)
    间隔(8)
    算键(7, "1", bw)
    间隔(8)
    算键(8, "2", bw)
    间隔(8)
    算键(9, "3", bw)
    布局行(48)
    算键(11, "-", bw)
    间隔(8)
    算键(0, "0", bw)
    间隔(8)
    算键(14, "=", bw)
    间隔(8)
    算键(10, "+", bw)
    fh 0
}

hs 画板色块(i: u32, x: u32, y: u32) -> u32 {
    kb c: u32 = 0xE0554A
    rg i == 1 { c = 0xF2A93B }
    rg i == 2 { c = 0x37C46A }
    rg i == 3 { c = 0x4C8DFF }
    rg i == 4 { c = 0x9B5CF6 }
    rg i == 5 { c = 0xFFFFFF }
    kb 在: u32 = 点判定(鼠标x, 鼠标y, x, y, 32, 32)
    rg 在 == 1 { 圆角块(x - 2, y - 2, 36, 36, 0xFFFFFF) }
    圆角块(x, y, 32, 32, c)
    rg 在 == 1 {
        rg 鼠标键 == 1 {
            rg 键已按 == 0 { 画色 = c }
        }
    }
    fh 0
}

hs 画板色条(x: u32, y: u32) -> u32 {
    kb i: u32 = 0
    dy i < 6 {
        画板色块(i, x + 70 + i * 40, y + 42)
        i = i + 1
    }
    fh 0
}

hs 画板输入() -> u32 {
    rg 窗 != 3 { fh 0 }
    @ 关闭按钮也得在这里收（画板不每帧重画）
    rg 点判定(鼠标x, 鼠标y, 窗口x + 窗口宽 - 36, 窗口y + 8, 26, 26) == 1 {
        rg 鼠标键 == 1 {
            rg 键已按 == 0 {
                窗 = 0
                需要重绘 = 3
                fh 0
            }
        }
    }
    kb mx: u32 = 鼠标x
    kb my: u32 = 鼠标y
    @ 选色：点中了就只重画色条那一行，不动画布
    kb i: u32 = 0
    dy i < 6 {
        kb sx: u32 = 窗口x + 70 + i * 40
        rg 点判定(mx, my, sx, 窗口y + 42, 32, 32) == 1 {
            rg 鼠标键 == 1 {
                rg 键已按 == 0 {
                    kb n: u32 = 0
                    rg i == 1 { n = 1 }
                    rg i == 2 { n = 2 }
                    rg i == 3 { n = 3 }
                    rg i == 4 { n = 4 }
                    rg i == 5 { n = 5 }
                    画色 = 0xF2A93B
                    rg n == 1 { 画色 = 0xF2A93B }
                    rg n == 2 { 画色 = 0x37C46A }
                    rg n == 3 { 画色 = 0x4C8DFF }
                    rg n == 4 { 画色 = 0x9B5CF6 }
                    rg n == 5 { 画色 = 0xFFFFFF }
                    画板色条(窗口x, 窗口y)
                }
            }
        }
        i = i + 1
    }
    @ 涂画
    kb cy: u32 = 窗口y + 84
    kb 在内: u32 = 点判定(mx, my, 窗口x + 18, cy + 2, 窗口宽 - 36, 窗口高 - 100)
    rg 在内 == 1 {
        rg 鼠标键 == 1 {
            rg 笔画中 == 1 { 直线(笔旧x, 笔旧y, mx, my, 画色) }
            笔画中 = 1
            笔旧x = mx
            笔旧y = my
        }
    }
    rg 鼠标键 == 0 { 笔画中 = 0 }
    fh 0
}

hs 画画板(x: u32, y: u32, w: u32, h: u32) -> u32 {
    绘字(x + 16, y + 46, "颜色", 0x8FA6C8)
    画板色条(x, y)
    绘字(x + w - 20 - 文宽("按住左键涂抹"), y + 46, "按住左键涂抹", 0x5F7A9C)
    kb cy: u32 = y + 84
    kb ch: u32 = h - 96
    印("画板 cy=")
    印(cy)
    印(" ch=")
    印(ch)
    印("\n")
    圆角块(x + 16, cy, w - 32, ch, 0xF4F6FA)
    圆角框(x + 16, cy, w - 32, ch, 0x33456E)
    fh 0
}

hs 画关于(x: u32, y: u32, w: u32, h: u32) -> u32 {
    kb ty: u32 = y + 52
    绘字(x + 24, ty, "混沌 HunDun OS", 0xFFFFFF)
    绘字(x + 24, ty + 34, "一套从零自研的系统，从引导扇区到桌面。", 0xAEC3E0)
    绘字(x + 24, ty + 62, "自研的部分：", 0x4C8DFF)
    绘字(x + 34, ty + 88, "· xboot 引导器（512 字节扇区 + VBE + 保护模式）", 0xAEC3E0)
    绘字(x + 34, ty + 110, "· XBP 自研引导协议", 0xAEC3E0)
    绘字(x + 34, ty + 132, "· 新语语言与 xyc 编译器", 0xAEC3E0)
    绘字(x + 34, ty + 154, "· ISO 9660 / El Torito 打包器", 0xAEC3E0)
    绘字(x + 34, ty + 176, "· 图形运行时、鼠标键盘驱动、桌面", 0xAEC3E0)
    绘字(x + 24, ty + 208, "借的部分（已标注）：", 0xF2A93B)
    绘字(x + 34, ty + 234, "· 16x16 点阵字库位图来自 GNU Unifont", 0xAEC3E0)
    绘字(x + 34, ty + 256, "· 混沌UI 的架构译自 microui（MIT）", 0xAEC3E0)
    绘字(x + 34, ty + 278, "· 构建用的 as / ld / clang", 0xAEC3E0)
    fh 0
}

hs 对象动作(a: u32) -> u32 {
    kb 对: u32 = 0
    rg a == 1 {
        对 = 存对象("混沌")
        加名("混沌", 对)
        需要重绘 = 2
        fh 0
    }
    rg a == 2 {
        对 = 存对象("混沌")
        加名("混沌副本", 对)
        需要重绘 = 2
        fh 0
    }
    rg a == 3 {
        对 = 存对象("这是报告的内容")
        加名("报告", 对)
        需要重绘 = 2
        fh 0
    }
    rg a == 4 {
        存视图()
        改名("报告", "我的报告")
        记轴("改名：只造新映射，对象一字节未动")
        需要重绘 = 2
        fh 0
    }
    rg a == 5 {
        存视图()
        删名("我的报告")
        记轴("删除：从本视图摘掉引用，对象仍在")
        需要重绘 = 2
        fh 0
    }
    rg a == 6 {
        恢复视图()
        需要重绘 = 2
        fh 0
    }
    rg a == 7 {
        对象数 = 0
        映射数 = 0
        史数 = 0
        轴数 = 0
        高亮对象 = 0xFFFFFFFF
        记轴("已清空（演示用；真机上对象永在盘上）")
        需要重绘 = 2
        fh 0
    }
    rg a == 8 {
        kb a1: u32 = 摘要("混沌")
        kb a2: u32 = 摘要("混沌")
        rg a1 == a2 { 记轴("自检：同一内容两次摘要 → 同一哈希，去重生效") }
        rg a1 != a2 { 记轴("自检：哈希不稳定 ✗") }
        需要重绘 = 2
        fh 0
    }
    fh 0
}

hs 对象按钮(标: u32, 宽: u32, 动作: u32) -> u32 {
    kb 底: u32 = 0x26334E
    rg 动作 == 5 { 底 = 0x7A2E2E }
    rg 动作 == 6 { 底 = 0x2F5FA8 }
    kb r: u32 = 按钮(标, 宽, 34, 底)
    rg r == 1 { 对象动作(动作) }
    fh r
}

hs 画对象区(x: u32, y: u32, w: u32, h: u32) -> u32 {
    @ 左：对象区
    圆角块(x + 16, y + 48, 262, 150, 0x0B1220)
    圆角框(x + 16, y + 48, 262, 150, 0x2A3A5C)
    绘字(x + 28, y + 56, "对象区 · 内容寻址 · 只追加", 0x7FD4FF)
    rg 对象数 == 0 { 绘字(x + 34, y + 110, "（空）按下面的按钮存东西", 0x5F7A9C) }
    kb i: u32 = 0
    dy i < 对象数 {
        kb yy: u32 = y + 82 + i * 26
        rg 高亮对象 == i { 圆角块(x + 20, yy - 4, 254, 24, 0x1B2740) }
        rg 高亮对象 != i { 绘块(x + 20, yy - 4, 254, 24, 0x0B1220) }
        绘十六(x + 28, yy, 对象哈希[i], 0x9AC4FF)
        绘数(x + 100, yy, 对象长[i], 0x6E86A8)
        绘字(x + 126, yy, 对象串[i], 0xE8F0FF)
        i = i + 1
    }

    @ 右：当前视图
    圆角块(x + 286, y + 48, 258, 150, 0x0B1220)
    圆角框(x + 286, y + 48, 258, 150, 0x2A3A5C)
    绘字(x + 298, y + 56, "当前视图 · 名字 → 引用", 0x7FD4FF)
    rg 映射数 == 0 { 绘字(x + 304, y + 110, "（空）", 0x5F7A9C) }
    kb j: u32 = 0
    dy j < 映射数 {
        kb yy2: u32 = y + 82 + j * 26
        绘字(x + 298, yy2, 名表[j], 0xE8F0FF)
        绘字(x + 400, yy2, "→", 0x5F7A9C)
        绘十六(x + 418, yy2, 对象哈希[名指[j]], 0x9AC4FF)
        j = j + 1
    }

    @ 下：轴
    圆角块(x + 16, y + 206, 528, 128, 0x0B1220)
    圆角框(x + 16, y + 206, 528, 128, 0x2A3A5C)
    绘字(x + 28, y + 214, "轴 · 操作记录 · 只增不减", 0xF2A93B)
    kb k: u32 = 0
    dy k < 轴数 {
        绘字(x + 28, y + 240 + k * 15, 轴[k], 0xAEC3E0)
        k = k + 1
    }
    rg 轴数 == 0 { 绘字(x + 34, y + 250, "（还没有操作）", 0x5F7A9C) }

    @ 按钮两排
    kb bw: u32 = 126
    布局行(298)
    布局行(38)
    对象按钮("存 混沌", bw, 1)
    间隔(8)
    对象按钮("再存一次", bw, 2)
    间隔(8)
    对象按钮("存 报告", bw, 3)
    间隔(8)
    对象按钮("改名", bw, 4)
    布局行(38)
    对象按钮("删除", bw, 5)
    间隔(8)
    对象按钮("撤销", bw, 6)
    间隔(8)
    对象按钮("清空", bw, 7)
    间隔(8)
    对象按钮("自检", bw, 8)
    fh 0
}

hs 取秒() -> u32 {
    fh 秒()
}

hs 画窗口(画阴: u32) -> u32 {
    rg 窗 == 0 { fh 0 }
    印("[窗=")
    印(窗)
    印("]\n")
    kb w: u32 = 窗口宽
    kb h: u32 = 窗口高
    kb 关: u32 = 0
    rg 窗 == 1 {
        关 = 面板开始(窗口x, 窗口y, w, h, "系统信息", 画阴)
        画信息(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 2 {
        关 = 面板开始(窗口x, 窗口y, w, h, "计算器", 画阴)
        画计算器(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 3 {
        关 = 面板开始(窗口x, 窗口y, w, h, "画板", 画阴)
        画画板(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 4 {
        关 = 面板开始(窗口x, 窗口y, w, h, "关于", 画阴)
        画关于(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 5 {
        关 = 面板开始(窗口x, 窗口y, w, h, "对象区 · 一切皆哈希", 画阴)
        画对象区(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 关 == 1 {
        窗 = 0
        需要重绘 = 3
    }
    fh 0
}

hs 坞点击(mx: u32, my: u32) -> u32 {
    kb w: u32 = 5 * 72 + 20
    kb x: u32 = 屏宽() / 2 - w / 2
    rg 点判定(mx, my, x, 屏高() - 88, w, 76) == 0 { fh 0 }
    rg 鼠标键 == 1 {
        rg 键已按 == 0 {
            kb i: u32 = (mx - x - 14) / 72
            kb bx: u32 = x + 14 + i * 72
            rg mx >= bx {
                rg mx < bx + 56 { fh i + 1 }
            }
        }
    }
    fh 0
}
