00 ========== 鼠 —— PS/2 鼠标驱动（8042，ExitBootServices 之后可用）==========
00 端口：0x64 状态（bit0=有数据 bit5=鼠标数据）  0x60 数据
00 流程：写 0xA8 允许鼠标 → 写 0x20 读配置 → 置位 → 写 0x60 → 写 0x60 0xF4 使能

ts m1 = 0
ts m2 = 0
ts m3 = 0
ts 鼠X = 960
ts 鼠Y = 540
ts 鼠键 = 0
ts 鼠在 = 0

00 等 0x64 输入缓冲空（bit1=0 才能写）
tt 鼠等 01 上限 02 -> u64  08
    m1 = 0
    m2 = 上限
    ll  08
        lz m1 m2  08 ls  09
        m3 = fl 01 0x64 02
        m3 = 01 m3 hs 2 02
        lz m3 0  08 zz 1  09
        m1 = 01 m1 ht 1 02
     09
    zz 0
 09

00 往 0x64 发命令
tt 鼠命令 01 值 02 -> u64  08
    zt 鼠等 01 100000 02
    sl 01 0x64 02 , 值
    zz 0
 09

00 往 0x60 发数据
tt 鼠数据 01 值 02 -> u64  08
    zt 鼠等 01 100000 02
    sl 01 0x60 02 , 值
    zz 0
 09

00 读一个字节（没数据返回 0）
tt 鼠有 01 02 -> u64  08
    m1 = fl 01 0x64 02
    zz 01 m1 hs 1 02
 09

00 ========== 初始化 ==========
tt 鼠启 01 02 -> u64  08
    tz n1 = 0
    tz v1 = 0

    00 ① 允许鼠标端口
    zt 鼠命令 01 0xA8 02

    00 ② 读配置字节
    zt 鼠命令 01 0x20 02
    00 等数据
    n1 = 0
    ll  08
        lz n1 100000  08 ls  09
        v1 = zt 鼠有 01 02
        lz v1 1  08 ls  09
        n1 = 01 n1 ht 1 02
     09
    v1 = fl 01 0x60 02

    00 ③ 置位：bit1=允许鼠标中断  bit0=允许键盘中断
    v1 = 01 v1 hr 3 02
    00 清掉 bit6（翻译）
    v1 = 01 v1 hs 0xBF 02
    zt 鼠命令 01 0x60 02
    zt 鼠数据 01 v1 02

    00 ④ SetDefaults（0xF6）—— 照 SerenityOS 的顺序
    zt 鼠命令 01 0xD4 02
    zt 鼠数据 01 0xF6 02
    zt 鼠等 01 20 02
    v1 = zt 鼠有 01 02
    v1 = fl 01 0x60 02

    00 ⑤ EnablePacketStreaming（0xF4）
    zt 鼠命令 01 0xD4 02
    zt 鼠数据 01 0xF4 02
    zt 鼠等 01 20 02
    v1 = zt 鼠有 01 02
    v1 = fl 01 0x60 02

    鼠在 = 1
    zz 1
 09

00 ========== 读一帧鼠标数据（3 字节），更新 鼠X/鼠Y/鼠键 ==========
00 返回 1 = 读到一帧，0 = 没数据
tt 鼠读 01 02 -> u64  08
    tz n1 = 0
    tz p1 = 0
    tz p2 = 0
    tz p3 = 0
    tz s1 = 0
    tz s2 = 0
    tz s3 = 0

    00 第一字节：必须有 bit3
    p1 = 0
    n1 = 0
    ll  08
        lz n1 200  08 ls  09
        s1 = zt 鼠有 01 02
        lz s1 1  08 ls  09
        n1 = 01 n1 ht 1 02
     09
    s1 = zt 鼠有 01 02
    lz s1 0  08 zz 0  09
    p1 = fl 01 0x60 02
    s3 = 01 p1 hs 8 02
    lz s3 8  08
        00 不同步，丢掉
        zz 0
     09

    00 等第二、第三字节
    n1 = 0
    ll  08
        lz n1 200  08 ls  09
        s1 = zt 鼠有 01 02
        lz s1 1  08 ls  09
        n1 = 01 n1 ht 1 02
     09
    s1 = zt 鼠有 01 02
    lz s1 0  08 zz 0  09
    p2 = fl 01 0x60 02
    n1 = 0
    ll  08
        lz n1 200  08 ls  09
        s1 = zt 鼠有 01 02
        lz s1 1  08 ls  09
        n1 = 01 n1 ht 1 02
     09
    s1 = zt 鼠有 01 02
    lz s1 0  08 zz 0  09
    p3 = fl 01 0x60 02

    00 X 位移（bit4 = 负数标志）
    s1 = p2
    s2 = 01 p1 hs 0x10 02
    lz s2 0x10  08 s1 = 01 p2 hz 256 02  09
    鼠X = 01 鼠X ht s1 02

    00 Y 位移（bit5 = 负数标志）
    s1 = p3
    s2 = 01 p1 hs 0x20 02
    lz s2 0x20  08 s1 = 01 p3 hz 256 02  09
    鼠Y = 01 鼠Y hz s1 02

    鼠键 = 01 p1 hs 7 02

    lr 鼠X < 0  08 鼠X = 0  09
    lr 鼠X > 1919  08 鼠X = 1919  09
    lr 鼠Y < 0  08 鼠Y = 0  09
    lr 鼠Y > 1079  08 鼠Y = 1079  09
    zz 1
 09

