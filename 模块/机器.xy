@ ============================================================================
@  混沌 机器模块（机器.xy）—— 去问真实硬件
@
@  这个模块不编数据，全是"问出来的"：
@    · CPU 厂商 / 型号 / 核数  → CPUID 指令
@    · 电脑品牌 / 型号 / BIOS  → SMBIOS(DMI) 表，在 0xF0000 扫 "_SM_" 锚点
@    · 显卡                    → PCI 配置空间，找类代码 0x03 的设备
@
@  拿不到的就老实说拿不到（比如 IP —— 我们还没有网络栈）。
@ ============================================================================

@ ---------------------------------------------------------------- 缓冲区
qj 机器缓[256]: u32
qj 机器缓址: u32
qj 机器缓2[256]: u32
qj 机器缓2址: u32

hs 机器抄(出: u32, s: u32) -> u32 {
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        wx { ^(出 + i) = c }
        i = i + 1
    }
    wx { ^(出 + i) = 0 }
    fh i
}

hs 机器清(出: u32, n: u32) -> u32 {
    kb i: u32 = 0
    dy i < n {
        wx { ^(出 + i) = 0 }
        i = i + 1
    }
    fh 0
}

@ ---------------------------------------------------------------- CPU：CPUID
@  CPUID 0 → EBX:EDX:ECX 是厂商字符串（各 4 字节）
hs 机器_CPU厂商(出: u32) -> u32 {
    读CPUID(0, 0)
    kb b: u32 = CPUB()
    kb d: u32 = CPUD()
    kb c: u32 = CPUC()
    kb i: u32 = 0
    dy i < 4 {
        wx { ^(出 + i) = (b / (1 << (i * 8))) % 256 }
        i = i + 1
    }
    dy i < 8 {
        wx { ^(出 + i) = (d / (1 << ((i - 4) * 8))) % 256 }
        i = i + 1
    }
    dy i < 12 {
        wx { ^(出 + i) = (c / (1 << ((i - 8) * 8))) % 256 }
        i = i + 1
    }
    wx { ^(出 + 12) = 0 }
    fh 12
}

@  CPUID 0x80000002..4 → 48 字节型号串
hs 机器_CPU型号(出: u32) -> u32 {
    kb f: u32 = 0x80000002
    kb k: u32 = 0
    dy k < 3 {
        读CPUID(f, 0)
        kb a: u32 = CPUE()
        kb b: u32 = CPUB()
        kb c: u32 = CPUC()
        kb d: u32 = CPUD()
        kb i: u32 = 0
        dy i < 4 {
            wx { ^(出 + k * 16 + i) = (a / (1 << (i * 8))) % 256 }
            i = i + 1
        }
        dy i < 8 {
            wx { ^(出 + k * 16 + i) = (b / (1 << ((i - 4) * 8))) % 256 }
            i = i + 1
        }
        dy i < 12 {
            wx { ^(出 + k * 16 + i) = (c / (1 << ((i - 8) * 8))) % 256 }
            i = i + 1
        }
        dy i < 16 {
            wx { ^(出 + k * 16 + i) = (d / (1 << ((i - 12) * 8))) % 256 }
            i = i + 1
        }
        f = f + 1
        k = k + 1
    }
    wx { ^(出 + 48) = 0 }
    fh 48
}

@  CPUID 1 → EBX 的 bit16-23 是逻辑处理器数
hs 机器_CPU核数() -> u32 {
    读CPUID(1, 0)
    fh (CPUB() / 65536) % 256
}

@ ---------------------------------------------------------------- SMBIOS
@  在 0xF0000..0xFFFFF 里按 16 字节步长找 "_SM_" 锚点
hs 机器_SMBIOS表() -> u32 {
    kb p: u32 = 0xF0000
    xh {
        rg p > 0xFFFFF { fh 0 }
        rg 读32(p) == 0x5F4D535F { fh 读32(p + 24) }   @"_SM_"（手算过的小端值）
        p = p + 16
    }
    fh 0
}


hs 机器_下个结构(t: u32) -> u32 {
    kb L: u32 = 读8(t + 1)
    rg L == 0 { fh 0 }                # 长度为 0 = 结构结束
    kb p: u32 = t + L
    kb 步: u32 = 0
    xh {
        rg 步 > 512 { fh 0 }          # ★ 必须有上限，否则遇到坏数据就死循环
        rg 读8(p) == 0 { tc }
        p = p + 1
        步 = 步 + 1
    }
    p = p + 1
    rg 读8(p) == 0 { p = p + 1 }
    fh p
}

hs 机器_找结构(type: u32) -> u32 {
    kb t: u32 = 机器_SMBIOS表()
    rg t == 0 { fh 0 }
    kb i: u32 = 0
    dy i < 64 {
        kb ty: u32 = 读8(t)
        rg ty == 127 { fh 0 }
        rg ty == type { fh t }
        t = 机器_下个结构(t)
        rg t == 0 { fh 0 }
        i = i + 1
    }
    fh 0
}

hs 机器_取串(结构: u32, 序号: u32, 出: u32) -> u32 {
    rg 结构 == 0 { fh 0 }
    rg 序号 == 0 { fh 0 }
    kb L: u32 = 读8(结构 + 1)
    kb s: u32 = 结构 + L
    kb n: u32 = 1
    xh {
        rg n == 序号 { tc }
        xh {
            rg 读8(s) == 0 { tc }
            s = s + 1
        }
        s = s + 1
        n = n + 1
        rg 读8(s) == 0 { fh 0 }
    }
    kb i: u32 = 0
    xh {
        kb c: u32 = 读8(s + i)
        rg c == 0 { tc }
        wx { ^(出 + i) = c }
        i = i + 1
    }
    wx { ^(出 + i) = 0 }
    fh i
}

hs 机器_BIOS厂商(出: u32) -> u32 {
    kb t: u32 = 机器_找结构(0)
    rg t == 0 { fh 0 }
    fh 机器_取串(t, 读8(t + 4), 出)
}

hs 机器_整机厂商(出: u32) -> u32 {
    kb t: u32 = 机器_找结构(1)
    rg t == 0 { fh 0 }
    fh 机器_取串(t, 读8(t + 4), 出)
}

hs 机器_整机型号(出: u32) -> u32 {
    kb t: u32 = 机器_找结构(1)
    rg t == 0 { fh 0 }
    fh 机器_取串(t, 读8(t + 5), 出)
}

@ ---------------------------------------------------------------- PCI / 显卡
hs 机器_PCI读(总线: u32, 设备: u32, 功能: u32, 偏移: u32) -> u32 {
    端出32(0xCF8, 0x80000000 + 总线 * 65536 + 设备 * 2048 + 功能 * 256 + (偏移 wy 0xFC))
    fh 端入32(0xCFC)
}

qj 显卡厂商号: u32
qj 显卡设备号: u32
qj 显卡总线: u32

hs 机器_找显卡() -> u32 {
    kb bus: u32 = 0
    dy bus < 256 {
        kb dev: u32 = 0
        dy dev < 32 {
            kb id: u32 = 机器_PCI读(bus, dev, 0, 0)
            rg (id wy 0xFFFF) != 0xFFFF {
                rg id != 0xFFFFFFFF {
                    kb cc: u32 = 机器_PCI读(bus, dev, 0, 8)
                    rg cc / 16777216 == 3 {
                        显卡厂商号 = id wy 0xFFFF
                        显卡设备号 = id / 65536
                        显卡总线 = bus * 256 + dev
                        fh 1
                    }
                }
            }
            dev = dev + 1
        }
        bus = bus + 1
    }
    fh 0
}

hs 机器_显卡名(出: u32) -> u32 {
    rg 机器_找显卡() == 0 { fh 机器抄(出, "（PCI 上没找到显示设备）") }
    rg 显卡厂商号 == 0x1234 { fh 机器抄(出, "QEMU / Bochs 标准 VGA") }
    rg 显卡厂商号 == 0x8086 { fh 机器抄(出, "Intel 集成显卡") }
    rg 显卡厂商号 == 0x10DE { fh 机器抄(出, "NVIDIA") }
    rg 显卡厂商号 == 0x1002 { fh 机器抄(出, "AMD / ATI") }
    rg 显卡厂商号 == 0x1AF4 { fh 机器抄(出, "Virtio GPU（虚拟化）") }
    rg 显卡厂商号 == 0x15AD { fh 机器抄(出, "VMware 虚拟显卡") }
    fh 机器抄(出, "未识别的厂商")
}

# ============================================================================
#  CPU 核数 —— 数 ACPI 的 MADT 表（最正规的办法）
#    CPUID 1 的 EBX[23:16] 在很多 CPU 上是 0，
#    CPUID 0x0B（扩展拓扑）老 CPU 又不支持。
#    ACPI 的 MADT 里每个逻辑核有一条"处理器本地 APIC"记录，数它最准。
# ============================================================================
hs 机器_RSDP() -> u32 {
    kb p: u32 = 0xE0000
    xh {
        rg p > 0xFFFFF { fh 0 }
        rg 读32(p) == 0x20445352 {              # "RSD "（小端，手算过）
            rg 读32(p + 4) == 0x20525450 { fh p }   # "PTR "
        }
        p = p + 16
    }
    fh 0
}

# 找签名匹配的 ACPI 表，返回表地址
hs 机器_ACPI表(签名: u32) -> u32 {
    kb r: u32 = 机器_RSDP()
    rg r == 0 { fh 0 }
    kb rsdt: u32 = 读32(r + 16)
    rg rsdt == 0 { fh 0 }
    rg 读32(rsdt) != 0x54445352 { fh 0 }        # "RSDT"
    kb 长: u32 = 读32(rsdt + 4)
    rg 长 < 36 { fh 0 }
    rg 长 > 4096 { fh 0 }
    kb n: u32 = (长 - 36) / 4
    rg n > 64 { n = 64 }
    kb i: u32 = 0
    dy i < n {
        kb t: u32 = 读32(rsdt + 36 + i * 4)
        rg t != 0 {
            rg 读32(t) == 签名 { fh t }
        }
        i = i + 1
    }
    fh 0
}

# MADT(签名 "APIC") 里的处理器本地 APIC 记录数
hs 机器_核数() -> u32 {
    kb m: u32 = 机器_ACPI表(0x43495041)         # "APIC"
    rg m == 0 { fh 0 }
    kb 长: u32 = 读32(m + 4)
    rg 长 < 44 { fh 0 }
    rg 长 > 8192 { fh 0 }
    kb p: u32 = m + 44
    kb 尾: u32 = m + 长
    kb n: u32 = 0
    xh {
        rg p + 2 > 尾 { tc }
        kb 类型: u32 = 读8(p)
        kb 记录长: u32 = 读8(p + 1)
        rg 记录长 < 2 { tc }
        rg 类型 == 0 {                          # 处理器本地 APIC
            rg 读8(p + 4) wy 1 {                # flags bit0 = 已启用
                n = n + 1
            }
        }
        p = p + 记录长
    }
    fh n
}
