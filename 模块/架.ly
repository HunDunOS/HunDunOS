00 ========== 矩形：包含 / 相交 / 内缩 ==========
00 用全局传参：rx ry rw rh
ts rx = 0
ts ry = 0
ts rk = 0
ts rh2 = 0

00 点 (px,py) 是否在矩形内：左上闭、右下开
tt 包含 01 px , py 02 -> u64  08
    tz r1 = 0
    tz r2 = 0
    r1 = rx ht rk
    r2 = ry ht rh2
    lr px < rx  08 zz 0  09
    lr py < ry  08 zz 0  09
    lr px >= r1  08 zz 0  09
    lr py >= r2  08 zz 0  09
    zz 1
 09

00 两矩形相交：结果写进 ox oy ow oh，返回 1=有交集 0=无
ts ox = 0
ts oy = 0
ts ow = 0
ts oh = 0

tt 相交 01 ax , ay , aw , ah , bx , by , bw , bh 02 -> u64  08
    tz l = 0
    tz t = 0
    tz r = 0
    tz b = 0
    tz ar = 0
    tz ab = 0
    tz br = 0
    tz bb = 0

    ar = ax ht aw
    ab = ay ht ah
    br = bx ht bw
    bb = by ht bh

    l = ax
    lr bx > ax  08 l = bx  09
    t = ay
    lr by > ay  08 t = by  09
    r = ar
    lr br < ar  08 r = br  09
    b = ab
    lr bb < ab  08 b = bb  09

    lr r <= l  08
        ow = 0
        oh = 0
        zz 0
     09
    lr b <= t  08
        ow = 0
        oh = 0
        zz 0
     09

    ox = l
    oy = t
    ow = 01 r hz l 02
    oh = 01 b hz t 02
    zz 1
 09
