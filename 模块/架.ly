00 ========== 架 —— 场景树骨架（照 Aura 图形结构.rs 翻译）==========
00 只回答「有什么、在哪里、多大」：不涉及颜色，不涉及绘制
00
00 节点用「池 + 父/首子/次兄」三指针，遍历不需要堆、不需要递归
00   父
00    └─ 首子 → 次兄 → 次兄 → 无节点
00         └─ 首子 …
00
00 无节点 = 0xFFFFFFFF（不是 0，这样 0 号节点能正常用）

ts 无节点 = 0xFFFFFFFF
ts 最大节点 = 512
ts 节点池 = 0x30000
ts 节点大小 = 96

00 节点布局（96 字节 / 12 个 u64）
00   +0   号
00   +8   类别      0根 1容器 2文本 3图片 4控件
00   +16  父
00   +24  首子
00   +32  次兄
00   +40  期望宽
00   +48  期望高
00   +56  布局 x
00   +64  布局 y
00   +72  布局宽
00   +80  布局高
00   +88  标志      bit0 可见  bit1 可命中

tt 址 01 号 02 -> u64  08
    tz n = 0
    n = 号 hh 节点大小
    n = 节点池 ht n
    zz n
 09

00 读节点某字段：号、字段号（0~11）
tt 架取 01 号 , 字 02 -> u64  08
    tz a = 0
    tz k = 0
    a = zt 址 01 号 02
    k = 字 dh 3
    a = a ht k
    zz fh a
 09

00 写节点某字段
tt 架存 01 号 , 字 , 值 02 -> u64  08
    tz a = 0
    tz k = 0
    a = zt 址 01 号 02
    k = 字 dh 3
    a = a ht k
    sh a , 值
    zz 0
 09

00 ========== 节点池初始化：全部标成「无节点」==========
tt 清架 01 02 -> u64  08
    tz i = 0
    tz 址0 = 0
    i = 0
    址0 = 节点池
    ll  08
        lz i 12  08 ls  09
        sh 址0 , 0
        址0 = 址0 ht 8
        i = i ht 1
     09
    i = 0
    ll  08
        lz i 最大节点  08 ls  09
        zt 架存 01 i , 2 , 无节点 02
        zt 架存 01 i , 3 , 无节点 02
        zt 架存 01 i , 4 , 无节点 02
        i = i ht 1
     09
    zz 1
 09

00 ========== 新建一个节点（返回号，满了返回无节点）==========
ts 架下一 = 0

tt 新节点 01 类 02 -> u64  08
    tz 号 = 0
    tz 父 = 0
    号 = 架下一
    lz 号 最大节点  08 zz 无节点  09
    父 = zt 架取 01 号 , 2 02
    lz 父 无节点  08
        00 找一个空槽（父 = 无节点 表示空闲）
        号 = 0
        ll  08
            lz 号 最大节点  08 zz 无节点  09
            父 = zt 架取 01 号 , 2 02
            lz 父 无节点  08 ls  09
            号 = 号 ht 1
         09
        lz 号 最大节点  08 zz 无节点  09
     09
    架下一 = 01 号 ht 1 02

    00 填字段
    zt 架存 01 号 , 0 , 号 02
    zt 架存 01 号 , 1 , 类 02
    zt 架存 01 号 , 2 , 无节点 02
    zt 架存 01 号 , 3 , 无节点 02
    zt 架存 01 号 , 4 , 无节点 02
    zt 架存 01 号 , 5 , 0 02
    zt 架存 01 号 , 6 , 0 02
    zt 架存 01 号 , 7 , 0 02
    zt 架存 01 号 , 8 , 0 02
    zt 架存 01 号 , 9 , 0 02
    zt 架存 01 号 , 10 , 0 02
    zt 架存 01 号 , 11 , 3 02
    zz 号
