00 ========== 挂子节点：父 首子 次兄 三指针 ==========
tt 挂子 01 父号 , 子号 02 -> u64  08
    tz 首 = 0
    tz 走 = 0
    tz 兄 = 0
    首 = zt 架取 01 父号 , 3 02
    lz 首 无节点  08
        00 父还没有子，直接当首子
        zt 架存 01 父号 , 3 , 子号 02
        zt 架存 01 子号 , 2 , 父号 02
        zz 1
     09
    00 走到最后一个兄弟
    走 = 首
    ll  08
        兄 = zt 架取 01 走 , 4 02
        lz 兄 无节点  08 ls  09
        走 = 兄
     09
    zt 架存 01 走 , 4 , 子号 02
    zt 架存 01 子号 , 2 , 父号 02
    zz 1
