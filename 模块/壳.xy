@ ============================================================================
@  混沌 终端壳（壳.xy）—— 纯文本模式的命令行
@
@  它不是一个普通的 shell：它直接把【内核能力】端到你面前。
@     cun 内容        存对象（内容寻址）→ 打印哈希
@     qu 哈希         按哈希取回（哈希不对就取不出来）
@     lie             列出盘上所有对象
@     pan             盘状态（超级块字段）
@     shan 哈希       从视图里摘掉这个名字（对象还在）
@     bang            帮助
@     qing            清屏
@     guan            停机
@
@  存的还是【盘】不是内存 —— 关掉再开，东西还在。
@ ============================================================================

qj 行缓冲[136]: u32              @ 一行输入



@ 包模块（包.xy）的东西
qj 包起始LBA: u32
qj 工具LBA: u32
qj 盘状态: u32                @ 0 没盘 / 1 刚格式化 / 2 已有格式
qj 当前视图: u32
qj 对象哈希[16]: u32              @ C 工具包的盘上位置
qj 包扇区数: u32
qj 包成员数: u32
qj 包清单: u32
qj 包数据: u32
qj 包长: u32
qj 包缓冲[8192]: u32
qj 包缓冲址: u32

@ 网卡模块（网卡.xy）
qj 卡基址: u32
qj 卡在: u32
qj 卡MAC[6]: u32
qj 包址: u32
qj 包可执行入口: u32
qj 包可执行偏移: u32
qj 包可执行长: u32
qj 包加载址: u32
qj 行长: u32
qj 词[136]: u32                  @ 命令 / 参数（按字节紧凑存放）
qj 词址: u32
qj 参址: u32

qj 取回[512]: u32                @ 与 盘格式.xy 共享
qj 取回址: u32

qj 盘缓冲[512]: u32              @ 与 盘.xy / 盘格式.xy 共享（.comm 合并成一份）

@ 盘格式的字段（在同一批全局里声明一次，链接器合并）
qj 盘版本: u32
qj 盘总扇区: u32
qj 盘索引起: u32
qj 盘索引数: u32
qj 盘对象起: u32
qj 盘追加: u32
qj 盘轴起: u32
qj 盘轴数: u32
qj 盘视图根: u32
qj 盘对象数: u32
qj 盘世代: u32

@ 机器模块的全局（.comm 合并）
qj 机器缓[256]: u32
qj 机器缓2[256]: u32
qj 机器缓址: u32
qj 机器缓2址: u32
qj 显卡厂商号: u32
qj 显卡设备号: u32
qj 显卡总线: u32


@ ============================================================================
@  帧缓冲控制台 —— 文本模式的 VGA 显示不了中文（一格 1 字节），
@  所以自己用字库往帧缓冲上画。这是终端能显示中文的唯一办法。
@ ============================================================================
qj 光x: u32
qj 光y: u32
qj 区x: u32
qj 区y: u32
qj 区宽: u32
qj 区高: u32
qj 当前色: u32
qj 段缓[640]: u32
qj 段址: u32

hs 文宽2(s: u32) -> u32 {
    kb n: u32 = 0
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        rg c < 128 { n = n + 8 }
        rg c >= 128 { n = n + 16 }
        i = i + 1
    }
    fh n
}



# ============================================================================
#  身份符号 —— 不用 Unix 那套 root@host
#     ♂ = 超级用户（本源 / 内核自己）     显示 hundun♂GNY
#     ♀ = 普通用户（受限的分身）          显示 hundun♀
#  混沌里【没有 root、没有账户】—— 只有本源签发的分身，
#  所以身份只用这两个符号表示权柄级别，不引入 Unix 的概念层。
# ============================================================================
qj 身份: u32

hs 身份行() -> u32 {
    rg 身份 == 1 {
        屏串("hundun♂GNY")
        fh 0
    }
    屏串("hundun♀")
    fh 0
}

hs 屏设色(c: u32) -> u32 {
    当前色 = c
    fh 0
}

@ fastfetch 那个路数：左边一块标志，右边一串 标签: 值
qj 标x: u32
qj 值x: u32
qj 行y: u32

hs 行进() -> u32 {
    行y = 行y + 22
    光y = 行y
    光x = 值x
    fh 0
}

hs 终端信息行(名: u32, 值: u32, 色: u32) -> u32 {
    光x = 值x
    光y = 行y
    屏设色(0x6E86A8)
    屏串(名)
    光x = 值x + 96
    屏设色(色)
    屏串(值)
    光x = 值x + 96
    行进()
    fh 0
}

@ ============================================================================
@  混沌的标志 —— 不用汉字，用【意象】
@    外圈疏（░）→ 中圈渐密（▒）→ 内圈实（▓█）
@    核心故意不圆：还没分化出形状 —— 这就是"混沌"
@  用的都是方块字符，跟"一切皆方块（对象）"也对得上
@ ============================================================================
qj 标志x: u32
qj 标志y: u32
qj 行高: u32

hs 标志行(串: u32, 色: u32) -> u32 {
    屏设色(色)
    光x = 标志x
    光y = 标志y
    屏串(串)
    标志y = 标志y + 行高
    fh 0
}

hs 机器标志() -> u32 {
    标志x = 区x + 14
    标志y = 区y + 26
    行高 = 22
    标志行("      ░░░░░", 0x2E4A6E)
    标志行("    ░▒▒▒▒▒▒▒░", 0x3A5C86)
    标志行("   ░▒▓▓▓▓▓▓▓▒░", 0x4C8DFF)
    标志行("  ░▒▓███████▓▒░", 0x6FA8FF)
    标志行("  ░▒▓█▒▒▒▒▒█▓▒░", 0x9AC4FF)
    标志行("  ░▒▓█▓███▒█▓▒░", 0xC8DEFF)   @ 核心偏在一侧，不圆
    标志行("  ░▒▓███████▓▒░", 0x6FA8FF)
    标志行("   ░▒▓▓▓▓▓▓▓▒░", 0x4C8DFF)
    标志行("    ░▒▒▒▒▒▒▒░", 0x3A5C86)
    标志行("      ░░░░░", 0x2E4A6E)
    fh 0
}

@ 设定控制台活动的矩形（终端独立跑时 = 整屏；嵌进窗口时 = 窗口内容区）
hs 设区(x: u32, y: u32, w: u32, h: u32) -> u32 {
    区x = x
    区y = y
    区宽 = w
    区高 = h
    fh 0
}

hs 区内清() -> u32 {
    rg 区宽 == 0 { 绘块(0, 0, 屏宽(), 屏高(), 0x0A0E18)  fh 0 }
    绘块(区x, 区y, 区宽, 区高, 0x0A0E18)
    fh 0
}

hs 屏清() -> u32 {
    rg 区宽 == 0 {
        绘块(0, 0, 屏宽(), 屏高(), 0x0A0E18)
        绘块(0, 0, 屏宽(), 3, 0x1E9E8A)
        光x = 14
        光y = 14
        fh 0
    }
    绘块(区x, 区y, 区宽, 区高, 0x0A0E18)
    光x = 区x + 8
    光y = 区y + 8
    fh 0
}

hs 屏换行() -> u32 {
    出(10)                       @ 串口镜像也换行，日志读得清
    rg 区宽 == 0 {
        光x = 14
        光y = 光y + 22
        rg 光y > 屏高() - 30 { 滚屏(22, 0x0A0E18)  光y = 光y - 22 }
        fh 0
    }
    光x = 区x + 8
    光y = 光y + 22
    rg 光y > 区y + 区高 - 26 {
        滚块(区x, 区y, 区宽, 区高, 22, 0x0A0E18)
        光y = 光y - 22
    }
    fh 0
}

hs 屏出(c: u32) -> u32 {
    rg c == 10 { 屏换行()  fh 0 }
    rg c == 8 {                  @ ★ 退格：把光标退回去并把那个格子擦掉
        rg 光x > 14 {
            光x = 光x - 8
            绘块(光x, 光y, 8, 18, 0x0A0E18)
        }
        fh 0
    }
    rg c >= 32 { 出(c) }         @ 串口镜像：数字也进日志
    rg c == 13 { fh 0 }
    rg c < 32 { fh 0 }
    rg c >= 128 { fh 0 }
    wx {
        ^(段址 + 0) = c
        ^(段址 + 1) = 0
    }
    绘字(光x, 光y, 段址, 当前色)
    光x = 光x + 8
    rg 区宽 == 0 { rg 光x > 屏宽() - 24 { 屏换行() } }
    rg 区宽 != 0 { rg 光x > 区x + 区宽 - 16 { 屏换行() } }
    fh 0
}

hs 屏串(s: u32) -> u32 {
    印串(s)                      @ 同时镜像到串口，方便抓日志
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { fh 0 }
        kb j: u32 = 0
        xh {
            kb d: u32 = 0
            wx { d = ^(s + i + j) }
            rg d == 0 { tc }
            rg d == 10 { tc }
            wx { ^(段址 + j) = d }
            j = j + 1
        }
        wx { ^(段址 + j) = 0 }
        rg j > 0 {
            绘字(光x, 光y, 段址, 当前色)
            光x = 光x + 文宽2(段址)
        }
        i = i + j
        kb e: u32 = 0
        wx { e = ^(s + i) }
        rg e == 10 {
            屏换行()
            i = i + 1
        }
        rg e == 0 { fh 0 }
        rg 区宽 == 0 { rg 光x > 屏宽() - 24 { 屏换行() } }
    rg 区宽 != 0 { rg 光x > 区x + 区宽 - 16 { 屏换行() } }
    }
    fh 0
}

hs 屏数(n: u32) -> u32 {
    kb 十: u32 = 0
    kb t: u32 = n
    xh {
        十 = 十 + 1
        t = t / 10
        rg t == 0 { tc }
    }
    kb i: u32 = 0
    kb 权: u32 = 1
    dy i < 十 - 1 {
        权 = 权 * 10
        i = i + 1
    }
    xh {
        屏出(48 + (n / 权) % 10)
        权 = 权 / 10
        rg 权 == 0 { tc }
    }
    fh 0
}

@ ---------------------------------------------------------------- 基础
hs 换行() -> u32 {
    屏换行()
    fh 0
}

hs 印串2(s: u32) -> u32 {
    屏串(s)
    fh 0
}

hs 串长2(s: u32) -> u32 {
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        i = i + 1
    }
    fh i
}

hs 串等2(a: u32, b: u32) -> u32 {
    kb i: u32 = 0
    xh {
        kb x: u32 = 0
        kb y: u32 = 0
        wx {
            x = ^(a + i)
            y = ^(b + i)
        }
        rg x != y { fh 0 }
        rg x == 0 { fh 1 }
        i = i + 1
    }
    fh 0
}

@ 一个字符的十六进制值；不是十六进制字符就返回 99
hs 十六值(c: u32) -> u32 {
    kb r: u32 = 99
    rg c >= 48 && c <= 57 { r = c - 48 }          @ 0-9
    rg c >= 97 && c <= 102 { r = c - 87 }         @ a-f
    rg c >= 65 && c <= 70 { r = c - 55 }          @ A-F
    fh r
}

@ 字符串 → 数。
@ ★ 必须认 0x 开头的十六进制 —— 因为 lie / cun 打出来的哈希就是十六进制，
@   只认十进制的话，复制哈希喂给 qu 会得到 0（issue #291）。
hs 串转数(s: u32) -> u32 {
    kb n: u32 = 0
    kb i: u32 = 0
    kb c0: u32 = 0
    wx { c0 = ^(s + 0) }
    kb c1: u32 = 0
    wx { c1 = ^(s + 1) }
    rg c0 == 48 {
        rg c1 == 120 {                     @ '0' 'x'
            i = 2
            xh {
                kb hc: u32 = 0
                wx { hc = ^(s + i) }
                kb v: u32 = 十六值(hc)
                rg v > 15 { tc }
                n = n * 16 + v
                i = i + 1
            }
            fh n
        }
    }
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c < 48 { tc }
        rg c > 57 { tc }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    fh n
}

@ ---------------------------------------------------------------- 读一行

@ ── 把当前这一行按 行缓冲/光位 重画一遍 ────────────────────────
qj 光位: u32
qj 行首y: u32
qj 行首x: u32              @ 提示符结束的位置 —— 重画行必须从这儿开始

hs 重画行() -> u32 {
    @ ★ 必须从【提示符结束处】重画。以前写死 区x+8，每打一个字就把
    @   提示符那块重新盖一遍 —— 屏幕上看着就是字和提示符糊在一起、退不掉。
    光x = 行首x
    光y = 行首y
    kb i: u32 = 0
    dy i < 行长 {
        屏出(行缓冲[i])
        i = i + 1
    }
    @ 清掉后面可能残留的字
    kb j: u32 = 0
    dy j < 10 {
        屏出(32)
        j = j + 1
    }
    光x = 行首x + 光位 * 8
    光y = 行首y
    fh 0
}

@ ── 在光标处插一个字节 ────────────────────────────────────────
hs 行插(c: u32) -> u32 {
    rg 行长 >= 130 { fh 0 }
    kb j: u32 = 行长
    dy j > 光位 {
        行缓冲[j] = 行缓冲[j - 1]
        j = j - 1
    }
    行缓冲[光位] = c
    行长 = 行长 + 1
    光位 = 光位 + 1
    fh 0
}

@ ── 删掉光标前面那个字节 ───────────────────────────────────────
hs 行删前() -> u32 {
    rg 光位 == 0 { fh 0 }
    kb i: u32 = 光位 - 1
    dy i < 行长 - 1 {
        行缓冲[i] = 行缓冲[i + 1]
        i = i + 1
    }
    行长 = 行长 - 1
    光位 = 光位 - 1
    fh 0
}

hs 读行() -> u32 {
    行长 = 0
    光位 = 0
    行首y = 光y
    xh {
        kb k: u32 = 键()
        rg k == 0 {
            睡(8)
            jx
        }
        rg k == 13 { tc }                  @ 回车
        rg k == 8 {                        @ 退格
            行删前()
            重画行()
            jx
        }
        rg k == 19 {                       @ ← 方向键
            rg 光位 > 0 {
                光位 = 光位 - 1
                重画行()
            }
            jx
        }
        rg k == 20 {                       @ → 方向键
            rg 光位 < 行长 {
                光位 = 光位 + 1
                重画行()
            }
            jx
        }
        rg k == 6 {                        @ End
            光位 = 行长
            重画行()
            jx
        }
        rg k == 21 {                       @ Home
            光位 = 0
            重画行()
            jx
        }
        rg k >= 32 {
            行插(k)
            重画行()
        }
    }
    行缓冲[行长] = 0
    换行()
    fh 行长
}

@ ---------------------------------------------------------------- 分词
@  命令放 词址+0，参数放 词址+64，都是按字节紧凑存的
hs 分词() -> u32 {
    kb i: u32 = 0
    kb n: u32 = 0
    xh {                                   @ 跳过前导空格
        rg 行缓冲[i] == 0 { tc }
        rg 行缓冲[i] != 32 { tc }
        i = i + 1
    }
    xh {                                   @ 取命令
        rg 行缓冲[i] == 0 { tc }
        rg 行缓冲[i] == 32 { tc }
        kb c: u32 = 行缓冲[i]
        wx { ^(词址 + n) = c }
        n = n + 1
        i = i + 1
    }
    wx { ^(词址 + n) = 0 }
    xh {                                   @ 跳过空格
        rg 行缓冲[i] == 0 { tc }
        rg 行缓冲[i] != 32 { tc }
        i = i + 1
    }
    kb j: u32 = 0
    xh {                                   @ 取参数
        rg 行缓冲[i] == 0 { tc }
        kb c2: u32 = 行缓冲[i]
        wx { ^(参址 + j) = c2 }
        j = j + 1
        i = i + 1
    }
    wx { ^(参址 + j) = 0 }
    fh 0
}

@ ---------------------------------------------------------------- 十个数字（十六进制打印哈希）
hs 打十六(v: u32) -> u32 {
    kb i: u32 = 0
    kb 起: u32 = 0
    xh {
        kb 移: u32 = (7 - i) * 4
        kb t: u32 = (v / (1 << 移)) % 16
        rg t < 10 { 屏出(48 + t) }
        rg t >= 10 { 屏出(87 + t) }
        i = i + 1
        rg i >= 8 { tc }
    }
    fh 0
}

@ ---------------------------------------------------------------- 列对象
hs 列对象() -> u32 {
    @ 索引区里逐项扫，非零就是有对象
    kb 扇: u32 = 0
    kb 数: u32 = 0
    dy 扇 < 16 {
        rg 盘读扇区(盘索引起 + 扇) == 0 { tc }
        kb j: u32 = 0
        dy j < 64 {
            kb off: u32 = j * 8
            kb h: u32 = 盘缓冲[off] + 盘缓冲[off+1]*256 + 盘缓冲[off+2]*65536 + 盘缓冲[off+3]*16777216
            rg h != 0 {
                kb lba: u32 = 盘缓冲[off+4] + 盘缓冲[off+5]*256 + 盘缓冲[off+6]*65536 + 盘缓冲[off+7]*16777216
                屏串("  ")
                打十六(h)
                屏串("   扇区 ")
                屏数(lba)
                屏串("   内容「")
                rg 盘取对象(h) > 0 { 屏串(取回址) }
                屏串("」")
                换行()
                数 = 数 + 1
                @ ★ 盘取对象 用的是同一个盘缓冲，刚把本索引扇区冲掉了 → 重读
                盘读扇区(盘索引起 + 扇)
            }
            j = j + 1
        }
        扇 = 扇 + 1
    }
    rg 数 == 0 { 屏串("  （盘上还没有对象）")  换行() }
    屏串("  共 ")
    屏数(数)
    屏串(" 个对象")
    换行()
    fh 数
}

@ ---------------------------------------------------------------- 帮助
hs 帮助() -> u32 {
    屏串("  混沌 HunDun — 内核能力终端")
    换行()
    屏串("  ------------------------------------------")
    换行()
    屏串("  xin         看这台机器的信息（真去问硬件）")
    换行()
    屏串("  wang        网卡自检（找 NE2000、读 MAC）")
    换行()
    屏串("  zhuang      把 .bao 包装进对象区（内核装包）")
    换行()
    屏串("  bianji      装包并进编辑器（跑包里的代码）")
    换行()
    屏串("  gongju      跑 C 工具包（任何语言的工具，只要能编成 .bao）")
    换行()
    屏串("  cun 内容    存对象（内容寻址）→ 打印哈希")
    换行()
    屏串("  qu 哈希     按哈希取回")
    换行()
    屏串("  lie         列出盘上所有对象")
    换行()
    屏串("  pan         盘状态")
    换行()
    屏串("  shi         存一段中文示例")
    换行()
    屏串("  bang        这份帮助")
    换行()
    屏串("  qing        清屏")
    换行()
    屏串("  guan        停机")
    换行()
    换行()
    屏串("  提示：同样的内容存两次，哈希一样，盘上只占一份。")
    换行()
    屏串("        关掉再开，东西还在 —— 因为它在盘上。")
    换行()
    fh 0
}

@ ---------------------------------------------------------------- 执行
hs 执行() -> u32 {
    kb hh: u32 = 0        @ 一个函数一个作用域，重复 kb 会冲突
    rg 命令是("cun") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        kb 长: u32 = 串长2(参址)
        rg 长 == 0 {
            屏串("  用法：cun 内容")
            换行()
            fh 0
        }
        hh = 盘存对象(参址)
        rg hh == 0 {
            屏串("  存失败")
            换行()
            fh 0
        }
        屏串("  已存 → 哈希 0x")
        打十六(hh)
        换行()
        视图_加映射(参址, hh)
        屏串("  并在这个视图里起名「")
        屏串(参址)
        屏串("」")
        换行()
        fh 0
    }
    rg 命令是("qu") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        hh = 串转数(参址)
        rg 盘取对象(hh) == 0 {
            屏串("  取不到：盘上没有这个哈希")
            换行()
            fh 0
        }
        屏串("  「")
        屏串(取回址)
        屏串("」")
        换行()
        fh 0
    }
    rg 命令是("liepan") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        列对象()
        fh 0
    }
    rg 命令是("格式化") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        屏设色(0xE0554A)
        屏串("  格式化：盘上现有 ")
        屏数(盘对象数)
        屏串(" 个对象，全部清掉")
        换行()
        盘格式化(16384)
        超级块读()
        盘状态 = 1
        屏设色(0x37C46A)
        屏串("  已重新格式化")
        换行()
        fh 0
    }
    rg 命令是("pan") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        rg 超级块读() == 0 {
            屏串("  盘上没有格式")
            换行()
            fh 0
        }
        屏串("  格式版本 ")
        屏数(盘版本)
        屏串("   世代 ")
        屏数(盘世代)
        换行()
        屏串("  对象数 ")
        屏数(盘对象数)
        屏串("   追加指针 LBA ")
        屏数(盘追加)
        屏串("   索引起 LBA ")
        屏数(盘索引起)
        换行()
        fh 0
    }
    rg 命令是("shi") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        kb a: u32 = 盘存对象("混沌")
        kb b: u32 = 盘存对象("一切皆哈希")
        kb c: u32 = 盘存对象("混沌")
        屏串("  存入「混沌」→ ")
        打十六(a)
        换行()
        屏串("  存入「一切皆哈希」→ ")
        打十六(b)
        换行()
        屏串("  再存一次「混沌」→ ")
        打十六(c)
        rg c == a {
            屏串("   （同一个哈希，盘上只占一份）")
        }
        换行()
        fh 0
    }
    rg 命令是("xin") == 1 {
        显示机器信息()
        fh 0
    }
    rg 命令是("wang") == 1 {
        网卡_自检()
        fh 0
    }
    rg 命令是("ping") == 1 {
        网卡_PING(参址)
        fh 0
    }
    rg 命令是("wen") == 1 {
        @ 问一个 IP 的 MAC（ARP）。不带参数就默认问网关 10.0.2.2
        网卡_问(10, 0, 2, 2)
        fh 0
    }
    rg 命令是("lie") == 1 {
        视图_列映射()
        fh 0
    }
    rg 命令是("qie") == 1 {
        视图_切换名(参址)
        换行()
        提示符()
        fh 0
    }
    rg 命令是("fen") == 1 {
        视图_签发(参址, 7)
        换行()
        提示符()
        fh 0
    }
    rg 命令是("shui") == 1 {
        视图_自检()
        fh 0
    }
    rg 命令是("zhuang") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        @ 可以带一个 LBA：zhuang 8200（不给就还是 8000 那个编辑器包）
        kb 哪: u32 = 串转数(参址)
        rg 哪 != 0 { 包起始LBA = 哪 }
        包_从盘装()
        fh 0
    }
    rg 命令是("shou") == 1 {
        插件_列()
        fh 0
    }
    rg 命令是("bianji") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        包_装并跑()
        fh 0
    }
    rg 命令是("gongju") == 1 {
        rg 视图_要能力(8) == 0 { fh 0 }
        屏设色(0x9AC4FF)
        屏串("  跑 C 工具包（LBA ")
        屏数(工具LBA)
        屏串("）")
        换行()
        kb 旧: u32 = 包起始LBA
        包起始LBA = 工具LBA
        包_装并跑()
        包起始LBA = 旧
        fh 0
    }
    rg 命令是("bang") == 1 {
        帮助()
        fh 0
    }
    rg 命令是("qing") == 1 {
        屏清()
        fh 0
    }
    rg 命令是("guan") == 1 {
        屏串("  再见。")
        换行()
        停机()
        fh 0
    }
    @ ★ shou（手）：内置命令都不命中，才查插件表 ——
    @   装一个包 = 长出一条新命令，内核一行都不用改
    rg 插件_跑(词址, 参址) == 1 { fh 0 }
    屏串("  不认识的命令：")
    屏串(词址)
    换行()
    屏串("  输入 bang 看帮助")
    换行()
    fh 0
}


@ ============================================================================
@  xin —— 系统信息（fastfetch 那个路数，但每一项都是真去问硬件的）
@ ============================================================================
hs 显示机器信息() -> u32 {
    屏清()
    标x = 区x + 14
    值x = 区x + 130
    行y = 区y + 20
    机器标志()

    光x = 值x
    光y = 行y
    屏设色(0x37C46A)
    身份行()
    行进()
    屏设色(0x2A3A5C)
    光x = 值x
    屏串("-----------------------")
    行进()

    终端信息行("系统", "混沌 HunDun OS", 0x9AC4FF)
    终端信息行("内核", "自研引导器 xboot + 新语内核", 0x9AC4FF)
    终端信息行("语言", "新语（关键字全拼音，危险操作要 wx{}）", 0x9AC4FF)

    rg 机器_BIOS厂商(机器缓2址) > 0 { 终端信息行("固件", 机器缓2址, 0x8FA6C8) }

    @ CPU —— 真的执行 CPUID
    机器_CPU型号(机器缓址)
    机器_CPU厂商(机器缓2址)
    终端信息行("处理器", 机器缓址, 0x37C46A)
    光x = 值x + 96
    光y = 行y
    屏设色(0x5F7A9C)
    屏串(机器缓2址)
    屏串(" · ")
    kb 核: u32 = 机器_核数()
    rg 核 == 0 { 核 = 机器_CPU核数() }
    rg 核 == 0 { 核 = 1 }
    屏数(核)
    屏串(" 核")
    行进()

    @ 显卡 —— 真的扫 PCI
    机器_显卡名(机器缓址)
    终端信息行("显卡", 机器缓址, 0x9B5CF6)

    @ 内存
    机器清(机器缓址, 32)
    光x = 值x
    光y = 行y
    屏设色(0x6E86A8)
    屏串("内存")
    光x = 值x + 96
    屏设色(0x00BFA5)
    屏数(内存() / 1024)
    屏串(" MB")
    行进()

    @ 显示
    光x = 值x
    光y = 行y
    屏设色(0x6E86A8)
    屏串("显示")
    光x = 值x + 96
    屏设色(0x4C8DFF)
    屏数(屏宽())
    屏串(" x ")
    屏数(屏高())
    屏串(" x 32 位　帧缓冲 0x")
    打十六(帧址())
    行进()

    @ 盘
    rg 超级块读() == 1 {
        光x = 值x
        光y = 行y
        屏设色(0x6E86A8)
        屏串("盘")
        光x = 值x + 96
        屏设色(0xF2A93B)
        屏串("混沌盘 v")
        屏数(盘版本)
        屏串("　")
        屏数(盘总扇区 / 2048)
        屏串(" MB　")
        屏数(盘对象数)
        屏串(" 个对象")
        行进()
    }

    @ IP —— 老实说拿不到
    终端信息行("网络", "（还没有网络栈，所以没有 IP）", 0x7A5F5F)
    光x = 值x + 96
    光y = 行y
    屏设色(0xE0554A)

    光x = 值x + 96
    光y = 行y
    屏设色(0xE0554A)


    光x = 值x
    光y = 行y + 22
    屏设色(0x3A4A66)
    屏串("一切皆哈希 · 内容寻址 · 只追加")
    行进()
    行进()
    光x = 14
    光y = 行y
    fh 0
}

hs 命令是(s: u32) -> u32 {
    fh 串等2(词址, s)
}

@ ---------------------------------------------------------------- 入口

# ============================================================================
#  嵌进窗口用的一套（非阻塞）—— 桌面里的「终端」应用调它
# ============================================================================
qj 终端已开: u32

hs 提示符() -> u32 {
    屏设色(0x37C46A)
    屏串(视图_当前名())
    rg 当前视图 == 0 { 屏串("♂> ") }
    rg 当前视图 != 0 { 屏串("♀> ") }
    屏设色(0xE8F0FF)
    行首x = 光x                @ ★ 记下提示符结束的位置
    行首y = 光y
    行长 = 0
    光位 = 0
    fh 0
}

hs 终端开() -> u32 {
    rg 身份 == 0 { 身份 = 1 }
    屏清()
    屏设色(0x9AC4FF)
    屏串("@（关键字全拼音，危险操作要 wx{}）")
    屏换行()
    屏设色(0x3A4A66)
    屏串("--------------------------------------")
    屏换行()
    屏设色(0x8FA6C8)
    屏串("xin 看硬件 · cun 存对象 · qu 取回 · lie 列出 · pan 盘状态")
    屏换行()
    屏设色(0x8FA6C8)
    屏串("shui 视图 · fen 签发分身 · qie 切视图 · zhuang 装包 · gongju 跑C工具")
    屏换行()
    屏换行()
    盘_报状态()
    屏换行()
    屏设色(0xE8F0FF)
    提示符()
    fh 0
}

@ 每帧调一次：最多吃 4 个按键，吃完就返回（不阻塞，鼠标才动得了）
hs 终端一步() -> u32 {
    kb n: u32 = 0
    dy n < 4 {
        kb k: u32 = 键()
        rg k == 0 { tc }
        rg k == 13 {
            换行()
            行缓冲[行长] = 0
            分词()
            执行()
            提示符()
            n = n + 1
            jx
        }
        rg k == 8 {
            行删前()
            重画行()
            n = n + 1
            jx
        }
        rg k == 19 {
            rg 光位 > 0 { 光位 = 光位 - 1  重画行() }
            n = n + 1
            jx
        }
        rg k == 20 {
            rg 光位 < 行长 { 光位 = 光位 + 1  重画行() }
            n = n + 1
            jx
        }
        rg k >= 32 {
            行插(k)
            重画行()
            n = n + 1
        }
    }
    fh 0
}

@ ============================================================================
@  初始化（终端版和桌面版共用）
@
@  ★ 这一块以前只在 终端主() 里跑 —— 而桌面版从来不调 终端主()，
@    所以桌面里的「史书」一直是带着 视图数=0 / 工具LBA=0 在跑的。
@    现在抽出来，两边都调它。
@ ============================================================================
hs 壳_初始化() -> u32 {
    wx {
        段址 = 地址(段缓)
        机器缓址 = 地址(机器缓)
        机器缓2址 = 地址(机器缓2)
        当前色 = 0xE8F0FF
        词址 = 地址(词)
        参址 = 地址(词) + 64
        取回址 = 地址(取回)
        包缓冲址 = 地址(包缓冲)
        包起始LBA = 8000            @ 编辑器.bao 在盘上的位置
        工具LBA = 8100              @ .bao 放工具的位置（构建期 xbao.py 写进去）
        包扇区数 = 32
    }
    视图_初始化()
    盘_准备好()
    fh 0
}

@ 盘准备好没有 —— 0 没盘 / 1 刚格式化 / 2 已经有格式 / 3 有东西但读不出来（拒绝动它）
@
@ ★ 以前这里是「读不到超级块就格式化」—— 瞬时读错或者盘被写坏，都会把已有对象
@   整盘清掉，而且一句话都不问（issue #287）。现在先分清是【空白盘】还是【坏了】。
hs 盘_准备好() -> u32 {
    rg 盘就绪吗() == 0 { 盘状态 = 0  fh 0 }
    rg 超级块读() == 1 { 盘状态 = 2  fh 0 }
    rg 盘_空盘吗() == 1 {
        盘格式化(16384)
        超级块读()
        盘状态 = 1
        fh 0
    }
    盘状态 = 3
    fh 0
}

@ 前两块扇区是不是全 0（= 从来没人格式化过）
@ 用来区分「空白盘」和「有东西但读不出来」—— 后者绝对不能格式化
hs 盘_空盘吗() -> u32 {
    kb i: u32 = 0
    dy i < 2 {
        rg 盘读扇区(i) == 0 { fh 0 }
        kb j: u32 = 0
        dy j < 512 {
            rg 盘缓冲[j] != 0 { fh 0 }
            j = j + 1
        }
        i = i + 1
    }
    fh 1
}

@ 把盘状态打到屏幕上（开史书的时候打）
hs 盘_报状态() -> u32 {
    rg 盘状态 == 0 {
        屏设色(0xF2A93B)
        屏串("[盘] 主通道没有 ATA 盘，只能看不能存")
        换行()
        fh 0
    }
    rg 盘状态 == 1 {
        屏设色(0x37C46A)
        屏串("[盘] 空白盘 —— 已建立混沌盘格式")
        换行()
        fh 0
    }
    rg 盘状态 == 3 {
        屏设色(0xE0554A)
        屏串("[盘] 有内容但读不出超级块 —— 没动它（怕把数据清了）")
        换行()
        屏串("     要真重来，得你自己说：格式化")
        换行()
        fh 0
    }
    屏设色(0x00BFA5)
    屏串("[盘] 读到已有格式 · 世代 ")
    屏数(盘世代)
    屏串(" · 对象 ")
    屏数(盘对象数)
    屏串(" 个")
    换行()
    fh 0
}