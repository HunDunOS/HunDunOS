@ ============================================================================
@  混沌 终端壳（壳.xy）—— 纯文本模式的命令行
@
@  它不是一个普通的 shell：它直接把【内核能力】端到你面前。
@     cun 内容        存对象（内容寻址）→ 打印哈希
@     qu 哈希         按哈希取回（哈希不对就取不出来）
@     lie             列出盘上所有对象
@     pan             盘状态（超级块字段）
@     shan 哈希       从视图里摘掉这个名字（对象还在）
@     bang            帮助
@     qing            清屏
@     guan            停机
@
@  存的还是【盘】不是内存 —— 关掉再开，东西还在。
@ ============================================================================

qj 行缓冲[136]: u32              @ 一行输入
qj 行长: u32
qj 词[136]: u32                  @ 命令 / 参数（按字节紧凑存放）
qj 词址: u32
qj 参址: u32

qj 取回[512]: u32                @ 与 盘格式.xy 共享
qj 取回址: u32

qj 盘缓冲[512]: u32              @ 与 盘.xy / 盘格式.xy 共享（.comm 合并成一份）

@ 盘格式的字段（在同一批全局里声明一次，链接器合并）
qj 盘版本: u32
qj 盘总扇区: u32
qj 盘索引起: u32
qj 盘索引数: u32
qj 盘对象起: u32
qj 盘追加: u32
qj 盘轴起: u32
qj 盘轴数: u32
qj 盘视图根: u32
qj 盘对象数: u32
qj 盘世代: u32

@ 机器模块的全局（.comm 合并）
qj 机器缓[256]: u32
qj 机器缓2[256]: u32
qj 机器缓址: u32
qj 机器缓2址: u32
qj 显卡厂商号: u32
qj 显卡设备号: u32
qj 显卡总线: u32


@ ============================================================================
@  帧缓冲控制台 —— 文本模式的 VGA 显示不了中文（一格 1 字节），
@  所以自己用字库往帧缓冲上画。这是终端能显示中文的唯一办法。
@ ============================================================================
qj 光x: u32
qj 光y: u32
qj 当前色: u32
qj 段缓[640]: u32
qj 段址: u32

hs 文宽2(s: u32) -> u32 {
    kb n: u32 = 0
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        rg c < 128 { n = n + 8 }
        rg c >= 128 { n = n + 16 }
        i = i + 1
    }
    fh n
}


hs 屏设色(c: u32) -> u32 {
    当前色 = c
    fh 0
}

@ fastfetch 那个路数：左边一块标志，右边一串 标签: 值
qj 标x: u32
qj 值x: u32
qj 行y: u32

hs 行进() -> u32 {
    行y = 行y + 22
    光y = 行y
    光x = 值x
    fh 0
}

hs 信息行(名: u32, 值: u32, 色: u32) -> u32 {
    光x = 值x
    光y = 行y
    屏设色(0x6E86A8)
    屏串(名)
    光x = 值x + 96
    屏设色(色)
    屏串(值)
    光x = 值x + 96
    行进()
    fh 0
}

@ ============================================================================
@  混沌的标志 —— 不用汉字，用【意象】
@    外圈疏（░）→ 中圈渐密（▒）→ 内圈实（▓█）
@    核心故意不圆：还没分化出形状 —— 这就是"混沌"
@  用的都是方块字符，跟"一切皆方块（对象）"也对得上
@ ============================================================================
qj 标志x: u32
qj 标志y: u32
qj 行高: u32

hs 标志行(串: u32, 色: u32) -> u32 {
    屏设色(色)
    光x = 标志x
    光y = 标志y
    屏串(串)
    标志y = 标志y + 行高
    fh 0
}

hs 机器标志() -> u32 {
    标志x = 30
    标志y = 56
    行高 = 22
    标志行("      ░░░░░", 0x2E4A6E)
    标志行("    ░▒▒▒▒▒▒▒░", 0x3A5C86)
    标志行("   ░▒▓▓▓▓▓▓▓▒░", 0x4C8DFF)
    标志行("  ░▒▓███████▓▒░", 0x6FA8FF)
    标志行("  ░▒▓█▒▒▒▒▒█▓▒░", 0x9AC4FF)
    标志行("  ░▒▓█▓███▒█▓▒░", 0xC8DEFF)   @ 核心偏在一侧，不圆
    标志行("  ░▒▓███████▓▒░", 0x6FA8FF)
    标志行("   ░▒▓▓▓▓▓▓▓▒░", 0x4C8DFF)
    标志行("    ░▒▒▒▒▒▒▒░", 0x3A5C86)
    标志行("      ░░░░░", 0x2E4A6E)
    fh 0
}

hs 屏清() -> u32 {
    绘块(0, 0, 屏宽(), 屏高(), 0x0A0E18)
    绘块(0, 0, 屏宽(), 3, 0x1E9E8A)
    光x = 14
    光y = 14
    fh 0
}

hs 屏换行() -> u32 {
    出(10)                       @ 串口镜像也换行，日志读得清
    光x = 14
    光y = 光y + 22
    rg 光y > 屏高() - 30 { 滚屏(22, 0x0A0E18)  光y = 光y - 22 }
    fh 0
}

hs 屏出(c: u32) -> u32 {
    rg c == 10 { 屏换行()  fh 0 }
    rg c >= 32 { 出(c) }         @ 串口镜像：数字也进日志
    rg c == 13 { fh 0 }
    rg c < 32 { fh 0 }
    rg c >= 128 { fh 0 }
    wx {
        ^(段址 + 0) = c
        ^(段址 + 1) = 0
    }
    绘字(光x, 光y, 段址, 当前色)
    光x = 光x + 8
    rg 光x > 屏宽() - 24 { 屏换行() }
    fh 0
}

hs 屏串(s: u32) -> u32 {
    印串(s)                      @ 同时镜像到串口，方便抓日志
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { fh 0 }
        kb j: u32 = 0
        xh {
            kb d: u32 = 0
            wx { d = ^(s + i + j) }
            rg d == 0 { tc }
            rg d == 10 { tc }
            wx { ^(段址 + j) = d }
            j = j + 1
        }
        wx { ^(段址 + j) = 0 }
        rg j > 0 {
            绘字(光x, 光y, 段址, 当前色)
            光x = 光x + 文宽2(段址)
        }
        i = i + j
        kb e: u32 = 0
        wx { e = ^(s + i) }
        rg e == 10 {
            屏换行()
            i = i + 1
        }
        rg e == 0 { fh 0 }
        rg 光x > 屏宽() - 24 { 屏换行() }
    }
    fh 0
}

hs 屏数(n: u32) -> u32 {
    kb 十: u32 = 0
    kb t: u32 = n
    xh {
        十 = 十 + 1
        t = t / 10
        rg t == 0 { tc }
    }
    kb i: u32 = 0
    kb 权: u32 = 1
    dy i < 十 - 1 {
        权 = 权 * 10
        i = i + 1
    }
    xh {
        屏出(48 + (n / 权) % 10)
        权 = 权 / 10
        rg 权 == 0 { tc }
    }
    fh 0
}

@ ---------------------------------------------------------------- 基础
hs 换行() -> u32 {
    屏换行()
    fh 0
}

hs 印串2(s: u32) -> u32 {
    屏串(s)
    fh 0
}

hs 串长2(s: u32) -> u32 {
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        i = i + 1
    }
    fh i
}

hs 串等2(a: u32, b: u32) -> u32 {
    kb i: u32 = 0
    xh {
        kb x: u32 = 0
        kb y: u32 = 0
        wx {
            x = ^(a + i)
            y = ^(b + i)
        }
        rg x != y { fh 0 }
        rg x == 0 { fh 1 }
        i = i + 1
    }
    fh 0
}

hs 串转数(s: u32) -> u32 {
    kb n: u32 = 0
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c < 48 { tc }
        rg c > 57 { tc }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    fh n
}

@ ---------------------------------------------------------------- 读一行
hs 读行() -> u32 {
    行长 = 0
    xh {
        kb k: u32 = 键()
        rg k == 0 {
            睡(8)
            jx
        }
        rg k == 13 { tc }                  @ 回车
        rg k == 8 {                        @ 退格
            rg 行长 > 0 {
                行长 = 行长 - 1
                行缓冲[行长] = 0
                屏出(8)
                屏出(32)
                屏出(8)
            }
            jx
        }
        rg k >= 32 {
            rg 行长 < 130 {
                行缓冲[行长] = k
                行长 = 行长 + 1
                屏出(k)                      @ 回显（走 _rt_putc，屏幕+串口都有）
            }
        }
    }
    行缓冲[行长] = 0
    换行()
    fh 行长
}

@ ---------------------------------------------------------------- 分词
@  命令放 词址+0，参数放 词址+64，都是按字节紧凑存的
hs 分词() -> u32 {
    kb i: u32 = 0
    kb n: u32 = 0
    xh {                                   @ 跳过前导空格
        rg 行缓冲[i] == 0 { tc }
        rg 行缓冲[i] != 32 { tc }
        i = i + 1
    }
    xh {                                   @ 取命令
        rg 行缓冲[i] == 0 { tc }
        rg 行缓冲[i] == 32 { tc }
        kb c: u32 = 行缓冲[i]
        wx { ^(词址 + n) = c }
        n = n + 1
        i = i + 1
    }
    wx { ^(词址 + n) = 0 }
    xh {                                   @ 跳过空格
        rg 行缓冲[i] == 0 { tc }
        rg 行缓冲[i] != 32 { tc }
        i = i + 1
    }
    kb j: u32 = 0
    xh {                                   @ 取参数
        rg 行缓冲[i] == 0 { tc }
        kb c2: u32 = 行缓冲[i]
        wx { ^(参址 + j) = c2 }
        j = j + 1
        i = i + 1
    }
    wx { ^(参址 + j) = 0 }
    fh 0
}

@ ---------------------------------------------------------------- 十个数字（十六进制打印哈希）
hs 打十六(v: u32) -> u32 {
    kb i: u32 = 0
    kb 起: u32 = 0
    xh {
        kb 移: u32 = (7 - i) * 4
        kb t: u32 = (v / (1 << 移)) % 16
        rg t < 10 { 屏出(48 + t) }
        rg t >= 10 { 屏出(87 + t) }
        i = i + 1
        rg i >= 8 { tc }
    }
    fh 0
}

@ ---------------------------------------------------------------- 列对象
hs 列对象() -> u32 {
    @ 索引区里逐项扫，非零就是有对象
    kb 扇: u32 = 0
    kb 数: u32 = 0
    dy 扇 < 16 {
        rg 盘读扇区(盘索引起 + 扇) == 0 { tc }
        kb j: u32 = 0
        dy j < 64 {
            kb off: u32 = j * 8
            kb h: u32 = 盘缓冲[off] + 盘缓冲[off+1]*256 + 盘缓冲[off+2]*65536 + 盘缓冲[off+3]*16777216
            rg h != 0 {
                kb lba: u32 = 盘缓冲[off+4] + 盘缓冲[off+5]*256 + 盘缓冲[off+6]*65536 + 盘缓冲[off+7]*16777216
                屏串("  ")
                打十六(h)
                屏串("   扇区 ")
                屏数(lba)
                屏串("   内容「")
                rg 盘取对象(h) > 0 { 屏串(取回址) }
                屏串("」")
                换行()
                数 = 数 + 1
                @ ★ 盘取对象 用的是同一个盘缓冲，刚把本索引扇区冲掉了 → 重读
                盘读扇区(盘索引起 + 扇)
            }
            j = j + 1
        }
        扇 = 扇 + 1
    }
    rg 数 == 0 { 屏串("  （盘上还没有对象）")  换行() }
    屏串("  共 ")
    屏数(数)
    屏串(" 个对象")
    换行()
    fh 数
}

@ ---------------------------------------------------------------- 帮助
hs 帮助() -> u32 {
    屏串("  混沌 HunDun — 内核能力终端")
    换行()
    屏串("  ------------------------------------------")
    换行()
    屏串("  xin         看这台机器的信息（真去问硬件）")
    换行()
    屏串("  cun 内容    存对象（内容寻址）→ 打印哈希")
    换行()
    屏串("  qu 哈希     按哈希取回")
    换行()
    屏串("  lie         列出盘上所有对象")
    换行()
    屏串("  pan         盘状态")
    换行()
    屏串("  shi         存一段中文示例")
    换行()
    屏串("  bang        这份帮助")
    换行()
    屏串("  qing        清屏")
    换行()
    屏串("  guan        停机")
    换行()
    换行()
    屏串("  提示：同样的内容存两次，哈希一样，盘上只占一份。")
    换行()
    屏串("        关掉再开，东西还在 —— 因为它在盘上。")
    换行()
    fh 0
}

@ ---------------------------------------------------------------- 执行
hs 执行() -> u32 {
    kb hh: u32 = 0        @ 一个函数一个作用域，重复 kb 会冲突
    rg 命令是("cun") == 1 {
        kb 长: u32 = 串长2(参址)
        rg 长 == 0 {
            屏串("  用法：cun 内容")
            换行()
            fh 0
        }
        hh = 盘存对象(参址)
        rg hh == 0 {
            屏串("  存失败")
            换行()
            fh 0
        }
        屏串("  已存 → 哈希 ")
        打十六(hh)
        屏串("   （")
        屏数(hh)
        屏串("）")
        换行()
        fh 0
    }
    rg 命令是("qu") == 1 {
        hh = 串转数(参址)
        rg 盘取对象(hh) == 0 {
            屏串("  取不到：盘上没有这个哈希")
            换行()
            fh 0
        }
        屏串("  「")
        屏串(取回址)
        屏串("」")
        换行()
        fh 0
    }
    rg 命令是("lie") == 1 {
        列对象()
        fh 0
    }
    rg 命令是("pan") == 1 {
        rg 超级块读() == 0 {
            屏串("  盘上没有格式")
            换行()
            fh 0
        }
        屏串("  格式版本 ")
        屏数(盘版本)
        屏串("   世代 ")
        屏数(盘世代)
        换行()
        屏串("  对象数 ")
        屏数(盘对象数)
        屏串("   追加指针 LBA ")
        屏数(盘追加)
        屏串("   索引起 LBA ")
        屏数(盘索引起)
        换行()
        fh 0
    }
    rg 命令是("shi") == 1 {
        kb a: u32 = 盘存对象("混沌")
        kb b: u32 = 盘存对象("一切皆哈希")
        kb c: u32 = 盘存对象("混沌")
        屏串("  存入「混沌」→ ")
        打十六(a)
        换行()
        屏串("  存入「一切皆哈希」→ ")
        打十六(b)
        换行()
        屏串("  再存一次「混沌」→ ")
        打十六(c)
        rg c == a {
            屏串("   （同一个哈希，盘上只占一份）")
        }
        换行()
        fh 0
    }
    rg 命令是("xin") == 1 {
        显示机器信息()
        fh 0
    }
    rg 命令是("bang") == 1 {
        帮助()
        fh 0
    }
    rg 命令是("qing") == 1 {
        屏清()
        fh 0
    }
    rg 命令是("guan") == 1 {
        屏串("  再见。")
        换行()
        停机()
        fh 0
    }
    屏串("  不认识的命令：")
    屏串(词址)
    换行()
    屏串("  输入 bang 看帮助")
    换行()
    fh 0
}


@ ============================================================================
@  xin —— 系统信息（fastfetch 那个路数，但每一项都是真去问硬件的）
@ ============================================================================
hs 显示机器信息() -> u32 {
    屏清()
    标x = 26
    值x = 240
    行y = 30
    机器标志()

    光x = 值x
    光y = 行y
    屏设色(0x37C46A)
    屏串("root@hundun")
    行进()
    屏设色(0x2A3A5C)
    光x = 值x
    屏串("-----------------------")
    行进()

    信息行("系统", "混沌 HunDun OS", 0x9AC4FF)
    信息行("内核", "自研引导器 xboot + 新语内核", 0x9AC4FF)
    信息行("语言", "新语（关键字全拼音，危险操作要 wx{}）", 0x9AC4FF)

    rg 机器_BIOS厂商(机器缓2址) > 0 { 信息行("固件", 机器缓2址, 0x8FA6C8) }

    @ CPU —— 真的执行 CPUID
    机器_CPU型号(机器缓址)
    机器_CPU厂商(机器缓2址)
    信息行("处理器", 机器缓址, 0x37C46A)
    光x = 值x + 96
    光y = 行y
    屏设色(0x5F7A9C)
    屏串(机器缓2址)
    屏串(" · ")
    kb 核: u32 = 机器_核数()
    rg 核 == 0 { 核 = 机器_CPU核数() }
    rg 核 == 0 { 核 = 1 }
    屏数(核)
    屏串(" 核")
    行进()

    @ 显卡 —— 真的扫 PCI
    机器_显卡名(机器缓址)
    信息行("显卡", 机器缓址, 0x9B5CF6)

    @ 内存
    机器清(机器缓址, 32)
    光x = 值x
    光y = 行y
    屏设色(0x6E86A8)
    屏串("内存")
    光x = 值x + 96
    屏设色(0x00BFA5)
    屏数(内存() / 1024)
    屏串(" MB")
    行进()

    @ 显示
    光x = 值x
    光y = 行y
    屏设色(0x6E86A8)
    屏串("显示")
    光x = 值x + 96
    屏设色(0x4C8DFF)
    屏数(屏宽())
    屏串(" x ")
    屏数(屏高())
    屏串(" x 32 位　帧缓冲 0x")
    打十六(帧址())
    行进()

    @ 盘
    rg 超级块读() == 1 {
        光x = 值x
        光y = 行y
        屏设色(0x6E86A8)
        屏串("盘")
        光x = 值x + 96
        屏设色(0xF2A93B)
        屏串("混沌盘 v")
        屏数(盘版本)
        屏串("　")
        屏数(盘总扇区 / 2048)
        屏串(" MB　")
        屏数(盘对象数)
        屏串(" 个对象")
        行进()
    }

    @ IP —— 老实说拿不到
    信息行("网络", "（还没有网络栈，所以没有 IP）", 0x7A5F5F)
    光x = 值x + 96
    光y = 行y
    屏设色(0xE0554A)

    光x = 值x + 96
    光y = 行y
    屏设色(0xE0554A)


    光x = 值x
    光y = 行y + 22
    屏设色(0x3A4A66)
    屏串("一切皆哈希 · 内容寻址 · 只追加")
    行进()
    行进()
    光x = 14
    光y = 行y
    fh 0
}

hs 命令是(s: u32) -> u32 {
    fh 串等2(词址, s)
}

@ ---------------------------------------------------------------- 入口
hs 终端主() -> u32 {
    wx {
        段址 = 地址(段缓)
        机器缓址 = 地址(机器缓)
        机器缓2址 = 地址(机器缓2)
        当前色 = 0xE8F0FF
        词址 = 地址(词)
        参址 = 地址(词) + 64
        取回址 = 地址(取回)
    }
    屏清()
    屏串("混沌 HunDun  ·  内核能力终端")
    换行()
    屏串("--------------------------------")
    换行()
    rg 盘就绪吗() == 0 {
        屏串("[盘] 主通道没有 ATA 盘，只能看不能存")
        换行()
    }
    rg 盘就绪吗() == 1 {
        rg 超级块读() == 0 {
            屏设色(0xF2A93B)
            屏串("[盘] 空白盘 —— 正在格式化…")
            换行()
            盘格式化(16384)
            屏设色(0x37C46A)
            屏串("[盘] 已建立混沌盘格式")
            换行()
        }
        rg 超级块读() == 1 {
            屏设色(0x00BFA5)
            屏串("[盘] 读到已有格式 · 世代 ")
            屏数(盘世代)
            屏串(" · 对象 ")
            屏数(盘对象数)
            屏串(" 个")
            换行()
        }
    }
    换行()
    屏串("输入 bang 看帮助。")
    换行()
    换行()
    xh {
        屏串("HD> ")
        读行()
        分词()
        执行()
    }
    fh 0
}
