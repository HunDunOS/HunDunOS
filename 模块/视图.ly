00 ============================================================
00 池位(i, j, off) → 槽号
00 ============================================================
tt 池位 01 i  j  off 02 -> u64  08
    zz 01 01 01 i ht 5 02 ht j 02 ht 20 02 ht off 02
 09

00 ============================================================
00 视图_存回(i)
00 ============================================================
tt 视图_存回 01 i 02 -> u64  08
    lz i 当前视图  08
        tz n = 映射数
        lh n 5  08
            n = 5
         09
        st 01 视图映射数 ht i 02 = n
     09
    zz 0
 09

00 ============================================================
00 视图_取名字(i)
00 ============================================================
tt 视图_取名字 01 i 02 -> u64  08
    tz k = 0
    ll  08
        lz k 16  08 ls  09
        tz c = 01 视图名 ht 01 i ht 16 ht k 02 02
        st 01 当前名址 ht k 02 = c
        k = k ht 1
     09
    st 01 当前名址 ht 16 02 = 0
    zz 0
 09

00 ============================================================
00 视图_载入(i)
00 ============================================================
tt 视图_载入 01 i 02 -> u64  08
    zt 视图_取名字 01 i 02
    tz n = 01 视图映射数 ht i 02
    lh n 5  08
        n = 5
     09
    tz j = 0
    ll  08
        lz j n  08 ls  09
        tz k = 0
        ll  08
            lz k 16  08 ls  09
            tz c = fh 01 池址 ht zt 池位 01 i  j  k 02 02
            st 01 名址 ht 01 j ht 16 ht k 02 02 = c
            k = k ht 1
         09
        st 01 名表 ht j 02 = 01 名址 ht 01 j ht 16 02 02
        tz h = fh 01 池址 ht zt 池位 01 i  j  16 02 02
        tz h1 = fh 01 池址 ht zt 池位 01 i  j  17 02 02
        tz h2 = fh 01 池址 ht zt 池位 01 i  j  18 02 02
        tz h3 = fh 01 池址 ht zt 池位 01 i  j  19 02 02
        st 01 名指 ht j 02 = 01 01 h ht h1 ht 256 02 ht 01 h2 ht 65536 02 ht 01 h3 ht 16777216 02 02
        j = j ht 1
     09
    映射数 = n
    zz 0
 09

00 ============================================================
00 视图_切换(i)
00 ============================================================
tt 视图_切换 01 i 02 -> u64  08
    lh i 视图数  08
        zz 0
     09
    lz i 当前视图  08
        zz 1
     09
    zt 视图_存回 01 当前视图 02
    zt 视图_载入 01 i 02
    当前视图 = i
