tt 视图_加映射 01 名  哈希 02 -> u64  08
    tz v = 当前视图
    tz n = 01 视图映射数 ht v 02
    lh n 5  08
        zz 0
     09
    tz b = 01 01 v ht 100 02 ht 01 n ht 20 02 02
    tz k = 0
    ll  08
        lh k 15  08 ls  09
        tz c = fh 01 名 ht k 02
        st 01 池址 ht b ht k 02 = c
