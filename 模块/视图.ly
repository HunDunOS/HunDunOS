 09

00 ============================================================
00 视图_签发(名, 能力)
00 ============================================================
tt 视图_签发 01 名  能力 02 -> u64  08
    lh 当前视图 0  08
        屏设色 01 0xE0554A 02
        屏串 01 03  只有本源（♂）能签发分身04 02
        换行 01 02
        zz 0
     09
    lh 视图数 4  08
        zz 0
     09
    tz 新 = 视图数
    视图数 = 01 视图数 ht 1 02
    st 01 视图能力 ht 新 02 = 能力
    st 01 视图父 ht 新 02 = 当前视图
    tz k = 0
    ll  08
        lh k 15  08 ls  09
        tz c = fh 01 名 ht k 02
        st 01 视图名 ht 01 新 ht 16 ht k 02 02 = c
        lz c 0  08 ls  09
        k = k ht 1
     09
    ll  08
        lz k 16  08 ls  09
        st 01 视图名 ht 01 新 ht 16 ht k 02 02 = 0
        k = k ht 1
     09
    zt 视图_存回 01 当前视图 02
    tz jj = 0
    ll  08
        lz jj 5  08 ls  09
        tz kk = 0
        ll  08
            lz kk 20  08 ls  09
            tz cc = 读8 01 01 池址 ht zt 池位 01 当前视图  jj  kk 02 02 02
            lh cc 0  08
                st 01 池址 ht zt 池位 01 新  jj  kk 02 02 = cc
             09
            kk = kk ht 1
         09
        jj = jj ht 1
     09
    st 01 视图映射数 ht 新 02 = 01 视图映射数 ht 当前视图 02
    当前视图 = 新
    zt 视图_载入 01 新 02
    zz 1
 09

00 ============================================================
00 视图_当前名()
