tt 视图_当前名 01 02 -> u64  08
    zz 当前名址
 09

00 ============================================================
00 视图_存盘()
00 ============================================================
tt 视图_存盘 01 02 -> u64  08
    lz zt 盘就绪吗 01 02 0  08
        zz 0
     09
    tz i = 0
    ll  08
        lz i 512  08 ls  09
        st 01 盘缓冲 ht i 02 = 0
        i = i ht 1
     09
    st 01 盘缓冲 ht 0 02 = 01 视图数 % 256 02
    st 01 盘缓冲 ht 1 02 = 01 当前视图 % 256 02
    i = 0
    ll  08
        lz i 4  08 ls  09
        tz k = 0
        ll  08
            lz k 16  08 ls  09
            st 01 盘缓冲 ht 01 16 ht i ht 20 ht k 02 02 = 01 视图名 ht 01 i ht 16 ht k 02 02
            k = k ht 1
         09
        st 01 盘缓冲 ht 01 16 ht i ht 20 ht 16 02 02 = 01 视图能力 ht i 02 % 256 02
        st 01 盘缓冲 ht 01 16 ht i ht 20 ht 17 02 02 = 01 01 视图能力 ht i 02 / 256 02 % 256 02
        st 01 盘缓冲 ht 01 16 ht i ht 20 ht 18 02 02 = 01 视图映射数 ht i 02
        st 01 盘缓冲 ht 01 16 ht i ht 20 ht 19 02 02 = 01 视图父 ht i 02
        i = i ht 1
     09
    lz zt 盘写扇区 01 2 02 0  08
        zz 0
     09
    i = 0
    ll  08
        lz i 400  08 ls  09
        st 01 盘缓冲 ht i 02 = 读8 01 01 池址 ht i 02 02
        i = i ht 1
     09
    zt 盘写扇区 01 3 02
    zz 1
 09

00 ============================================================
00 视图_读盘()
00 ============================================================
tt 视图_读盘 01 02 -> u64  08
    lz zt 盘就绪吗 01 02 0  08
        zz 0
     09
    lz zt 盘读扇区 01 2 02 0  08
        zz 0
     09
    lz 01 盘缓冲 ht 0 02 0  08
        zz 0
     09
    视图数 = 01 盘缓冲 ht 0 02
    lh 视图数 4  08
        视图数 = 4
     09
    当前视图 = 01 盘缓冲 ht 1 02
    lh 当前视图 视图数  08
        当前视图 = 0
     09
    tz i = 0
    ll  08
        lz i 4  08 ls  09
        tz k = 0
        ll  08
            lz k 16  08 ls  09
            st 01 视图名 ht 01 i ht 16 ht k 02 02 = 01 盘缓冲 ht 01 16 ht i ht 20 ht k 02 02
            k = k ht 1
         09
        st 01 视图能力 ht i 02 = 01 01 盘缓冲 ht 01 16 ht i ht 20 ht 16 02 02 ht 01 盘缓冲 ht 01 16 ht i ht 20 ht 17 02 ht 256 02 02
        st 01 视图映射数 ht i 02 = 01 盘缓冲 ht 01 16 ht i ht 20 ht 18 02 02
        st 01 视图父 ht i 02 = 01 盘缓冲 ht 01 16 ht i ht 20 ht 19 02 02
        i = i ht 1
     09
    zt 盘读扇区 01 3 02
    i = 0
    ll  08
        lz i 400  08 ls  09
        st 01 池址 ht i 02 = 01 盘缓冲 ht i 02
        i = i ht 1
     09
    zt 视图_载入 01 当前视图 02
    zz 1
 09

00 ============================================================
00 视图_初始化()
00 ============================================================
tt 视图_初始化 01 02 -> u64  08
    当前名址 = 地址 01 当前名缓 02
    名址 = 地址 01 名区 02
    池址 = 地址 01 视图池 02
    st 01 视图名 ht 0 02 = 104
    st 01 视图名 ht 1 02 = 117
    st 01 视图名 ht 2 02 = 110
    st 01 视图名 ht 3 02 = 100
    st 01 视图名 ht 4 02 = 117
    st 01 视图名 ht 5 02 = 110
    tz i = 6
    ll  08
        lz i 16  08 ls  09
        st 01 视图名 ht i 02 = 0
        i = i ht 1
     09
    st 01 视图能力 ht 0 02 = 31
    st 01 视图父 ht 0 02 = 0xFFFFFFFF
    st 01 视图映射数 ht 0 02 = 0
    视图数 = 1
    当前视图 = 0
    zt 视图_取名字 01 0 02
    zz 0
 09

