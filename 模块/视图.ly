     09
    ll  08
        lz k 16  08 ls  09
        st 01 池址 ht b ht k 02 = 0
        k = k ht 1
     09
    st 01 池址 ht b ht 16 02 = 01 哈希 wy 255 02
    st 01 池址 ht b ht 17 02 = 01 01 01 哈希 / 256 02 wy 255 02 02
    st 01 池址 ht b ht 18 02 = 01 01 01 哈希 / 65536 02 wy 255 02 02
    st 01 池址 ht b ht 19 02 = 01 01 01 哈希 / 16777216 02 wy 255 02 02
    st 01 视图映射数 ht v 02 = 01 n ht 1 02
