@ ============================================================================
@  混沌桌面 ChaosDesk —— 全部用新语写
@    xboot(自研引导器) → VBE 800x600x32 → 新语内核 → 这个桌面
@
@  「混沌UI」部分是把 microui (https://github.com/rxi/microui, MIT) 的
@   架构翻译成新语：容器栈 / 布局游标 / 热-活动控件 / 裁剪 / 立即模式。
@   没搬它的代码。新语没有结构体指针、函数指针和堆，所以：
@     · microui 用 mu_Container* 传容器  → 这里用数组下标
@     · microui 用函数指针量文字宽高      → 这里直接自己量
@     · microui 有延迟绘制命令队列        → 这里直接画
@   图形底层（帧缓冲/字库/鼠标/键盘/时钟）是自研的，见 图形.asm
@ ============================================================================

@ ---------------------------- 结构 ----------------------------
jg 矩形 { x: u32  y: u32  w: u32  h: u32 }

jg 容器 {
    x: u32  y: u32  w: u32  h: u32
    cx: u32 cy: u32 cw: u32 ch: u32
    游标x: u32  游标y: u32
    行高: u32   间隙: u32
}

@ ---------------------------- 状态 ----------------------------
qj 容器[8]: 容器
qj 容器数: u32
qj 徽标[8]: u32

qj 当x: u32
qj 当y: u32
qj 当w: u32
qj 当h: u32

qj 鼠标x: u32
qj 鼠标y: u32
qj 鼠标键: u32
qj 键已按: u32
qj 新点击: u32
qj 热控件: u32
qj 活动控件: u32
qj 控件号: u32

qj 备份[484]: u32
qj 旧鼠标x: u32
qj 旧鼠标y: u32
qj 首帧: u32
qj 需要重绘: u32
qj 旧秒: u32

qj 窗口x: u32
qj 窗口y: u32
qj 窗口宽: u32
qj 窗口高: u32
qj 拖动中: u32
qj 拖动偏x: u32
qj 拖动偏y: u32
qj 窗: u32

qj 算显: u32
qj 算存: u32
qj 算运: u32
qj 算输: u32

qj 画色: u32
qj 笔画中: u32
qj 笔旧x: u32
qj 笔旧y: u32

qj 开机刻: u32
qj 时钟秒: u32

qj 只算: u32                 @ 1 = 这一趟只算不画（跑输入）
qj 控件表[400]: u32        @ 每项：号, x, y, 宽, 高
qj 控件数: u32

qj 勾选甲: u32
qj 勾选乙: u32
qj 滑条值: u32

@ 终端（壳.xy）用的一套，桌面里嵌它
qj 光x: u32
qj 光y: u32
qj 区x: u32
qj 区y: u32
qj 区宽: u32
qj 区高: u32
qj 光位: u32
qj 行首y: u32
qj 行长: u32
qj 行缓冲[136]: u32
qj 终端已开: u32
qj 盘缓冲[512]: u32
qj 盘版本: u32
qj 盘总扇区: u32
qj 盘索引起: u32
qj 盘索引数: u32
qj 盘对象起: u32
qj 盘追加: u32
qj 盘轴起: u32
qj 盘轴数: u32
qj 盘视图根: u32
qj 盘对象数: u32
qj 盘世代: u32
qj 取回[512]: u32
qj 取回址: u32

@ ============================================================================
@  【内核层】对象区 —— 「一切皆哈希」
@
@  这是系统底座，不是应用。全场唯一共享的状态就在这里。
@  因为只有它在内核层，去重/完整性/历史才是【全局】的：
@     桌面存了「混沌」，计算器再存一遍 → 同一个哈希 → 不占第二份
@
@  接口（内核原语，每个执行体都继承）：
@     存(内容) → 引用        算哈希 → 查重 → 没有才追加
@     取(引用) → 内容        引用不对就取不出来（完整性白送）
@     映射(名, 引用)         造新映射对象，旧映射一个字节不动
@     视图(映射引用)         原子换一个视图根（公理 7）
@     撤销(引用)             轴上追加墓碑，对象本身不动
@
@  当前实现约束：新语还没有"模块"，所以这段只能躺在同一个文件里。
@  等编译器补上模块（自举四缺之一），它就该单独成一个内核文件。
@ ============================================================================

qj 对象哈希[16]: u32        @ 身份 = 内容哈希
qj 对象串[16]: u32          @ 内容（字符串指针）
qj 对象长[16]: u32
qj 对象数: u32

qj 名表[16]: u32            @ 映射：名字
qj 名指[16]: u32            @       指向的对象下标
qj 映射数: u32

qj 史名[128]: u32        @ 视图历史（换回去用）
qj 史指[128]: u32
qj 史映射数[8]: u32
qj 史数: u32

qj 轴[8]: u32               @ 轴：只增不减的操作记录
qj 轴数: u32

qj 高亮对象: u32

@ ---- 内核原语 ----
hs 串长(s: *u8) -> u32 {
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        i = i + 1
    }
    fh i
}

hs 串等(a: u32, b: u32) -> u32 {
    kb j: u32 = 0
    xh {
        kb ca: u32 = 0
        kb cb: u32 = 0
        wx {
            ca = ^(a + j)
            cb = ^(b + j)
        }
        rg ca != cb { fh 0 }
        rg ca == 0 { fh 1 }
        j = j + 1
    }
    fh 0
}

hs 摘要(s: *u8) -> u32 {          @ FNV-1a 32 位：名字就是它
    kb h: u32 = 2166136261
    kb i: u32 = 0
    kb c: u32 = 0
    xh {
        c = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        h = h yh c
        h = h * 16777619
        i = i + 1
    }
    fh h
}

hs 记轴(s: u32) -> u32 {
    kb i: u32 = 7
    dy i > 0 {
        轴[i] = 轴[i - 1]
        i = i - 1
    }
    轴[0] = s
    rg 轴数 < 8 { 轴数 = 轴数 + 1 }
    fh 0
}

hs 找对象(h: u32) -> u32 {
    kb i: u32 = 0
    dy i < 对象数 {
        rg 对象哈希[i] == h { fh i }
        i = i + 1
    }
    fh 0xFFFFFFFF
}

hs 存对象(s: *u8) -> u32 {
    kb h: u32 = 摘要(s)
    kb k: u32 = 找对象(h)
    rg k != 0xFFFFFFFF {
        高亮对象 = k
        记轴("哈希已存在 → 复用，未占新空间")
        fh k
    }
    kb i: u32 = 对象数
    rg i >= 16 { fh 0xFFFFFFFF }
    对象哈希[i] = h
    对象串[i] = s
    对象长[i] = 串长(s)
    对象数 = 对象数 + 1
    高亮对象 = i
    记轴("追加新对象（只追加，永不原地改）")
    fh i
}

hs 找名字(名: u32) -> u32 {
    kb i: u32 = 0
    dy i < 映射数 {
        rg 串等(名表[i], 名) == 1 { fh i }
        i = i + 1
    }
    fh 0xFFFFFFFF
}

hs 加名(名: u32, 对象: u32) -> u32 {       @ 映射(名, 引用)
    kb i: u32 = 找名字(名)
    rg i != 0xFFFFFFFF {
        名指[i] = 对象
        fh 0
    }
    rg 映射数 >= 16 { fh 0 }
    名表[映射数] = 名
    名指[映射数] = 对象
    映射数 = 映射数 + 1
    fh 0
}

hs 删名(名: u32) -> u32 {                  @ 撤销
    kb i: u32 = 找名字(名)
    rg i == 0xFFFFFFFF { fh 0 }
    kb j: u32 = i
    dy j < 映射数 - 1 {
        名表[j] = 名表[j + 1]
        名指[j] = 名指[j + 1]
        j = j + 1
    }
    映射数 = 映射数 - 1
    fh 0
}

hs 改名(旧: u32, 新: u32) -> u32 {
    kb i: u32 = 找名字(旧)
    rg i == 0xFFFFFFFF { fh 0 }
    kb k: u32 = 找名字(新)
    rg k != 0xFFFFFFFF {
        名指[k] = 名指[i]
        删名(旧)
        fh 0
    }
    名表[i] = 新
    fh 0
}

hs 存视图() -> u32 {                       @ 换视图前留一份，用于"换回去"
    rg 史数 >= 8 { fh 0 }
    kb i: u32 = 0
    dy i < 映射数 {
        史名[史数 * 16 + i] = 名表[i]
        史指[史数 * 16 + i] = 名指[i]
        i = i + 1
    }
    史映射数[史数] = 映射数
    史数 = 史数 + 1
    fh 0
}

hs 恢复视图() -> u32 {                     @ 原子换回上一个视图
    rg 史数 == 0 { fh 0 }
    史数 = 史数 - 1
    kb i: u32 = 0
    dy i < 史映射数[史数] {
        名表[i] = 史名[史数 * 16 + i]
        名指[i] = 史指[史数 * 16 + i]
        i = i + 1
    }
    映射数 = 史映射数[史数]
    记轴("视图根引用已原子切换（无 undo 日志）")
    fh 0
}

hs 对象区自检() -> u32 {
    kb a: u32 = 存对象("混沌")
    kb b: u32 = 存对象("混沌")
    rg a == b { fh 1 }
    fh 0
}

@ ============================================================================
@  一、几何与文字度量
@ ============================================================================
hs 点判定(mx: u32, my: u32, x: u32, y: u32, w: u32, h: u32) -> u32 {
    rg mx >= x {
        rg mx < x + w {
            rg my >= y {
                rg my < y + h { fh 1 }
            }
        }
    }
    fh 0
}

hs 根(n: u32) -> u32 {
    kb i: u32 = 0
    xh {
        rg i * i > n { fh i - 1 }
        i = i + 1
        rg i > 2000 { fh 2000 }
    }
    fh 0
}

@ 量文字宽度：ASCII 8 像素，其它（UTF-8 多字节）16 像素
hs 文宽(s: *u8) -> u32 {
    kb n: u32 = 0
    kb i: u32 = 0
    xh {
        wx {
            kb c: u8 = ^(s + i)
            rg c == 0 { tc }
            rg c < 128 { n = n + 8 }
            rg c >= 128 { n = n + 16 }
        }
        i = i + 1
    }
    fh n
}

@ ============================================================================
@  二、绘图基元
@ ============================================================================
hs 圆角内缩(i: u32, 高: u32) -> u32 {
    kb a: u32 = 0
    kb b: u32 = 0
    rg i < 8 { a = 徽标[i] }
    kb j: u32 = 高 - 1 - i
    rg j < 8 { b = 徽标[j] }
    rg b > a { fh b }
    fh a
}

hs 圆角块(x: u32, y: u32, w: u32, h: u32, c: u32) -> u32 {
    kb i: u32 = 0
    dy i < h {
        kb ins: u32 = 圆角内缩(i, h)
        画块(x + ins, y + i, w - ins - ins, 1, c)
        i = i + 1
    }
    fh 0
}

hs 圆角块混(x: u32, y: u32, w: u32, h: u32, c: u32, a: u32) -> u32 {
    kb i: u32 = 0
    dy i < h {
        kb ins: u32 = 圆角内缩(i, h)
        画块混(x + ins, y + i, w - ins - ins, 1, c, a)
        i = i + 1
    }
    fh 0
}

hs 圆角框(x: u32, y: u32, w: u32, h: u32, c: u32) -> u32 {
    kb i: u32 = 0
    dy i < h {
        kb ins: u32 = 圆角内缩(i, h)
        画块(x + ins, y + i, 1, 1, c)
        画块(x + w - 1 - ins, y + i, 1, 1, c)
        rg i == 0 { 画块(x + ins, y, w - ins - ins, 1, c) }
        rg i == h - 1 { 画块(x + ins, y + h - 1, w - ins - ins, 1, c) }
        i = i + 1
    }
    fh 0
}

hs 阴影(x: u32, y: u32, w: u32, h: u32) -> u32 {
    kb k: u32 = 7
    dy k > 0 {
        圆角块混(x - k, y + k, w + k + k, h + k, 0x000000, 9)
        k = k - 1
    }
    fh 0
}

hs 光斑(cx: u32, cy: u32, r: u32, c: u32, a: u32) -> u32 {
    kb row: u32 = 0
    dy row < r {
        kb d: u32 = r - row
        kb s: u32 = 根(r * r - d * d)
        kb w: u32 = r - s
        画块混(cx - w, cy - row - 1, w + w, 1, c, a)
        画块混(cx - w, cy + row, w + w, 1, c, a)
        row = row + 1
    }
    fh 0
}

hs 直线(x0: u32, y0: u32, x1: u32, y1: u32, c: u32) -> u32 {
    kb px: u32 = x0
    kb py: u32 = y0
    kb gx: u32 = 0
    kb gy: u32 = 0
    kb sx: u32 = 1
    kb sy: u32 = 1
    rg x0 < x1 { gx = x1 - x0 }
    rg x0 >= x1 { gx = x0 - x1  sx = 0xFFFFFFFF }
    rg y0 < y1 { gy = y1 - y0 }
    rg y0 >= y1 { gy = y0 - y1  sy = 0xFFFFFFFF }
    kb err: u32 = gx
    xh {
        画块(px, py, 2, 2, c)
        rg px == x1 {
            rg py == y1 { fh 0 }
        }
        kb e2: u32 = err + err
        rg e2 > gy { err = err - gy  px = px + sx }
        rg e2 < gx { err = err + gx  py = py + sy }
    }
    fh 0
}

@ ============================================================================
@  三、界面核心（对应 microui 的 begin/end + containers）
@ ============================================================================
hs 界面开始() -> u32 {
    容器数 = 0
    热控件 = 0
    控件号 = 0
    鼠标x = 鼠x()
    鼠标y = 鼠y()
    鼠标键 = 鼠钮()
    新点击 = 0
    rg 鼠标键 == 1 {
        rg 键已按 == 0 { 新点击 = 1 }
    }
    fh 0
}

hs 界面结束() -> u32 {
    rg 活动控件 > 0 {
        rg 鼠标键 == 0 { 活动控件 = 0 }
    }
    键已按 = 鼠标键
    新点击 = 0
    fh 0
}

hs 当前() -> u32 {
    rg 容器数 == 0 { fh 0 }
    fh 容器数 - 1
}

@ ============================================================================
@  四、布局
@ ============================================================================
hs 布局行(高: u32) -> u32 {
    kb i: u32 = 当前()
    容器[i].游标x = 0
    容器[i].游标y = 容器[i].游标y + 容器[i].行高
    容器[i].行高 = 高
    fh 0
}

hs 间隔(px: u32) -> u32 {
    kb i: u32 = 当前()
    容器[i].游标x = 容器[i].游标x + px
    fh 0
}

hs 控位(w: u32, h: u32) -> u32 {
    kb i: u32 = 当前()
    当x = 容器[i].cx + 容器[i].游标x
    当y = 容器[i].cy + 容器[i].游标y
    当w = w
    当h = h
    容器[i].游标x = 容器[i].游标x + w + 容器[i].间隙
    fh 0
}

hs 控位满(h: u32) -> u32 {
    kb i: u32 = 当前()
    kb w: u32 = 容器[i].cw - 容器[i].游标x
    控位(w, h)
    fh 0
}


@ ── 画图包装：只算 == 1 时直接返回（跑输入趟用）──────────────────
hs 画块(x: u32, y: u32, w: u32, h: u32, c: u32) -> u32 {
    rg 只算 == 1 { fh 0 }
    绘块(x, y, w, h, c)
    fh 0
}
hs 画框(x: u32, y: u32, w: u32, h: u32, c: u32) -> u32 {
    rg 只算 == 1 { fh 0 }
    绘框(x, y, w, h, c)
    fh 0
}
hs 画字(x: u32, y: u32, s: u32, c: u32) -> u32 {
    rg 只算 == 1 { fh 0 }
    fh 绘字(x, y, s, c)
}
hs 画数(x: u32, y: u32, n: u32, c: u32) -> u32 {
    rg 只算 == 1 { fh 0 }
    绘数(x, y, n, c)
    fh 0
}
hs 画块混(x: u32, y: u32, w: u32, h: u32, c: u32, a: u32) -> u32 {
    rg 只算 == 1 { fh 0 }
    绘块混(x, y, w, h, c, a)
    fh 0
}

@ ── 控件位置表：画的时候记下来；命中判定查它 ──────────────────
hs 记控件(号: u32, x: u32, y: u32, w: u32, h: u32) -> u32 {
    kb i: u32 = 0
    dy i < 控件数 {
        kb b: u32 = i * 5
        rg 控件表[b] == 号 {
            控件表[b + 1] = x
            控件表[b + 2] = y
            控件表[b + 3] = w
            控件表[b + 4] = h
            fh 0
        }
        i = i + 1
    }
    rg 控件数 >= 80 { fh 0 }
    kb c: u32 = 控件数 * 5
    控件表[c] = 号
    控件表[c + 1] = x
    控件表[c + 2] = y
    控件表[c + 3] = w
    控件表[c + 4] = h
    控件数 = 控件数 + 1
    fh 0
}

hs 控件在(号: u32) -> u32 {
    kb i: u32 = 0
    dy i < 控件数 {
        kb b: u32 = i * 5
        rg 控件表[b] == 号 {
            fh 点判定(鼠标x, 鼠标y, 控件表[b + 1], 控件表[b + 2], 控件表[b + 3], 控件表[b + 4])
        }
        i = i + 1
    }
    fh 0
}

hs 命中(号: u32) -> u32 {
    fh 控件在(号)
}

hs 新号() -> u32 {
    控件号 = 控件号 + 1
    fh 控件号
}

@ microui 的热/活动语义：返回 0 无 1 按住 2 点击完成
hs 进控件(号: u32) -> u32 {
    kb 在: u32 = 命中(号)
    rg 在 == 1 { 热控件 = 号 }
    rg 活动控件 == 号 {
        rg 鼠标键 == 0 {
            rg 在 == 1 { fh 2 }
        }
        fh 1
    }
    rg 在 == 1 {
        rg 新点击 == 1 {
            活动控件 = 号
            fh 1
        }
    }
    fh 0
}

@ ============================================================================
@  五、控件
@ ============================================================================
hs 文字(x: u32, y: u32, s: u32, c: u32) -> u32 {
    画字(x, y, s, c)
    fh 0
}

hs 按钮(标: u32, 宽: u32, 高: u32, 底: u32) -> u32 {
    kb 号: u32 = 新号()
    控位(宽, 高)
    记控件(号, 当x, 当y, 当w, 当h)
    kb 态: u32 = 进控件(号)
    kb 色: u32 = 底
    rg 态 == 1 { 色 = 底 + 0x141C28 }
    rg 热控件 == 号 { 色 = 底 + 0x0A1018 }
    圆角块(当x, 当y, 当w, 当h, 色)
    kb tw: u32 = 文宽(标)
    kb dx: u32 = 0
    rg 当w > tw { dx = (当w - tw) / 2 }
    画字(当x + dx, 当y + (当h - 16) / 2, 标, 0xFFFFFF)
    rg 态 == 2 { fh 1 }
    fh 0
}

hs 复选框(标: u32, 选中: u32) -> u32 {
    kb 号: u32 = 新号()
    控位满(24)
    kb 态: u32 = 进控件(号)
    圆角块(当x, 当y + 3, 18, 18, 0x26334E)
    rg 选中 == 1 { 圆角块(当x + 3, 当y + 6, 12, 12, 0x4C8DFF) }
    画字(当x + 28, 当y + 4, 标, 0xAEC3E0)
    rg 态 == 2 {
        rg 选中 == 1 { fh 0 }
        fh 1
    }
    fh 选中
}

hs 滑块(值: u32, 最大: u32, 标: u32) -> u32 {
    kb v: u32 = 值
    kb 号: u32 = 新号()
    kb i: u32 = 当前()
    控位(容器[i].cw - 70, 24)
    记控件(号, 当x, 当y, 当w, 当h)
    kb 态: u32 = 进控件(号)
    rg 态 == 1 {
        kb n: u32 = (鼠标x - 当x) * 最大 / 当w
        rg n > 最大 { n = 最大 }
        v = n
    }
    圆角块(当x, 当y + 9, 当w, 6, 0x1B2740)
    kb w2: u32 = v * 当w / 最大
    rg w2 > 6 { 圆角块(当x, 当y + 9, w2, 6, 0x4C8DFF) }
    画块(当x + w2 - 3, 当y + 5, 6, 14, 0xFFFFFF)
    画字(当x + 当w + 10, 当y + 4, 标, 0x8FA6C8)
    画数(当x + 当w + 10 + 文宽(标) + 8, 当y + 4, v, 0xFFFFFF)
    fh v
}

@ ============================================================================
@  六、面板（窗口）
@ ============================================================================
hs 面板开始(x: u32, y: u32, w: u32, h: u32, 标: u32, 画阴: u32) -> u32 {
    kb i: u32 = 容器数
    容器[i].x = x
    容器[i].y = y
    容器[i].w = w
    容器[i].h = h
    容器[i].cx = x + 16
    容器[i].cy = y + 46
    容器[i].cw = w - 32
    容器[i].ch = h - 60
    容器[i].游标x = 0
    容器[i].游标y = 0
    容器[i].行高 = 0
    容器[i].间隙 = 0            @ 间距由 间隔() 显式给，控位不再自带
    容器数 = 容器数 + 1

    rg 画阴 == 1 { 阴影(x, y, w, h) }
    圆角块(x, y, w, h, 0x121A2E)
    圆角块(x + 1, y + 1, w - 2, 34, 0x1B2740)
    圆角框(x, y, w, h, 0x33456E)

    画块(x + 14, y + 15, 4, 12, 0x4C8DFF)
    画块(x + 20, y + 19, 4, 8, 0x6FA8FF)
    画块(x + 26, y + 23, 4, 4, 0x9AC4FF)
    画字(x + 40, y + 12, 标, 0xFFFFFF)

    @ 关闭按钮
    kb 结号: u32 = 新号()
    当x = x + w - 36
    当y = y + 8
    当w = 26
    当h = 26
    kb 结态: u32 = 进控件(结号)
    rg 结态 > 0 { 圆角块(当x, 当y, 26, 26, 0xE0554A) }
    kb 啊: u32 = 0
    dy 啊 < 11 {
        画块(当x + 8 + 啊, 当y + 8 + 啊, 2, 2, 0xFFFFFF)
        画块(当x + 16 - 啊, 当y + 8 + 啊, 2, 2, 0xFFFFFF)
        啊 = 啊 + 1
    }
    rg 结态 == 2 { fh 1 }
    fh 0
}

hs 面板结束() -> u32 {
    rg 容器数 > 0 { 容器数 = 容器数 - 1 }
    fh 0
}

@ ============================================================================
@  七、壁纸 / 顶栏 / 坞 / 光标
@ ============================================================================
hs 画壁纸() -> u32 {
    kb y: u32 = 0
    kb 高: u32 = 屏高()
    kb 宽: u32 = 屏宽()
    dy y < 高 {
        kb t: u32 = y * 100 / 高
        画块(0, y, 宽, 1, (18 + t / 4) * 65536 + (30 + t / 3) * 256 + (58 + t / 2))
        y = y + 1
    }
    光斑(屏宽() / 6, 屏高() / 5, 屏高() / 4, 0x3A6BFF, 40)
    光斑(屏宽() * 5 / 6, 屏高() * 4 / 5, 屏高() / 3, 0x8A4CFF, 32)
    光斑(屏宽() / 2, 屏高() / 2, 屏高() / 5, 0x1FB6FF, 18)
    光斑(屏宽() / 3, 屏高() * 9 / 10, 屏高() / 4, 0x00C2A8, 16)
    fh 0
}

hs 两位(n: u32, x: u32, y: u32, c: u32) -> u32 {
    rg n < 10 {
        画字(x, y, "0", c)
        画数(x + 8, y, n, c)
        fh 0
    }
    画数(x, y, n, c)
    fh 0
}

hs 画顶栏() -> u32 {
    圆角块(8, 6, 屏宽() - 16, 30, 0x111A2E)
    画块(24, 15, 4, 12, 0x4C8DFF)
    画块(30, 19, 4, 8, 0x6FA8FF)
    画块(36, 23, 4, 4, 0x9AC4FF)
    画字(48, 12, "混沌 OS", 0xFFFFFF)
    画字(132, 12, "自研引导器 · 新语内核 · 混沌UI", 0x6E86A8)
    kb h: u32 = 时()
    kb m: u32 = 分()
    kb 钟x: u32 = 屏宽() - 168
    两位(h, 钟x, 12, 0xFFFFFF)
    画字(钟x + 16, 12, ":", 0x9FB4D0)
    两位(m, 钟x + 24, 12, 0xFFFFFF)
    画字(钟x + 40, 12, ":", 0x9FB4D0)
    两位(时钟秒, 钟x + 48, 12, 0x9FB4D0)
    fh 0
}

hs 画图标(kind: u32, x: u32, y: u32, s: u32, c: u32) -> u32 {
    kb u: u32 = s / 16
    rg u < 1 { u = 1 }
    rg kind == 1 {
        画块(x + 7 * u, y + 2 * u, 2 * u, 2 * u, c)
        画块(x + 6 * u, y + 4 * u, 4 * u, 2 * u, c)
        画块(x + 5 * u, y + 6 * u, 2 * u, 2 * u, c)
        画块(x + 9 * u, y + 6 * u, 2 * u, 2 * u, c)
        画块(x + 4 * u, y + 8 * u, 2 * u, 6 * u, c)
        画块(x + 10 * u, y + 8 * u, 2 * u, 6 * u, c)
        画块(x + 6 * u, y + 10 * u, 4 * u, 2 * u, c)
        画块(x + 7 * u, y + 12 * u, 2 * u, 2 * u, c)
        fh 0
    }
    rg kind == 2 {
        画块(x + 2 * u, y + 1 * u, 12 * u, 14 * u, c)
        画块(x + 4 * u, y + 3 * u, 8 * u, 3 * u, 0x101828)
        画块(x + 4 * u, y + 8 * u, 3 * u, 2 * u, 0x101828)
        画块(x + 7 * u, y + 8 * u, 3 * u, 2 * u, 0x101828)
        画块(x + 10 * u, y + 8 * u, 3 * u, 2 * u, 0x101828)
        画块(x + 4 * u, y + 11 * u, 3 * u, 2 * u, 0x101828)
        画块(x + 7 * u, y + 11 * u, 3 * u, 2 * u, 0x101828)
        画块(x + 10 * u, y + 11 * u, 3 * u, 2 * u, 0x101828)
        fh 0
    }
    rg kind == 3 {
        画块(x + 1 * u, y + 12 * u, 5 * u, 2 * u, c)
        画块(x + 4 * u, y + 10 * u, 3 * u, 3 * u, c)
        画块(x + 6 * u, y + 8 * u, 3 * u, 3 * u, c)
        画块(x + 8 * u, y + 6 * u, 3 * u, 3 * u, c)
        画块(x + 10 * u, y + 4 * u, 3 * u, 3 * u, c)
        画块(x + 12 * u, y + 2 * u, 2 * u, 2 * u, c)
        fh 0
    }
    rg kind == 4 {
        画块(x + 5 * u, y + 3 * u, 6 * u, 2 * u, c)
        画块(x + 4 * u, y + 5 * u, 2 * u, 3 * u, c)
        画块(x + 10 * u, y + 5 * u, 2 * u, 3 * u, c)
        画块(x + 6 * u, y + 8 * u, 5 * u, 2 * u, c)
        画块(x + 8 * u, y + 10 * u, 2 * u, 2 * u, c)
        画块(x + 7 * u, y + 12 * u, 2 * u, 2 * u, c)
        fh 0
    }
    rg kind == 6 {
        # 终端：一个方框 + ">_"
        画块(x + 1 * u, y + 2 * u, 14 * u, 12 * u, c)
        画块(x + 3 * u, y + 5 * u, 2 * u, 2 * u, 0x1B2740)
        画块(x + 5 * u, y + 7 * u, 2 * u, 2 * u, 0x1B2740)
        画块(x + 8 * u, y + 9 * u, 5 * u, 2 * u, 0x1B2740)
        fh 0
    }
    rg kind == 5 {
        @ 对象区：三个节点连成的【图】，不是树
        画块(x + 2 * u, y + 3 * u, 5 * u, 5 * u, c)
        画块(x + 9 * u, y + 2 * u, 5 * u, 5 * u, c)
        画块(x + 8 * u, y + 10 * u, 5 * u, 5 * u, c)
        画块(x + 7 * u, y + 5 * u, 2 * u, 2 * u, c)
        画块(x + 7 * u, y + 7 * u, 2 * u, 4 * u, c)
        画块(x + 4 * u, y + 8 * u, 4 * u, 2 * u, c)
        fh 0
    }
    fh 0
}

hs 坞图标(i: u32, x: u32, y: u32) -> u32 {
    kb 亮: u32 = 点判定(鼠标x, 鼠标y, x, y, 56, 56)
    kb c1: u32 = 0x3D74E0
    rg i == 1 { c1 = 0x2FA85A }
    rg i == 2 { c1 = 0x8650D8 }
    rg i == 3 { c1 = 0xD2912F }
    rg i == 4 { c1 = 0x1E9E8A }
    rg i == 5 { c1 = 0x3A4658 }
    kb up: u32 = 亮 * 5
    rg 亮 == 1 { 阴影(x, y - up, 56, 56) }
    圆角块(x, y - up, 56, 56, c1)
    画块(x + 8, y + 8 - up, 40, 4, c1 + 0x141414)
    画图标(i + 1, x + 8, y + 8 - up, 40, 0xFFFFFF)
    fh 0
}

hs 画坞() -> u32 {
    kb w: u32 = 6 * 72 + 20
    kb x: u32 = 屏宽() / 2 - w / 2
    kb 坞y: u32 = 屏高() - 88
    阴影(x, 坞y, w, 76)
    圆角块(x, 坞y, w, 76, 0x121B2E)
    圆角框(x, 坞y, w, 76, 0x2A3A5C)
    kb i: u32 = 0
    dy i < 6 {
        坞图标(i, x + 14 + i * 72, 坞y + 10)
        i = i + 1
    }
    fh 0
}

hs 画鼠标(x: u32, y: u32) -> u32 {
    kb r: u32 = 0
    dy r < 13 {
        画块(x, y + r, 1 + r / 2, 1, 0x08101C)
        r = r + 1
    }
    画块(x + 2, y + 10, 6, 7, 0x08101C)
    画块(x + 3, y + 16, 4, 4, 0x08101C)
    kb q: u32 = 0
    dy q < 12 {
        画块(x, y + q, 1 + q / 2, 1, 0xFFFFFF)
        q = q + 1
    }
    画块(x + 2, y + 10, 5, 6, 0xFFFFFF)
    画块(x + 3, y + 15, 3, 4, 0xFFFFFF)
    fh 0
}

hs 存光标(x: u32, y: u32) -> u32 {
    kb i: u32 = 0
    dy i < 22 {
        kb j: u32 = 0
        dy j < 22 {
            备份[i * 22 + j] = 取点(x + j, y + i)
            j = j + 1
        }
        i = i + 1
    }
    fh 0
}

hs 还光标(x: u32, y: u32) -> u32 {
    kb i: u32 = 0
    dy i < 22 {
        kb j: u32 = 0
        dy j < 22 {
            绘点(x + j, y + i, 备份[i * 22 + j])
            j = j + 1
        }
        i = i + 1
    }
    fh 0
}

@ ============================================================================
@  八、四个应用
@ ============================================================================

@ ---- 系统信息（fastfetch 那个路数）----
hs 信息行(x: u32, y: u32, k: u32, v: u32, c: u32) -> u32 {
    圆角块(x, y + 6, 7, 7, c)
    画字(x + 16, y, k, 0x8FA6C8)
    画字(x + 110, y, v, 0xE8F0FF)
    fh 0
}

hs 画信息(x: u32, y: u32, w: u32, h: u32) -> u32 {
    @ 左边标志
    kb lx: u32 = x + 34
    kb ly: u32 = y + 66
    圆角块(lx, ly, 130, 130, 0x1B2740)
    圆角框(lx, ly, 130, 130, 0x3A5180)
    圆角块(lx + 20, ly + 26, 14, 78, 0x4C8DFF)
    圆角块(lx + 40, ly + 40, 14, 64, 0x6FA8FF)
    圆角块(lx + 60, ly + 54, 14, 50, 0x9AC4FF)
    圆角块(lx + 80, ly + 68, 14, 36, 0xC8DEFF)
    画字(lx + 22, ly + 108, "混沌", 0xFFFFFF)
    画字(lx + 30, ly + 130, "HunDun", 0x8FA6C8)

    @ 右边信息
    kb rx: u32 = x + 200
    kb ry: u32 = y + 40
    画字(rx, ry, "混沌 HunDun OS", 0xFFFFFF)
    画字(rx, ry + 20, "----------------------------", 0x33456E)
    信息行(rx, ry + 42, "引导器", "xboot · XBP 协议", 0x4C8DFF)
    信息行(rx, ry + 64, "内核", "新语 XinYu v0.4", 0x37C46A)
    信息行(rx, ry + 86, "界面", "混沌UI（译自 microui 架构）", 0x9B5CF6)
    信息行(rx, ry + 108, "显示", "800 x 600 x 32 位", 0xF2A93B)
    信息行(rx, ry + 130, "帧缓冲", "0xFD000000（VBE 线性）", 0xE0554A)
    信息行(rx, ry + 152, "内存", "512 MB", 0x00BFA5)
    信息行(rx, ry + 174, "开机", "已运行", 0x8FA6C8)
    画数(rx + 110 + 48, ry + 174, (毫秒() - 开机刻) / 1000, 0xE8F0FF)
    画字(rx + 110 + 48 + 56, ry + 174, "秒", 0x8FA6C8)
    fh 0
}

@ ---- 计算器 ----
hs 算键(动作: u32, 标: u32, 宽: u32) -> u32 {
    kb 底: u32 = 0x26334E
    rg 动作 >= 10 { 底 = 0x2F5FA8 }
    rg 动作 == 99 { 底 = 0xE0554A }
    kb r: u32 = 按钮(标, 宽, 40, 底)
    rg r == 1 {
        计算器按键(动作)
        需要重绘 = 2
    }
    fh r
}

hs 计算器按键(a: u32) -> u32 {
    rg a <= 9 {
        rg 算输 == 1 {
            算显 = 算显 * 10 + a
            rg 算显 > 99999999 { 算显 = 99999999 }
        }
        rg 算输 == 0 { 算显 = a }
        算输 = 1
        fh 0
    }
    rg a == 10 {
        算存 = 算显
        算运 = 1
        算输 = 0
        fh 0
    }
    rg a == 11 {
        算存 = 算显
        算运 = 2
        算输 = 0
        fh 0
    }
    rg a == 12 {
        算存 = 算显
        算运 = 3
        算输 = 0
        fh 0
    }
    rg a == 13 {
        算存 = 算显
        算运 = 4
        算输 = 0
        fh 0
    }
    rg a == 14 {
        rg 算运 == 1 { 算显 = 算存 + 算显 }
        rg 算运 == 2 { 算显 = 算存 - 算显 }
        rg 算运 == 3 { 算显 = 算存 * 算显 }
        rg 算运 == 4 {
            rg 算显 > 0 { 算显 = 算存 / 算显 }
        }
        算运 = 0
        算输 = 0
        fh 0
    }
    rg a == 99 {
        算显 = 0
        算存 = 0
        算运 = 0
        算输 = 0
        fh 0
    }
    fh 0
}

hs 画计算器(x: u32, y: u32, w: u32, h: u32) -> u32 {
    @ 显示屏
    圆角块(x + 16, y + 46, w - 32, 62, 0x0B1220)
    圆角框(x + 16, y + 46, w - 32, 62, 0x2A3A5C)
    kb 长: u32 = 0
    kb t: u32 = 算显
    xh {
        长 = 长 + 1
        t = t / 10
        rg t == 0 { tc }
    }
    画数(x + w - 32 - 长 * 8 - 14, y + 68, 算显, 0x7FD4FF)
    rg 算运 == 1 { 画字(x + 28, y + 68, "+", 0x8FA6C8) }
    rg 算运 == 2 { 画字(x + 28, y + 68, "-", 0x8FA6C8) }
    rg 算运 == 3 { 画字(x + 28, y + 68, "*", 0x8FA6C8) }
    rg 算运 == 4 { 画字(x + 28, y + 68, "/", 0x8FA6C8) }

    @ 键盘 4x4（先空一行，避开上面的显示屏）
    kb bw: u32 = (w - 32 - 24) / 4
    布局行(70)
    布局行(48)
    算键(99, "C", bw)
    间隔(8)
    算键(1, "7", bw)
    间隔(8)
    算键(2, "8", bw)
    间隔(8)
    算键(3, "9", bw)
    布局行(48)
    算键(13, "/", bw)
    间隔(8)
    算键(4, "4", bw)
    间隔(8)
    算键(5, "5", bw)
    间隔(8)
    算键(6, "6", bw)
    布局行(48)
    算键(12, "*", bw)
    间隔(8)
    算键(7, "1", bw)
    间隔(8)
    算键(8, "2", bw)
    间隔(8)
    算键(9, "3", bw)
    布局行(48)
    算键(11, "-", bw)
    间隔(8)
    算键(0, "0", bw)
    间隔(8)
    算键(14, "=", bw)
    间隔(8)
    算键(10, "+", bw)
    fh 0
}

@ ---- 画板 ----
hs 画板色块(i: u32, x: u32, y: u32) -> u32 {
    kb c: u32 = 0xE0554A
    rg i == 1 { c = 0xF2A93B }
    rg i == 2 { c = 0x37C46A }
    rg i == 3 { c = 0x4C8DFF }
    rg i == 4 { c = 0x9B5CF6 }
    rg i == 5 { c = 0xFFFFFF }
    kb 在: u32 = 点判定(鼠标x, 鼠标y, x, y, 32, 32)
    rg 在 == 1 { 圆角块(x - 2, y - 2, 36, 36, 0xFFFFFF) }
    圆角块(x, y, 32, 32, c)
    rg 在 == 1 {
        rg 鼠标键 == 1 {
            rg 键已按 == 0 { 画色 = c }
        }
    }
    fh 0
}

hs 画板色条(x: u32, y: u32) -> u32 {
    kb i: u32 = 0
    dy i < 6 {
        画板色块(i, x + 70 + i * 40, y + 42)
        i = i + 1
    }
    fh 0
}

@ 画板输入：每帧都要跑（不能只在重绘里，否则鼠标涂不了）
hs 画板输入() -> u32 {
    rg 窗 != 3 { fh 0 }
    @ 关闭按钮也得在这里收（画板不每帧重画）
    rg 点判定(鼠标x, 鼠标y, 窗口x + 窗口宽 - 36, 窗口y + 8, 26, 26) == 1 {
        rg 鼠标键 == 1 {
            rg 键已按 == 0 {
                窗 = 0
                需要重绘 = 3
                fh 0
            }
        }
    }
    kb mx: u32 = 鼠标x
    kb my: u32 = 鼠标y
    @ 选色：点中了就只重画色条那一行，不动画布
    kb i: u32 = 0
    dy i < 6 {
        kb sx: u32 = 窗口x + 70 + i * 40
        rg 点判定(mx, my, sx, 窗口y + 42, 32, 32) == 1 {
            rg 鼠标键 == 1 {
                rg 键已按 == 0 {
                    kb n: u32 = 0
                    rg i == 1 { n = 1 }
                    rg i == 2 { n = 2 }
                    rg i == 3 { n = 3 }
                    rg i == 4 { n = 4 }
                    rg i == 5 { n = 5 }
                    画色 = 0xF2A93B
                    rg n == 1 { 画色 = 0xF2A93B }
                    rg n == 2 { 画色 = 0x37C46A }
                    rg n == 3 { 画色 = 0x4C8DFF }
                    rg n == 4 { 画色 = 0x9B5CF6 }
                    rg n == 5 { 画色 = 0xFFFFFF }
                    画板色条(窗口x, 窗口y)
                }
            }
        }
        i = i + 1
    }
    @ 涂画
    kb cy: u32 = 窗口y + 84
    kb 在内: u32 = 点判定(mx, my, 窗口x + 18, cy + 2, 窗口宽 - 36, 窗口高 - 100)
    rg 在内 == 1 {
        rg 鼠标键 == 1 {
            rg 笔画中 == 1 { 直线(笔旧x, 笔旧y, mx, my, 画色) }
            笔画中 = 1
            笔旧x = mx
            笔旧y = my
        }
    }
    rg 鼠标键 == 0 { 笔画中 = 0 }
    fh 0
}

hs 画画板(x: u32, y: u32, w: u32, h: u32) -> u32 {
    画字(x + 16, y + 46, "颜色", 0x8FA6C8)
    画板色条(x, y)
    画字(x + w - 20 - 文宽("按住左键涂抹"), y + 46, "按住左键涂抹", 0x5F7A9C)
    kb cy: u32 = y + 84
    kb ch: u32 = h - 96
    印("画板 cy=")
    印(cy)
    印(" ch=")
    印(ch)
    印("\n")
    圆角块(x + 16, cy, w - 32, ch, 0xF4F6FA)
    圆角框(x + 16, cy, w - 32, ch, 0x33456E)
    fh 0
}

@ ---- 关于 ----
hs 画关于(x: u32, y: u32, w: u32, h: u32) -> u32 {
    kb ty: u32 = y + 52
    画字(x + 24, ty, "混沌 HunDun OS", 0xFFFFFF)
    画字(x + 24, ty + 34, "一套从零自研的系统，从引导扇区到桌面。", 0xAEC3E0)
    画字(x + 24, ty + 62, "自研的部分：", 0x4C8DFF)
    画字(x + 34, ty + 88, "· xboot 引导器（512 字节扇区 + VBE + 保护模式）", 0xAEC3E0)
    画字(x + 34, ty + 110, "· XBP 自研引导协议", 0xAEC3E0)
    画字(x + 34, ty + 132, "· 新语语言与 xyc 编译器", 0xAEC3E0)
    画字(x + 34, ty + 154, "· ISO 9660 / El Torito 打包器", 0xAEC3E0)
    画字(x + 34, ty + 176, "· 图形运行时、鼠标键盘驱动、桌面", 0xAEC3E0)
    画字(x + 24, ty + 208, "借的部分（已标注）：", 0xF2A93B)
    画字(x + 34, ty + 234, "· 16x16 点阵字库位图来自 GNU Unifont", 0xAEC3E0)
    画字(x + 34, ty + 256, "· 混沌UI 的架构译自 microui（MIT）", 0xAEC3E0)
    画字(x + 34, ty + 278, "· 构建用的 as / ld / clang", 0xAEC3E0)
    fh 0
}

hs 对象动作(a: u32) -> u32 {
    kb 对: u32 = 0
    rg a == 1 {
        对 = 存对象("混沌")
        加名("混沌", 对)
        需要重绘 = 2
        fh 0
    }
    rg a == 2 {
        对 = 存对象("混沌")
        加名("混沌副本", 对)
        需要重绘 = 2
        fh 0
    }
    rg a == 3 {
        对 = 存对象("这是报告的内容")
        加名("报告", 对)
        需要重绘 = 2
        fh 0
    }
    rg a == 4 {
        存视图()
        改名("报告", "我的报告")
        记轴("改名：只造新映射，对象一字节未动")
        需要重绘 = 2
        fh 0
    }
    rg a == 5 {
        存视图()
        删名("我的报告")
        记轴("删除：从本视图摘掉引用，对象仍在")
        需要重绘 = 2
        fh 0
    }
    rg a == 6 {
        恢复视图()
        需要重绘 = 2
        fh 0
    }
    rg a == 7 {
        对象数 = 0
        映射数 = 0
        史数 = 0
        轴数 = 0
        高亮对象 = 0xFFFFFFFF
        记轴("已清空（演示用；真机上对象永在盘上）")
        需要重绘 = 2
        fh 0
    }
    rg a == 8 {
        kb a1: u32 = 摘要("混沌")
        kb a2: u32 = 摘要("混沌")
        rg a1 == a2 { 记轴("自检：同一内容两次摘要 → 同一哈希，去重生效") }
        rg a1 != a2 { 记轴("自检：哈希不稳定 ✗") }
        需要重绘 = 2
        fh 0
    }
    fh 0
}

hs 对象按钮(标: u32, 宽: u32, 动作: u32) -> u32 {
    kb 底: u32 = 0x26334E
    rg 动作 == 5 { 底 = 0x7A2E2E }
    rg 动作 == 6 { 底 = 0x2F5FA8 }
    kb r: u32 = 按钮(标, 宽, 34, 底)
    rg r == 1 { 对象动作(动作) }
    fh r
}

hs 画对象区(x: u32, y: u32, w: u32, h: u32) -> u32 {
    @ 左：对象区
    圆角块(x + 16, y + 48, 262, 150, 0x0B1220)
    圆角框(x + 16, y + 48, 262, 150, 0x2A3A5C)
    画字(x + 28, y + 56, "对象区 · 内容寻址 · 只追加", 0x7FD4FF)
    rg 对象数 == 0 { 画字(x + 34, y + 110, "（空）按下面的按钮存东西", 0x5F7A9C) }
    kb i: u32 = 0
    dy i < 对象数 {
        kb yy: u32 = y + 82 + i * 26
        rg 高亮对象 == i { 圆角块(x + 20, yy - 4, 254, 24, 0x1B2740) }
        rg 高亮对象 != i { 画块(x + 20, yy - 4, 254, 24, 0x0B1220) }
        绘十六(x + 28, yy, 对象哈希[i], 0x9AC4FF)
        画数(x + 100, yy, 对象长[i], 0x6E86A8)
        画字(x + 126, yy, 对象串[i], 0xE8F0FF)
        i = i + 1
    }

    @ 右：当前视图
    圆角块(x + 286, y + 48, 258, 150, 0x0B1220)
    圆角框(x + 286, y + 48, 258, 150, 0x2A3A5C)
    画字(x + 298, y + 56, "当前视图 · 名字 → 引用", 0x7FD4FF)
    rg 映射数 == 0 { 画字(x + 304, y + 110, "（空）", 0x5F7A9C) }
    kb j: u32 = 0
    dy j < 映射数 {
        kb yy2: u32 = y + 82 + j * 26
        画字(x + 298, yy2, 名表[j], 0xE8F0FF)
        画字(x + 400, yy2, "→", 0x5F7A9C)
        绘十六(x + 418, yy2, 对象哈希[名指[j]], 0x9AC4FF)
        j = j + 1
    }

    @ 下：轴
    圆角块(x + 16, y + 206, 528, 128, 0x0B1220)
    圆角框(x + 16, y + 206, 528, 128, 0x2A3A5C)
    画字(x + 28, y + 214, "轴 · 操作记录 · 只增不减", 0xF2A93B)
    kb k: u32 = 0
    dy k < 轴数 {
        画字(x + 28, y + 240 + k * 15, 轴[k], 0xAEC3E0)
        k = k + 1
    }
    rg 轴数 == 0 { 画字(x + 34, y + 250, "（还没有操作）", 0x5F7A9C) }

    @ 按钮两排
    kb bw: u32 = 126
    布局行(298)
    布局行(38)
    对象按钮("存 混沌", bw, 1)
    间隔(8)
    对象按钮("再存一次", bw, 2)
    间隔(8)
    对象按钮("存 报告", bw, 3)
    间隔(8)
    对象按钮("改名", bw, 4)
    布局行(38)
    对象按钮("删除", bw, 5)
    间隔(8)
    对象按钮("撤销", bw, 6)
    间隔(8)
    对象按钮("清空", bw, 7)
    间隔(8)
    对象按钮("自检", bw, 8)
    fh 0
}

@ ============================================================================
@  九、桌面合成
@ ============================================================================
hs 取秒() -> u32 {
    fh 秒()
}


@ 终端每帧收键盘（不能塞在重绘里，否则窗口一重画终端就白字）
hs 终端输入() -> u32 {
    rg 窗 != 6 { fh 0 }
    rg 点判定(鼠标x, 鼠标y, 窗口x + 窗口宽 - 36, 窗口y + 8, 26, 26) == 1 {
        rg 鼠标键 == 1 {
            rg 键已按 == 0 {
                窗 = 0
                终端已开 = 0
                需要重绘 = 3
                fh 0
            }
        }
    }
    终端一步()
    fh 0
}

hs 画窗口(画阴: u32) -> u32 {
    rg 窗 == 0 { fh 0 }
    rg 只算 == 0 { 控件数 = 0 }        @ 真画的时候重新记一遍控件位置
    印("[窗=")
    印(窗)
    印("]\n")
    kb w: u32 = 窗口宽
    kb h: u32 = 窗口高
    kb 关: u32 = 0
    rg 窗 == 1 {
        关 = 面板开始(窗口x, 窗口y, w, h, "系统信息", 画阴)
        画信息(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 2 {
        关 = 面板开始(窗口x, 窗口y, w, h, "计算器", 画阴)
        画计算器(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 3 {
        关 = 面板开始(窗口x, 窗口y, w, h, "画板", 画阴)
        画画板(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 4 {
        关 = 面板开始(窗口x, 窗口y, w, h, "关于", 画阴)
        画关于(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 5 {
        关 = 面板开始(窗口x, 窗口y, w, h, "对象区 · 一切皆哈希", 画阴)
        画对象区(窗口x, 窗口y, w, h)
        面板结束()
    }
    rg 窗 == 6 {
        关 = 面板开始(窗口x, 窗口y, w, h, "史书", 画阴)
        设区(窗口x + 12, 窗口y + 46, w - 24, h - 58)
        @ ★ 以前这里【每次重绘】都调 终端开() —— 而它第一句就是 屏清()，
        @   于是史书一重绘就把自己的内容清空，输出根本攒不到该滚的时候。
        @   现在：第一次开才打横幅，之后重绘只是把【文字缓冲】重放一遍。
                rg 终端已开 == 0 {
            终端开()
            终端已开 = 1
        }
        rg 终端已开 == 1 { 史书_画() }
        面板结束()
    }
    rg 关 == 1 {
        rg 窗 == 6 { 终端已开 = 0 }
        窗 = 0
        需要重绘 = 3
    }
    fh 0
}

hs 坞点击(mx: u32, my: u32) -> u32 {
    kb w: u32 = 6 * 72 + 20
    kb x: u32 = 屏宽() / 2 - w / 2
    rg 点判定(mx, my, x, 屏高() - 88, w, 76) == 0 { fh 0 }
    rg 鼠标键 == 1 {
        rg 键已按 == 0 {
            kb i: u32 = (mx - x - 14) / 72
            kb bx: u32 = x + 14 + i * 72
            rg mx >= bx {
                rg mx < bx + 56 { fh i + 1 }
            }
        }
    }
    fh 0
}

hs 初始化() -> u32 {
    徽标[0] = 5
    徽标[1] = 3
    徽标[2] = 2
    徽标[3] = 1
    徽标[4] = 1
    徽标[5] = 0
    徽标[6] = 0
    徽标[7] = 0
    窗口x = 120
    窗口y = 70
    窗口宽 = 560
    窗口高 = 430
    窗 = 0
    需要重绘 = 1
    画色 = 0xE0554A
    滑条值 = 60
    旧鼠标x = 400
    旧鼠标y = 300
    首帧 = 1
    开机刻 = 毫秒()
    高亮对象 = 0xFFFFFFFF
    壳_初始化()                  @ ★ 芯核侧初始化：指针表 / 视图 / 盘
    盘自检()
    盘格式自检()
    压缩自检()
    fh 0
}

hs 主() -> u32 {
    初始化()
    xh {
        kb mx: u32 = 鼠x()
        kb my: u32 = 鼠y()
        kb s: u32 = 秒()
        时钟秒 = s

        @ 先把上一帧的光标擦掉 —— 必须在画场景之前
        还光标(旧鼠标x, 旧鼠标y)
        rg 首帧 == 1 {
            需要重绘 = 3
            首帧 = 0
        }

        kb cx: u32 = mx
        kb cy: u32 = my
        rg cx > 屏宽() - 24 { cx = 屏宽() - 24 }
        rg cy > 屏高() - 24 { cy = 屏高() - 24 }

        界面开始()

        rg s != 旧秒 {
            旧秒 = s
            rg 需要重绘 == 0 { 需要重绘 = 1 }
        }

        @ 画板每帧都要收鼠标（不能只在重绘里跑，否则涂不上）
        画板输入()

        @ ★ 史书每帧都要收键盘 —— 以前这个函数定义了却没人调，
        @   所以史书窗口能开出来、横幅也在，但敲键盘一个字都进不去。
        终端输入()

        @ 坞：点图标开窗 / 再点关窗
        kb 点开: u32 = 坞点击(mx, my)
        rg 点开 > 0 {
            rg 窗 == 点开 { 窗 = 0 }
            rg 窗 != 点开 { 窗 = 点开 }
            需要重绘 = 3
        }

        @ 拖动窗口标题栏
        rg 窗 > 0 {
            rg 点判定(mx, my, 窗口x, 窗口y, 窗口宽, 34) == 1 {
                rg 鼠标键 == 1 {
                    rg 键已按 == 0 {
                        拖动偏x = mx - 窗口x
                        拖动偏y = my - 窗口y
                        拖动中 = 1
                    }
                }
            }
            rg 鼠标键 == 0 { 拖动中 = 0 }
            rg 拖动中 == 1 {
                窗口x = mx - 拖动偏x
                窗口y = my - 拖动偏y
                rg 窗口x > 屏宽() - 44 { 窗口x = 屏宽() - 44 }
                rg 窗口y > 屏高() - 100 { 窗口y = 屏高() - 100 }
                需要重绘 = 3
            }
        }

        @ 3 = 整屏  2 = 窗口+坞  1 = 只顶栏（每秒刷新时钟走这条）
        rg 需要重绘 == 3 {
            需要重绘 = 0
            画壁纸()
            画顶栏()
            画窗口(1)
            画坞()
        }
        rg 需要重绘 == 2 {
            需要重绘 = 0
            画窗口(0)
            画坞()
        }
        rg 需要重绘 == 1 {
            需要重绘 = 0
            画顶栏()
        }

        @ ★ 每帧跑一趟「只算不画」：控件位置查表，按钮照样能收到点击，
        @   但一个像素都不画 → 画面不再每帧重刷 → 不闪了。
        kb 旧热: u32 = 热控件
        rg 窗 > 0 {
            rg 窗 != 3 {
                rg 窗 != 6 {
                    只算 = 1
                    画窗口(0)
                    只算 = 0
                }
            }
        }
        @ 悬停高亮变了才重画一次
        rg 热控件 != 旧热 {
            rg 需要重绘 == 0 { 需要重绘 = 2 }
        }

        界面结束()

        @ 存下光标底下的背景，再画光标
        存光标(cx, cy)
        画鼠标(cx, cy)
        旧鼠标x = cx
        旧鼠标y = cy
    }
    fh 0
}
