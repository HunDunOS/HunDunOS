00 象 —— 渲染引擎（最小版）
00
00 三层的接法：
00   ① 面 = 天道：一块离屏缓冲就是一个 view 的可见形态
00   ② 基元：块 / 字 / 圆角
00   ③ 合成：按 Z 序把面搬到屏幕
00
00 传参一律走全局（lyc 的函数参数不可靠，今晚踩过）

ts gx = 0
ts gy = 0
ts gw = 0
ts gh = 0
ts gc = 0
ts gr = 0

00 数.ly 的开方走全局 ga，这里声明一份，链接时合并
ts ga = 0

00 面：0xC00000 起，640×400×4 = 1MB
ts 面基 = 0xC00000
ts 面宽 = 640
ts 面高 = 400
ts 面行 = 2560

00 当前绘图目标：0 = 屏幕，1 = 面
ts 目标 = 0

00 屏幕基址与行跨（内核启动时填）
ts 屏基 = 0
ts 屏行 = 0
ts 屏宽 = 0
ts 屏高 = 0

00 ========== 取当前目标的基址/行跨 ==========
ts 本基 = 0
ts 本行 = 0

tt 取本 01 02 -> u64  08
    lz 目标 1  08
        本基 = 面基
        本行 = 面行
        zz 0
     09
    本基 = 屏基
    本行 = 屏行
    zz 0
 09

00 ========== 切面 / 切屏 ==========
tt 象_面 01 02 -> u64  08
    目标 = 1
    zz 0
 09

tt 象_屏 01 02 -> u64  08
    目标 = 0
    zz 0
 09

00 ========== 象_块：填一个矩形 ==========
00 gx gy gw gh gc
tt 象_块 01 02 -> u64  08
    tz r1 = 0
    tz r2 = 0
    tz r3 = 0
    tz r4 = 0
    tz r5 = 0
    tz r6 = 0
    zt 取本 01 02
    r1 = 0
    ll  08
        lz r1 gh  08 ls  09
        r2 = 01 gy ht r1 02
        r2 = 01 r2 hh 本行 02
        r3 = 01 gx hh 4 02
        r2 = 01 r2 ht r3 02
        r2 = 01 本基 ht r2 02
        r3 = gw
        ll  08
            lz r3 0  08 ls  09
            sh r2 , gc
            r2 = 01 r2 ht 4 02
            r3 = 01 r3 hz 1 02
         09
        r1 = 01 r1 ht 1 02
     09
    zz 0
 09

00 ========== 象_点 ==========
tt 象_点 01 02 -> u64  08
    tz s1 = 0
    tz s2 = 0
    zt 取本 01 02
    s1 = 01 gy hh 本行 02
    s2 = 01 gx hh 4 02
    s1 = 01 s1 ht s2 02
    s1 = 01 本基 ht s1 02
    sh s1 , gc
    zz 0
 09

00 ========== 象_合：面 → 屏幕（gx gy = 屏幕上的落点） ==========
tt 象_合 01 02 -> u64  08
    tz t1 = 0
    tz t2 = 0
    tz t3 = 0
    tz t4 = 0
    tz t5 = 0
    tz t6 = 0
    t1 = 0
    ll  08
        lz t1 400  08 ls  09
        00 面这一行的起点
        t2 = 01 t1 hh 2560 02
        t2 = 01 0xC00000 ht t2 02
        00 屏幕这一行的起点
        t3 = 01 gy ht t1 02
        t3 = 01 t3 hh 屏行 02
        t4 = 01 gx hh 4 02
        t3 = 01 t3 ht t4 02
        t3 = 01 屏基 ht t3 02
        t5 = 640
        ll  08
            lz t5 0  08 ls  09
            t6 = fh t2
            sh t3 , t6
            t2 = 01 t2 ht 4 02
            t3 = 01 t3 ht 4 02
            t5 = 01 t5 hz 1 02
         09
        t1 = 01 t1 ht 1 02
     09
    zz 0
 09

00 ========== 象_圆：实心圆（圆心 gx gy，半径 gr，色 gc） ==========
00 用牛顿开方算每行的弦长，比逐像素判断 dist² 快得多
00 注意：数.ly 的 sq 走全局 ga，所以这里要先把被开方数放进 ga
00 ========== 象_圆：实心圆（圆心 gx gy，半径 gr，色 gc） ==========
00 铁律：变量全在函数头、不重复同名、zt 不嵌参数位、不撞 64 令
00 每行用牛顿开方算半弦长（比逐像素判断 dist² 快得多）
tt 象_圆 01 02 -> u64  08
    tz q1 = 0
    tz q2 = 0
    tz q3 = 0
    tz q4 = 0
    tz q5 = 0
    tz q6 = 0
    tz cx = 0
    tz cy = 0
    tz yy = 0
    00 铁律：变量全在函数头；绝不出现「小减大」；zt 不嵌参数位
    00 上下两半分开算：上半 yy = cy - q1（q1 <= gr <= cy），下半 yy = cy + q1
    cx = gx
    cy = gy
    q3 = 01 gr hh gr 02
    q2 = 01 gr dh 1 02
    q1 = 0
    ll  08
        lz q1 q2  08 ls  09
        00 q6 = gr - q1，先判大小，绝不出现负数
        q6 = 0
        lr gr >= q1  08 q6 = 01 gr hz q1 02  09
        ga = 01 q3 hz 01 q6 hh q6 02 02
        q4 = zt sq 01 02
        q5 = 0
        ll  08
            lz q5 q4  08 ls  09
            00 左端 x = cx - q4 + q5
            gx = 01 cx hz q4 02
            gx = 01 gx ht q5 02
            00 上半
            gy = 01 cy hz q1 02
            zt 象_点 01 02
            00 下半
            gy = 01 cy ht q1 02
            zt 象_点 01 02
            q5 = 01 q5 ht 1 02
         09
        q1 = 01 q1 ht 1 02
     09
    gx = cx
    gy = cy
    zz 0
 09

00 ========== 象_影：简单阴影（在面右下偏移画暗块） ==========
tt 象_影 01 02 -> u64  08
    00 gx gy gw gh 已在全局，这里只在面里画一层暗
    00 先存当前色
    tz u1 = 0
    u1 = gc
    gc = 0x00101014
    zt 象_块 01 02
    gc = u1
    zz 0
 09
