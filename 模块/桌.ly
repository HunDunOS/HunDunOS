00 ========== 桌 —— 桌面（最简版：设全局 + 调 桌用.asm）==========
00 所有绘制参数走全局，六爻只负责排布局，不碰坐标计算

00 ---- 给 桌用.asm 用的全局 ----
ts 桌x = 0
ts 桌y = 0
ts 桌w = 0
ts 桌h = 0
ts 桌色 = 0
ts 桌tx = 0
ts 壁源 = 0
ts 桌ty = 0
ts 桌tp = 0

00 画一块
tt 块 01 bx , by , bw , bh , bc 02 -> u64  08
    桌x = bx
    桌y = by
    桌w = bw
    桌h = bh
    桌色 = bc
    zs 08
call _桌_块
09
    zz 0
 
09

00 写一串（串地址放 桌tp）
tt 字 01 tx , ty , tc 02 -> u64  08
    桌tx = tx
    桌ty = ty
    桌色 = tc
    zs 08
call _桌_字
09
    zz 0
 
09

00 ========== 画桌面 ==========
tt 画桌面 01 02 -> u64  08
    00 ★ 清空测试：什么都不画
    zz 0
09
tt 写字层 01 02 -> u64  08
    00 ★ 清空测试：不画时间
    zz 0
09


00 ========== 画鼠标光标（十字 + 中心点）==========
00 用 鼠X 鼠Y（来自 鼠.ly）
ts 鼠X = 0
ts 鼠Y = 0
ts 鼠键 = 0
ts 鼠在 = 0

tt 画鼠标 01 02 -> u64  08
    tz k1 = 0
    tz k2 = 0
    tz k3 = 0

    00 水平线：从 鼠X-8 到 鼠X+8
    k1 = 鼠X
    lr k1 > 8  08 k1 = 01 k1 hz 8 02 
09
    zt 块 01 k1 , 鼠Y , 17 , 1 , 0x00FFFFFF 02

    00 垂直线
    k2 = 鼠Y
    lr k2 > 8  08 k2 = 01 k2 hz 8 02 
09
    zt 块 01 鼠X , k2 , 1 , 17 , 0x00FFFFFF 02

    00 中心点（按键时变红）
    zt 块 01 鼠X , 鼠Y , 3 , 3 , 0x00FF4444 02
    zz 0
 
09

tt zx桌 01 02 -> u64  08
    zt 画桌面 01 02
    zt 写字层 01 02
    zt 画鼠标 01 02
    ll  08
     
09
    zz 0
 
09
