@ ============================================================================
@  混沌 磁盘模块（盘.xy）—— ATA PIO 驱动，全用新语写
@
@  这是【新加的一个模块】，不是往老模块里塞东西。
@  它只依赖原语模块（端口读写、内存读写），剩下的逻辑全是新语。
@
@  为什么需要它：编译器要读源文件、写输出文件 —— 自举的地基是 IO，
@  而 IO 的地基是盘。所以这是"一切皆哈希"走出内存的第一步。
@ ============================================================================

qj 盘缓冲[512]: u32          @ 一个扇区 = 512 字节 = 128 个 u32
qj 盘号: u32
qj 盘就绪: u32

@ --- ATA 端口 ---
@ 0x1F0 数据  0x1F2 扇区数  0x1F3/4/5 LBA 低中高  0x1F6 驱动器  0x1F7 状态/命令

hs 盘等() -> u32 {
    kb i: u32 = 0
    dy i < 1000000 {
        kb s: u32 = 端入(0x1F7)
        @ 等 BSY(0x80) 清掉，且 DRQ(0x08) 或 ERR(0x01) 有结果
        rg s < 128 {
            rg s >= 8 { fh s }
            rg s >= 1 { fh s }
        }
        i = i + 1
    }
    fh 0
}

@ ★ ATA 的规矩：必须【先写 0x1F6 选中驱动器】，状态寄存器 0x1F7 才有意义。
@   不选就读，QEMU 返回 0 —— 一开始就是这么被骗的。
hs 盘就绪吗() -> u32 {
    端出(0x1F6, 0xA0)            @ 主盘 + LBA 模式
    端出(0x1F2, 0)
    端出(0x1F3, 0)
    端出(0x1F4, 0)
    端出(0x1F5, 0)
    kb s: u32 = 端入(0x1F7)
    rg s == 0 { fh 0 }
    rg s == 0xFF { fh 0 }
    fh 1
}

@ 选盘：主盘 LBA 模式
hs 盘选(lba: u32) -> u32 {
    端出(0x1F6, 0xE0 + ((lba / 16777216) % 16))
    端出(0x1F2, 1)
    端出(0x1F3, lba % 256)
    端出(0x1F4, (lba / 256) % 256)
    端出(0x1F5, (lba / 65536) % 256)
    fh 0
}

@ 读一个扇区到 盘缓冲
hs 盘读扇区(lba: u32) -> u32 {
    盘选(lba)
    端出(0x1F7, 0x20)            @ READ SECTORS
    kb s: u32 = 盘等()
    rg s == 0 { fh 0 }
    rg s % 2 == 1 { fh 0 }       @ ERR 置位
    kb i: u32 = 0
    dy i < 256 {
        kb w: u32 = 端入字(0x1F0)
        盘缓冲[i * 2] = w % 256
        盘缓冲[i * 2 + 1] = w / 256
        i = i + 1
    }
    fh 1
}

@ 从 盘缓冲 写一个扇区
hs 盘写扇区(lba: u32) -> u32 {
    盘选(lba)
    端出(0x1F7, 0x30)            @ WRITE SECTORS
    kb s: u32 = 盘等()
    rg s == 0 { fh 0 }
    kb i: u32 = 0
    dy i < 256 {
        端出字(0x1F0, 盘缓冲[i * 2] + 盘缓冲[i * 2 + 1] * 256)
        i = i + 1
    }
    端出(0x1F7, 0xE7)            @ FLUSH CACHE
    盘等()
    fh 1
}

@ 把 盘缓冲 前 n 个双字按十六进制画出来（调试用）
hs 盘缓冲十六(x: u32, y: u32, n: u32, c: u32) -> u32 {
    kb i: u32 = 0
    dy i < n {
        绘十六(x, y + i * 18, 盘缓冲[i * 2] + 盘缓冲[i * 2 + 1] * 256, c)
        i = i + 1
    }
    fh 0
}

@ 自检：读 LBA 100，看头几个字节对不对
hs 盘自检() -> u32 {
    rg 盘就绪吗() == 0 {
        印("[盘] 主通道没有 ATA 盘\n")
        盘就绪 = 0
        fh 0
    }
    盘就绪 = 1
    印("[盘] ATA 盘在，读 LBA 100 …\n")
    rg 盘读扇区(100) == 0 {
        印("[盘] 读取失败\n")
        fh 0
    }
    印("[盘] 头 8 字节 = ")
    kb i: u32 = 0
    dy i < 8 {
        印(盘缓冲[i])
        印(" ")
        i = i + 1
    }
    印("\n")
    rg 盘缓冲[0] == 72 {
        rg 盘缓冲[1] == 68 { 印("[盘] 签名 HDGX 校验通过\n") }
    }
    fh 1
}
