@ ============================================================
@ 混沌 包模块（包.ly）—— 读 .bao v2
@ 六爻语言移植版
@ ============================================================

@ ---- 全局变量 ----
ts 盘缓冲[512] = 0
ts 盘对象数 = 0
ts 盘索引起 = 0
ts 盘追加 = 0
ts 包缓冲[16384] = 0
ts 包缓冲址 = 0
ts 包址 = 0
ts 包起始LBA = 0
ts 包扇区数 = 0
ts 包成员数 = 0
ts 包清单 = 0
ts 包数据 = 0
ts 包长 = 0
ts 包清单哈希 = 0
ts 包世代 = 0
ts 包能力 = 0
ts 视图能力[4] = 0

ts 插件名[16] = 0
ts 插件口[16] = 0
ts 插件数 = 0
ts 当前视图 = 0
ts 包可执行入口 = 0
ts 包可执行偏移 = 0
ts 包可执行长 = 0
ts 包加载址 = 0
ts 包装进数 = 0
ts 包名址 = 0
ts 包名[128] = 0
ts 包装[512] = 0
ts 包装址 = 0

@ ============================================================
@ 逐扇区从盘上读到缓冲
@ ============================================================
tt 包_读盘 01 lba  扇区数 02 -> u64  08
    tz i = 0
    ll  08
        lz i 扇区数  08 ls  09
        zt 盘读扇区 01 01 lba ht i 02 02
        tz j = 0
        ll  08
            lz j 256  08 ls  09
            st 01 包缓冲址 ht i ht 512 ht j ht 2 02 = 01 盘缓冲 ht j ht 2 02
            st 01 包缓冲址 ht i ht 512 ht j ht 2 ht 1 02 = 01 盘缓冲 ht j ht 2 ht 1 02
            j = j ht 1
         09
        i = i ht 1
     09
    zz 1
 09

@ ============================================================
@ 从缓冲里按字节取
@ ============================================================
tt 包取8 01 off 02 -> u64  08
    tz v = fh 01 包址 ht off 02
    zz v
 09

tt 包取32 01 off 02 -> u64  08
    zz 01 01 包取8 01 off 02 ht 01 包取8 01 off ht 1 02 ht 256 02 ht 01 包取8 01 off ht 2 02 ht 65536 02 ht 01 包取8 01 off ht 3 02 ht 16777216 02 02
 09

@ ============================================================
@ 校验：魔数 + 包头自校验
@ ============================================================
tt 包_校验 01 02 -> u64  08
    lh 01 包取32 01 0 02 02 0x324F4142  08
        zz 0
     09
    lh 包取32 01 4 02 2  08
        zz 0
     09
    tz h = 2166136261
    tz i = 0
    ll  08
        lz i 32  08 ls  09
        h = 01 h yh 包取8 01 i 02 02
        h = 01 h ht 16777619 02
        i = i ht 1
     09
    lh h 包取32 01 32 02  08
        zz 0
     09
    包成员数 = 包取32 01 8 02
    包清单 = 40
    包数据 = 01 包址 ht 40 ht 包取32 01 12 02 02
    包长 = 包取32 01 36 02
    包清单哈希 = 包取32 01 16 02
    包世代 = 包取32 01 20 02
    包能力 = 包取32 01 28 02
    zz 1
 09

@ ============================================================
@ 第 i 个成员的名字
@ ============================================================
tt 包_成员名 01 i  出 02 -> u64  08
    tz o = 01 包清单 ht i ht 32 02
    tz noff = 包取32 01 o ht 4 02
    tz nlen = 包取32 01 o ht 8 02
    tz j = 0
    ll  08
        lz j nlen  08 ls  09
        tz v = fh 01 包数据 ht noff ht j 02
        st 01 出 ht j 02 = v
        j = j ht 1
     09
    st 01 出 ht nlen 02 = 0
    zz nlen
 09

tt 包_成员类型 01 i 02 -> u64  08
    zz 包取32 01 01 包清单 ht i ht 32 ht 24 02 02
 09

tt 包_成员长 01 i 02 -> u64  08
    zz 包取32 01 01 包清单 ht i ht 32 ht 16 02 02
 09

tt 包_成员哈希 01 i 02 -> u64  08
    zz 包取32 01 01 包清单 ht i ht 32 ht 12 02 02
 09

tt 包_能力名 01 v 02 -> u64  08
    lz v 0  08
        屏串 01 03数据04 02
        zz 0
     09
    lz v 1  08
        屏串 01 03可执行04 02
        zz 0
     09
    lz v 2  08
        屏串 01 03文档04 02
        zz 0
     09
    lz v 3  08
        屏串 01 03字库04 02
        zz 0
     09
    屏串 01 03?04 02
    zz 0
 09

@ ============================================================
@ 列清单
@ ============================================================
tt 包_列 01 02 -> u64  08
    屏设色 01 0x9AC4FF 02
    屏串 01 03  包里 04 02
    屏数 01 包成员数 02
    屏串 01 03  个成员 · 世代 04 02
    屏数 01 包世代 02
    屏串 01 03 · 清单哈希 04 02
    zt 打十六_包 01 包清单哈希 02
    屏换行 01 02
    tz i = 0
    ll  08
        lz i 包成员数  08 ls  09
        tz o = 01 包清单 ht i ht 32 02
        屏设色 01 0x6E86A8 02
        屏串 01 03    04 02
        屏数 01 01 i ht 1 02 02
        屏串 01 03. 04 02
        屏设色 01 0xE8F0FF 02
        zt 包_成员名 01 i  包名址 02
        屏串 01 包名址 02
        屏设色 01 0x5F7A9C 02
        屏串 01 03  04 02
        zt 包_能力名 01 zt 包_成员类型 01 i 02 02
        屏串 01 03  04 02
        屏数 01 zt 包_成员长 01 i 02 02
        屏串 01 03  字节  内容哈希 04 02
        zt 打十六_包 01 zt 包_成员哈希 01 i 02 02
        lz zt 包_成员类型 01 i 02 1  08
            屏串 01 03  入口 0x04 02
            zt 打十六_包 01 包取32 01 o ht 28 02 02
         09
        屏换行 01 02
        i = i ht 1
     09
    zz 0
 09

@ ============================================================
@ 打十六的小工具
@ ============================================================
tt 打十六_包 01 v 02 -> u64  08
    tz i = 0
    ll  08
        tz 移 = 01 01 7 - i 02 ht 4 02
        tz t = 01 01 v / 01 1 ht 移 02 02 % 16 02
        lh t 10  08
            屏出 01 01 48 ht t 02 02
         09
        lz t 10  08
            屏出 01 01 87 ht t 02 02
         09
        i = i ht 1
        lh i 8  08 ls  09
     09
    zz 0
 09

@ ============================================================
@ FNV-1a：名字哈希
@ ============================================================
tt 名字哈希 01 址 02 -> u64  08
    tz h = 2166136261
    tz i = 0
    ll  08
        tz c = fh 01 址 ht i 02
        lz c 0  08 ls  09
        h = 01 h yh c 02
        h = 01 h ht 16777619 02
        i = i ht 1
     09
    lz h 0  08
        h = 1
     09
    zz h
 09

@ ============================================================
@ 按命令名找插件并调用它
@ ============================================================
tt 插件_跑 01 名址  参址 02 -> u64  08
    lz 插件数 0  08
        zz 0
     09
    tz h = zt 名字哈希 01 名址 02
    tz i = 0
    ll  08
        lz i 插件数  08 ls  09
        lz 01 插件名 ht i 02 h  08
            调用 01 01 插件口 ht i 02  0  0  0  参址 02
            zz 1
         09
        i = i ht 1
     09
    zz 0
 09

@ ============================================================
@ 列出装进来的手
@ ============================================================
tt 插件_列 01 02 -> u64  08
    lz 插件数 0  08
        zz 0
     09
    屏设色 01 0x8FA6C8 02
    屏串 01 03  装进来的手：04 02
    屏数 01 插件数 02
    屏串 01 03  只04 02
    屏换行 01 02
    tz i = 0
    ll  08
        lz i 插件数  08 ls  09
        屏串 01 03    0x04 02
        zt 打十六_包 01 01 插件名 ht i 02 02
        屏串 01 03  →  0x04 02
        zt 打十六_包 01 01 插件口 ht i 02 02
        屏换行 01 02
        i = i ht 1
     09
    zz 0
 09

@ ============================================================
@ 装包：把每个成员的内容当成对象存进对象区
@ ============================================================
tt 包_装 01 02 -> u64  08
    包装进数 = 0
    tz i = 0
    ll  08
        lz i 包成员数  08 ls  09
        tz o = 01 包清单 ht i ht 32 02
        tz off = 包取32 01 o ht 20 02
        tz ln = 包取32 01 o ht 16 02
        tz j = 0
        ll  08
            lz j ln  08 ls  09
            tz v = fh 01 包数据 ht off ht j 02
            st 01 包装址 ht j 02 = v
            j = j ht 1
         09
        st 01 包装址 ht ln 02 = 0
        zt 盘存对象 01 包装址 02
        lz zt 包_成员类型 01 i 02 4  08
            lh 插件数 16  08
                zt 包_成员名 01 i  包名址 02
                st 01 插件名 ht 插件数 02 = zt 名字哈希 01 包名址 02
                st 01 插件口 ht 插件数 02 = 包取32 01 o ht 28 02
                插件数 = 01 插件数 ht 1 02
                屏设色 01 0x37C46A 02
                屏串 01 03    ↑ 长出一只手：04 02
                屏串 01 包名址 02
                屏换行 01 02
             09
         09
        包装进数 = 01 包装进数 ht 1 02
        i = i ht 1
     09
    屏设色 01 0x37C46A 02
    屏串 01 03  装包完成：04 02
    屏数 01 包装进数 02
    屏串 01 03  个成员，对象区现有 04 02
    屏数 01 盘对象数 02
    屏串 01 03  个对象04 02
    屏换行 01 02
    zz 1
 09

@ ============================================================
@ 找可执行成员，把代码搬到 0x400000
@ ============================================================
tt 包_跑 01 02 -> u64  08
    tz i = 0
    ll  08
        lz i 包成员数  08 ls  09
        tz 可装 = 0
        lz zt 包_成员类型 01 i 02 1  08
            可装 = 1
         09
        lz zt 包_成员类型 01 i 02 4  08
            可装 = 1
         09
        lz 可装 1  08
            tz off = 包取32 01 01 包清单 ht i ht 32 ht 20 02 02
            tz ln = 包取32 01 01 包清单 ht i ht 32 ht 16 02 02
            tz ent = 包取32 01 01 包清单 ht i ht 32 ht 28 02 02
            tz k = 0
            ll  08
                lz k 16384  08 ls  09
                st 01 包加载址 ht k 02 = 0
                k = k ht 1
             09
            tz j = 0
            ll  08
                lz j ln  08 ls  09
                tz v = fh 01 包数据 ht off ht j 02
                st 01 包加载址 ht j 02 = v
                j = j ht 1
             09
            包可执行入口 = ent
            包可执行偏移 = off
            包可执行长 = ln
            屏设色 01 0x37C46A 02
            屏串 01 03  可执行成员 04 02
            屏数 01 ln 02
            屏串 01 03  字节 → 已搬到 0x04 02
            zt 打十六_包 01 包加载址 02
            屏串 01 03，入口 0x04 02
            zt 打十六_包 01 ent 02
            屏换行 01 02
            zz ent
         09
        i = i ht 1
     09
    zz 0
 09

@ ============================================================
@ 从盘上读包 + 校验 + 列
@ ============================================================
tt 包_从盘装 01 02 -> u64  08
    包加载址 = 0x400000
    包名址 = 地址 01 包名 02
    包装址 = 地址 01 包装 02
    包址 = 包缓冲址
    屏设色 01 0x8FA6C8 02
    屏串 01 03  从盘上读包（LBA 04 02
    屏数 01 包起始LBA 02
    屏串 01 03）…04 02
    屏换行 01 02
    lz zt 包_读盘 01 包起始LBA  包扇区数 02 0  08
        屏设色 01 0xE0554A 02
        屏串 01 03  读包失败04 02
        屏换行 01 02
        zz 0
     09
    lz zt 包_校验 01 02 0  08
        屏设色 01 0xE0554A 02
        屏串 01 03  这不是一个合法的 .bao v2 包04 02
        屏换行 01 02
        zz 0
     09
    lz zt 视图_给得起 01 包能力 02 0  08
        屏设色 01 0xE0554A 02
        屏串 01 03  这个包要的能力（0x04 02
        zt 打十六_包 01 包能力 02
        屏串 01 03），当前视图只有 0x04 02
        zt 打十六_包 01 01 视图能力 ht 当前视图 02 02
        屏换行 01 02
        zz 0
     09
    zt 包_列 01 02
    zt 包_装 01 02
    zt 包_跑 01 02
    zz 1
 09

@ ============================================================
@ 装包 + 跑里面的可执行成员
@ ============================================================
tt 包_装并跑 01 02 -> u64  08
    lz zt 包_从盘装 01 02 0  08
        zz 0
     09
    tz e = zt 包_跑 01 02
    lz e 0  08
        屏设色 01 0xE0554A 02
        屏串 01 03  包里没有可执行成员04 02
        屏换行 01 02
        zz 0
     09
    调用 01 e  0  0  屏宽 01 02  屏高 01 02 02
    屏设色 01 0x37C46A 02
    屏串 01 03  程序已退出04 02
    屏换行 01 02
    zz 1
 09
