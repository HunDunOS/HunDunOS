00 ============================================================
00 混沌桌面 - 六爻语言正确版
00 ============================================================

00 ---- 全局变量 ----
ts 鼠标x = 400
ts 鼠标y = 300
ts 按钮x = 340
ts 按钮y = 260

00 ---- 函数 ----
tt 主 01 argv 02 -> u64  08
    00 清屏 - 画背景
    zt 画矩形 0, 0, 800, 600, 0x1a1a2e

    00 画标题
    zt pc 300, 50, dd "混沌桌面 v0.1", 0x00ff88

    00 画按钮
    zt 画矩形 按钮x, 按钮y, 120, 40, 0x0f3460
    zt 画矩形 按钮x, 按钮y, 120, 2, 0xffffff
    zt 画矩形 按钮x, 按钮y+38, 120, 2, 0x000000
    zt pc 按钮x+20, 按钮y+12, dd "点我", 0xffffff

    00 画另一个按钮
    zt 画矩形 340, 320, 120, 40, 0x0f3460
    zt pc 340+20, 320+12, dd "系统信息", 0xffffff

    00 画底部栏
    zt 画矩形 0, 570, 800, 30, 0x16213e
    zt pc 10, 578, dd "HunDunOS 一切皆哈希", 0xaaaaaa

    00 死循环 - 等鼠标
    ll  08
        zt 读鼠标
        00 检测按钮点击
        lr 鼠标x > 按钮x & 鼠标x < 按钮x+120 & 鼠标y > 按钮y & 鼠标y < 按钮y+40  08
            zt pc 340, 200, dd "你点了按钮!", 0xff0000
         09
     09

    zz 0
 09

00 ============================================================
00 用法：
00 1. 画矩形(x, y, w, h, 颜色)
00 2. pc(x, y, 字符串, 颜色)
00 3. 读鼠标() - 更新 鼠标x/鼠标y
00 ============================================================
