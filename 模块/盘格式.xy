@ ============================================================================
@  混沌 HDGX 盘格式（HDGX.xy）—— 新加的一个模块
@
@  NTFS 是树，ext4 是树，HDGX 是【图】。
@  这不是"文件系统"，是【内容寻址的对象存储 + 一条单调轴】。
@
@  超级块   魔数 + 版本 + 各处位置 + 追加指针 + 当前视图根 + 自校验
@  对象区   只追加，永不原地改写。对象 := 魔数/类型/长度/哈希/内容
@  索引区   哈希 → 扇区号。索引本身也是可以版本化的对象（v1 先做扁平表）
@  轴区     只增不减：谁在什么时候存了什么（v1 先只追加记录）
@
@  v1 的简化（写在这里，别假装没有）：
@    · 一个对象占一个扇区 → 内容 ≤ 480 字节
@    · 索引是扁平表，不是对象（以后要改成对象）
@    · 没有墓碑/GC/世代折叠
@ ============================================================================

@ --- 布局常量 ---
@ LBA0 超级块A  LBA1 超级块B  LBA2 视图记录
@ LBA3..18 索引区(16扇区=1024项)  LBA19.. 对象区  LBA4096 轴区

qj 盘缓冲[512]: u32              @ 与 盘.xy 共享（.comm 合并成一份）

qj 盘版本: u32
qj 盘总扇区: u32
qj 盘索引起: u32
qj 盘索引数: u32
qj 盘对象起: u32
qj 盘追加: u32
qj 盘轴起: u32
qj 盘轴数: u32
qj 盘视图根: u32
qj 盘对象数: u32
qj 盘世代: u32

qj 取回[512]: u32                @ 取回来的内容（NUL 结尾）
qj 取回址: u32

@ ============================================================================
@  一、扇区内的字节读写（盘缓冲 每槽一字节）
@ ============================================================================
hs 扇置(off: u32, v: u32) -> u32 {
    盘缓冲[off] = v % 256
    fh 0
}

hs 扇置32(off: u32, v: u32) -> u32 {
    扇置(off, v % 256)
    扇置(off + 1, (v / 256) % 256)
    扇置(off + 2, (v / 65536) % 256)
    扇置(off + 3, (v / 16777216) % 256)
    fh 0
}

hs 扇取32(off: u32) -> u32 {
    fh 盘缓冲[off] + 盘缓冲[off + 1] * 256 + 盘缓冲[off + 2] * 65536 + 盘缓冲[off + 3] * 16777216
}

@ FNV-1a，对盘缓冲前 n 字节
hs 扇校验(n: u32) -> u32 {
    kb h: u32 = 2166136261
    kb i: u32 = 0
    dy i < n {
        h = h yh 盘缓冲[i]
        h = h * 16777619
        i = i + 1
    }
    fh h
}

hs 串写扇(off: u32, s: u32, n: u32) -> u32 {
    kb i: u32 = 0
    dy i < n {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        扇置(off + i, c)
        i = i + 1
    }
    fh 0
}

@ ============================================================================
@  二、超级块
@ ============================================================================
hs 超级块组装() -> u32 {
    kb i: u32 = 0
    dy i < 512 {
        盘缓冲[i] = 0
        i = i + 1
    }
    扇置(0, 72)                  @ 'H'
    扇置(1, 68)                  @ 'D'
    扇置(2, 71)                  @ 'G'
    扇置(3, 88)                  @ 'X'
    扇置32(4, 盘版本)
    扇置32(8, 512)               @ 块大小
    扇置32(12, 盘总扇区)
    扇置32(16, 2)                @ 视图记录 LBA
    扇置32(20, 盘索引起)
    扇置32(24, 盘索引数)
    扇置32(28, 盘对象起)
    扇置32(32, 盘追加)
    扇置32(36, 盘轴起)
    扇置32(40, 盘轴数)
    扇置32(44, 盘视图根)
    扇置32(48, 盘对象数)
    扇置32(52, 盘世代)
    扇置32(56, 扇校验(56))       @ 自校验
    fh 0
}

hs 超级块写(哪块: u32) -> u32 {
    超级块组装()
    rg 哪块 == 0 { fh 盘写扇区(0) }
    fh 盘写扇区(1)
}

hs 块世代(哪块: u32) -> u32 {
    rg 盘读扇区(哪块) == 0 { fh 0 }
    rg 扇取32(0) != 0x58474448 { fh 0 }        @ "HDGX"
    kb 存: u32 = 扇取32(56)
    扇置32(56, 0)
    kb 算: u32 = 扇校验(56)
    扇置32(56, 存)
    rg 算 != 存 { fh 0 }
    fh 扇取32(52)                               @ 世代号
}

hs 载入字段() -> u32 {
    盘版本 = 扇取32(4)
    盘总扇区 = 扇取32(12)
    盘索引起 = 扇取32(20)
    盘索引数 = 扇取32(24)
    盘对象起 = 扇取32(28)
    盘追加 = 扇取32(32)
    盘轴起 = 扇取32(36)
    盘轴数 = 扇取32(40)
    盘视图根 = 扇取32(44)
    盘对象数 = 扇取32(48)
    盘世代 = 扇取32(52)
    fh 1
}

@ 双超级块：读世代号大的那一块（写的时候 A/B 交替，防止写一半崩掉）
hs 超级块读() -> u32 {
    kb ga: u32 = 块世代(0)
    kb gb: u32 = 块世代(1)
    rg ga == 0 {
        rg gb == 0 { fh 0 }
        块世代(1)
        fh 载入字段()
    }
    rg gb == 0 {
        块世代(0)
        fh 载入字段()
    }
    rg gb > ga {
        块世代(1)
        fh 载入字段()
    }
    块世代(0)
    fh 载入字段()
}

@ ============================================================================
@  三、索引区：哈希 → 扇区号
@ ============================================================================
hs 索引找(h: u32) -> u32 {
    kb i: u32 = 0
    kb 扇: u32 = 0
    dy 扇 < 16 {
        rg 盘读扇区(盘索引起 + 扇) == 0 { fh 0xFFFFFFFF }
        kb j: u32 = 0
        dy j < 64 {
            kb off: u32 = j * 8
            rg 扇取32(off) == h {
                rg h != 0 { fh 扇取32(off + 4) }
            }
            j = j + 1
        }
        扇 = 扇 + 1
    }
    fh 0xFFFFFFFF
}

hs 索引加(h: u32, lba: u32) -> u32 {
    kb 扇: u32 = 0
    dy 扇 < 16 {
        rg 盘读扇区(盘索引起 + 扇) == 0 { fh 0 }
        kb j: u32 = 0
        dy j < 64 {
            kb off: u32 = j * 8
            rg 扇取32(off) == 0 {
                扇置32(off, h)
                扇置32(off + 4, lba)
                盘写扇区(盘索引起 + 扇)
                fh 1
            }
            j = j + 1
        }
        扇 = 扇 + 1
    }
    fh 0
}

@ ============================================================================
@  四、对象区：只追加
@ ============================================================================
@ 扇区布局： 0..3 魔数"OBJ\0"  4 类型  8 长度  12 哈希  16..495 内容  496 校验
hs 对象写扇(内容: u32, 长: u32, 哈希: u32, 类型: u32) -> u32 {
    kb i: u32 = 0
    dy i < 512 {
        盘缓冲[i] = 0
        i = i + 1
    }
    扇置(0, 79)                  @ 'O'
    扇置(1, 66)                  @ 'B'
    扇置(2, 74)                  @ 'J'
    扇置(3, 0)
    扇置32(4, 类型)
    扇置32(8, 长)
    扇置32(12, 哈希)
    串写扇(16, 内容, 长)
    扇置32(496, 扇校验(496))
    fh 盘写扇区(盘追加)
}

hs 对象读扇(lba: u32) -> u32 {
    rg 盘读扇区(lba) == 0 { fh 0 }
    rg 扇取32(0) != 0x004A424F { fh 0 }        @ "OBJ\0"
    kb 存: u32 = 扇取32(496)
    扇置32(496, 0)
    rg 扇校验(496) != 存 { fh 0 }               @ 扇区自校验
    fh 1
}

@ 对象内容的长度（读扇之后用）
hs 对象长() -> u32 {
    fh 扇取32(8)
}

hs 对象哈希() -> u32 {
    fh 扇取32(12)
}

@ ============================================================================
@  五、对外：格式化 / 存 / 取 / 列
@ ============================================================================
hs 盘格式化(总扇: u32) -> u32 {
    盘版本 = 1
    盘总扇区 = 总扇
    盘索引起 = 3
    盘索引数 = 1024
    盘对象起 = 19
    盘追加 = 19
    盘轴起 = 4096
    盘轴数 = 0
    盘视图根 = 0
    盘对象数 = 0
    盘世代 = 1

    @ 清索引区
    kb s: u32 = 0
    dy s < 16 {
        kb i: u32 = 0
        dy i < 512 {
            盘缓冲[i] = 0
            i = i + 1
        }
        盘写扇区(盘索引起 + s)
        s = s + 1
    }
    超级块写(0)
    超级块写(1)
    fh 1
}

@ 存一个字符串对象 → 返回哈希（0 表示失败）
hs 盘存对象(串: u32) -> u32 {
    kb h: u32 = 2166136261          @ ★ FNV-1a 的偏移基数，不是 0
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(串 + i) }
        rg c == 0 { tc }
        h = h yh c
        h = h * 16777619
        i = i + 1
    }
    rg h == 0 { fh 0 }
    @ 查重：已经有就直接复用（去重白送）
    kb 老: u32 = 索引找(h)
    rg 老 != 0xFFFFFFFF {
        盘视图根 = h
        盘世代 = 盘世代 + 1
        超级块写(盘世代 % 2)
        fh h
    }
    kb 长: u32 = i
    rg 长 > 480 { fh 0 }
    对象写扇(串, 长, h, 1)
    rg 索引加(h, 盘追加) == 0 { fh 0 }
    盘追加 = 盘追加 + 1
    盘对象数 = 盘对象数 + 1
    盘世代 = 盘世代 + 1
    @ 轴：只增不减
    盘轴数 = 盘轴数 + 1
    盘视图根 = h
    超级块写(盘世代 % 2)
    fh h
}

@ 按哈希取回来 → 写进 取回（NUL 结尾），返回长度
hs 盘取对象(h: u32) -> u32 {
    kb lba: u32 = 索引找(h)
    rg lba == 0xFFFFFFFF { fh 0 }
    rg 对象读扇(lba) == 0 { fh 0 }
    rg 对象哈希() != h { fh 0 }                 @ 内容寻址：哈希不对就不是它
    kb n: u32 = 对象长()
    kb i: u32 = 0
    @ ★ 必须用【指针写】按字节塞进去：新语的数组槽是 32 位，
    @   写成 取回[i]=v 的话，第 2 个字节是 0，字符串当场断掉
    dy i < n {
        kb v: u32 = 盘缓冲[16 + i]
        wx { ^(取回址 + i) = v }
        i = i + 1
    }
    wx { ^(取回址 + n) = 0 }
    fh n
}

@ 取回缓冲的内容当字符串印出来
hs 取回印() -> u32 {
    印串(取回址)          @ ★ 印(变量) 打的是【数字】，打字符串要用 印串()
    fh 0
}

@ ============================================================================
@  六、自检：第一次运行格式化并写入，第二次运行读回来
@      —— 重启一次就知道"东西真的落在盘上了"
@ ============================================================================
hs 盘格式自检() -> u32 {
    wx { 取回址 = 地址(取回) }
    rg 盘就绪吗() == 0 {
        印("[HDGX] 没有盘\n")
        fh 0
    }

    rg 超级块读() == 1 {
        印("[HDGX] 盘上已有格式：版本 ")
        印(盘版本)
        印("  世代 ")
        印(盘世代)
        印("  对象数 ")
        印(盘对象数)
        印("  追加指针 LBA ")
        印(盘追加)
        印("\n")
        kb h: u32 = 盘存对象("混沌")
        印("[HDGX] 按哈希取回「混沌」→ 「")
        rg 盘取对象(h) > 0 { 取回印() }
        印("」\n")
        kb h2: u32 = 盘存对象("一切皆哈希")
        印("[HDGX] 取回第二个 → 「")
        rg 盘取对象(h2) > 0 { 取回印() }
        印("」\n")
        fh 1
    }

    印("[HDGX] 盘上没有格式，开始格式化…\n")
    盘格式化(16384)
    kb a: u32 = 盘存对象("混沌")
    印("[HDGX] 存入「混沌」→ 哈希 ")
    印(a)
    印("\n")
    kb b: u32 = 盘存对象("一切皆哈希")
    印("[HDGX] 存入「一切皆哈希」→ 哈希 ")
    印(b)
    印("\n")
    kb c: u32 = 盘存对象("混沌")
    印("[HDGX] 再存一次「混沌」→ 哈希 ")
    印(c)
    rg c == a { 印("  （同一个哈希 = 去重生效，没占新扇区）\n") }
    rg c != a { 印("  （哈希不同 ✗）\n") }
    印("[HDGX] 现在重启一次，看它还在不在\n")
    fh 1
}
