@ ============================================================================
@  编辑器（编辑器.xy）—— 用新语写的文本编辑器
@
@  它不是编进内核的，而是【打成一个 .bao 包】，由内核装了才能用 ——
@  这就是"内核不吃包，内核吃对象；包只是运输外壳"的实证。
@
@  复用 笔.xy 的设计要点：
@    · 撤销不是"逆操作"，而是【指回上一个快照】（对应公理 1：不可变）
@    · 每次修改前自动存快照，环形 8 份
@
@  按键
@    普通模式：直接打字，回车换行，退格删除，方向键移动
@    Esc 或 :       进命令模式
@  命令（回车执行）
@     cun  <哈希>   把缓冲区存成对象（不带哈希就用当前文档的哈希）
@     qu   <哈希>   按哈希读一份文档进来
@     xin           看这份文档的哈希和长度
@     tui           退出编辑器
@ ============================================================================

@ ---- 借用内核（壳.xy / 盘格式.xy）的东西：链接时合并成同一份 ─---
@   写在这儿的只是【声明】，不占新空间
qj 光x: u32
qj 光y: u32
qj 区x: u32
qj 区y: u32
qj 区宽: u32
qj 区高: u32
qj 当前色: u32
qj 取回址: u32
qj 取回[512]: u32

qj 编区x: u32
qj 编区y: u32
qj 编区宽: u32
qj 编区高: u32

qj 编缓冲[2048]: u32        @ 正文，每槽一个字节
qj 编长: u32
qj 编光标: u32
qj 编行: u32                @ 光标在第几行
qj 编列: u32                @ 光标在第几列
qj 编哈希: u32              @ 当前文档的哈希（0 = 新文档）
qj 编状态[64]: u32          @ 状态栏文字
qj 编状态址: u32
qj 编地址: u32

@ 快照（撤销）：环形 8 份
qj 编快照[2048]: u32
qj 编快照长[4]: u32
qj 编快照数: u32
qj 编快照位: u32

qj 编命令[64]: u32
qj 编命令址: u32
qj 编模式: u32              @ 0=普通 1=命令
qj 编命令长: u32

@ ---------------------------------------------------------------------------
@  小工具：字符串 / 数字
@ ---------------------------------------------------------------------------
hs 编_串长(s: u32) -> u32 {
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        i = i + 1
    }
    fh i
}

hs 编_串抄(出: u32, s: u32) -> u32 {
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c == 0 { tc }
        wx { ^(出 + i) = c }
        i = i + 1
    }
    wx { ^(出 + i) = 0 }
    fh i
}

hs 编_串转数(s: u32) -> u32 {
    kb n: u32 = 0
    kb i: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(s + i) }
        rg c < 48 { tc }
        rg c > 57 { tc }
        n = n * 10 + (c - 48)
        i = i + 1
    }
    fh n
}

@ 把哈希写成 8 位十六进制到 编状态
hs 编_写哈希(h: u32) -> u32 {
    kb i: u32 = 0
    dy i < 8 {
        kb sh: u32 = (7 - i) * 4
        kb t: u32 = (h / (1 << sh)) % 16
        kb c: u32 = 48 + t
        rg t >= 10 { c = 87 + t }
        编状态[i] = c
        i = i + 1
    }
    编状态[8] = 0
    fh 0
}

@ ---------------------------------------------------------------------------
@  快照 / 撤销（指回上一个快照，不是逆操作）
@ ---------------------------------------------------------------------------
hs 编_存快照() -> u32 {
    rg 编快照数 >= 4 {
        kb k: u32 = 0
        dy k < 3 {
            kb i: u32 = 0
            dy i < 编快照长[k + 1] {
                编快照[k * 512 + i] = 编快照[(k + 1) * 512 + i]
                i = i + 1
            }
            编快照长[k] = 编快照长[k + 1]
            k = k + 1
        }
        编快照数 = 3
    }
    kb 位: u32 = 编快照数
    rg 编长 > 512 { fh 0 }
    kb j: u32 = 0
    dy j < 编长 {
        编快照[位 * 512 + j] = 编缓冲[j]
        j = j + 1
    }
    编快照长[位] = 编长
    编快照数 = 编快照数 + 1
    fh 0
}

hs 编_回退() -> u32 {
    rg 编快照数 < 2 { fh 0 }
    编快照数 = 编快照数 - 1
    kb 位: u32 = 编快照数 - 1
    kb n: u32 = 编快照长[位]
    kb i: u32 = 0
    dy i < n {
        编缓冲[i] = 编快照[位 * 512 + i]
        i = i + 1
    }
    编长 = n
    rg 编光标 > 编长 { 编光标 = 编长 }
    fh 0
}

@ ---------------------------------------------------------------------------
@  编辑操作
@ ---------------------------------------------------------------------------
hs 编_算行列() -> u32 {
    kb i: u32 = 0
    kb 行: u32 = 0
    kb 列: u32 = 0
    dy i < 编光标 {
        rg 编缓冲[i] == 10 {
            行 = 行 + 1
            列 = 0
        }
        列 = 列 + 1
        i = i + 1
    }
    编行 = 行
    编列 = 列
    fh 0
}

hs 编_插(c: u32) -> u32 {
    rg 编长 >= 2000 { fh 0 }
    编_存快照()
    kb j: u32 = 编长
    dy j > 编光标 {
        编缓冲[j] = 编缓冲[j - 1]
        j = j - 1
    }
    编缓冲[编光标] = c
    编长 = 编长 + 1
    编光标 = 编光标 + 1
    fh 0
}

hs 编_删前() -> u32 {
    rg 编光标 == 0 { fh 0 }
    编_存快照()
    kb i: u32 = 编光标 - 1
    dy i < 编长 - 1 {
        编缓冲[i] = 编缓冲[i + 1]
        i = i + 1
    }
    编长 = 编长 - 1
    编光标 = 编光标 - 1
    fh 0
}

@ ---------------------------------------------------------------------------
@  画
@ ---------------------------------------------------------------------------
hs 编_状态栏(左: u32) -> u32 {
    光x = 编区x + 6
    光y = 编区y + 编区高 - 24
    绘块(编区x, 编区y + 编区高 - 26, 编区宽, 26, 0x14203A)
    屏设色(0x8FA6C8)
    屏串(左)
    光x = 编区x + 编区宽 - 260
    屏设色(0x37C46A)
    屏串("哈希 ")
    rg 编哈希 != 0 { 编_写哈希(编哈希)  屏串(编状态址) }
    rg 编哈希 == 0 { 屏串("(新文档)" ) }
    光x = 编区x + 编区宽 - 90
    屏设色(0x5F7A9C)
    屏串("行 ")
    屏数(编行 + 1)
    fh 0
}

hs 编_画() -> u32 {
    @ 只清正文区（留着状态栏）
    绘块(编区x, 编区y, 编区宽, 编区高 - 28, 0x0A0E18)
    光x = 编区x + 6
    光y = 编区y + 6
    屏设色(0xE8F0FF)
    kb i: u32 = 0
    dy i < 编长 {
        kb c: u32 = 编缓冲[i]
        rg c == 10 { 屏换行() }
        rg c != 10 { 屏出(c) }
        @ 光标位置：画一个亮的竖条
        rg i + 1 == 编光标 {
            绘块(光x, 光y, 2, 18, 0x37C46A)
        }
        i = i + 1
    }
    rg 编光标 >= 编长 { 绘块(光x, 光y, 2, 18, 0x37C46A) }
    编_状态栏("  直接打字 · 退格删 · 方向键移动 · : 进命令")
    fh 0
}

@ ---------------------------------------------------------------------------
@  文档存取
@ ---------------------------------------------------------------------------
hs 编_存(名字: u32) -> u32 {
    @ 把正文末尾补 0，再当字符串存成对象
    编缓冲[编长] = 0
    kb h: u32 = 盘存对象(编地址)
    编哈希 = h
    fh h
}

hs 编_读(h: u32) -> u32 {
    rg 盘取对象(h) == 0 { fh 0 }
    kb n: u32 = 0
    xh {
        kb c: u32 = 0
        wx { c = ^(取回址 + n) }
        rg c == 0 { tc }
        rg n >= 2000 { tc }
        编缓冲[n] = c
        n = n + 1
    }
    编长 = n
    编光标 = 0
    编哈希 = h
    fh n
}

@ ---------------------------------------------------------------------------
@  命令
@ ---------------------------------------------------------------------------
hs 编_执行命令() -> u32 {
    wx { ^(编命令址 + 编命令长) = 0 }
    @ 跳过前导空格
    kb p: u32 = 编命令址
    xh {
        kb c: u32 = 0
        wx { c = ^(p) }
        rg c != 32 { tc }
        p = p + 1
    }
    kb 首: u32 = 0
    wx { 首 = ^(p) }
    @ tui —— 退出
    rg 首 == 116 {
        kb c2: u32 = 0
        wx { c2 = ^(p + 1) }
        rg c2 == 117 { fh 1 }
    }
    @ qu <哈希> —— 读文档
    rg 首 == 113 {
        kb a: u32 = 编_串转数(p + 3)
        rg a != 0 {
            rg 编_读(a) > 0 { fh 0 }
        }
        fh 0
    }
    @ xin —— 看哈希
    rg 首 == 120 { fh 0 }
    @ cun —— 存
    rg 首 == 99 {
        kb a2: u32 = 编_串转数(p + 4)
        rg a2 != 0 { 编哈希 = a2 }
        编_存(p)
        fh 0
    }
    fh 0
}

@ ---------------------------------------------------------------------------
@  入口：内核装完包之后调这里（或壳里 bianji 命令调）
@ ---------------------------------------------------------------------------
hs 编辑器主(x: u32, y: u32, w: u32, h: u32) -> u32 {
    编区x = x
    编区y = y
    编区宽 = w
    编区高 = h
    设区(x, y, w, h)
    编长 = 0
    编光标 = 0
    编哈希 = 0
    编快照数 = 0
    编模式 = 0
    编命令长 = 0
    编命令址 = 编地址 + 4096      @ 命令缓冲接在正文后面
    编状态址 = 编命令址 + 64
    编_画()
    xh {
        kb k: u32 = 键()
        rg k == 0 { 睡(8)  jx }
        rg 编模式 == 1 {
            rg k == 13 {
                编模式 = 0
                rg 编_执行命令() == 1 { fh 0 }
                编_画()
                jx
            }
            rg k == 8 {
                rg 编命令长 > 0 { 编命令长 = 编命令长 - 1 }
                jx
            }
            rg k >= 32 {
                rg 编命令长 < 40 {
                    wx { ^(编命令址 + 编命令长) = k }
                    编命令长 = 编命令长 + 1
                }
            }
            jx
        }
        rg k == 58 { 编模式 = 1  编命令长 = 0  jx }   @ :
        rg k == 13 { 编_插(10)  编_画()  jx }
        rg k == 8 { 编_删前()  编_画()  jx }
        rg k == 19 {
            rg 编光标 > 0 { 编光标 = 编光标 - 1  编_算行列()  编_画() }
            jx
        }
        rg k == 20 {
            rg 编光标 < 编长 { 编光标 = 编光标 + 1  编_算行列()  编_画() }
            jx
        }
        rg k >= 32 {
            编_插(k)
            编_算行列()
            编_画()
        }
    }
    fh 0
}
