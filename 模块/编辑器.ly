@ ============================================================
@ 编辑器（编辑器.ly）—— 用六爻写的文本编辑器
@ ============================================================

@ ---- 全局变量 ----
ts 光x = 0
ts 光y = 0
ts 区x = 0
ts 区y = 0
ts 区宽 = 0
ts 区高 = 0
ts 当前色 = 0
ts 取回址 = 0
ts 取回[512] = 0

ts 编区x = 0
ts 编区y = 0
ts 编区宽 = 0
ts 编区高 = 0

ts 编缓冲[2048] = 0
ts 编长 = 0
ts 编光标 = 0
ts 编行 = 0
ts 编列 = 0
ts 编哈希 = 0
ts 编状态[64] = 0
ts 编状态址 = 0
ts 编地址 = 0

ts 编快照[2048] = 0
ts 编快照长[4] = 0
ts 编快照数 = 0
ts 编快照位 = 0

ts 编命令[64] = 0
ts 编命令址 = 0
ts 编模式 = 0
ts 编命令长 = 0

@ ============================================================
@ 小工具：字符串 / 数字
@ ============================================================
tt 编_串长 01 s 02 -> u64  08
    tz i = 0
    ll  08
        tz c = fh 01 s ht i 02
        lz c 0  08 ls  09
        i = i ht 1
     09
    zz i
 09

tt 编_串抄 01 出  s 02 -> u64  08
    tz i = 0
    ll  08
        tz c = fh 01 s ht i 02
        lz c 0  08 ls  09
        st 01 出 ht i 02 = c
        i = i ht 1
     09
    st 01 出 ht i 02 = 0
    zz i
 09

tt 编_串转数 01 s 02 -> u64  08
    tz n = 0
    tz i = 0
    ll  08
        tz c = fh 01 s ht i 02
        lh c 48  08 ls  09
        lh c 57  08 ls  09
        n = 01 01 n ht 10 02 ht 01 c - 48 02 02
        i = i ht 1
     09
    zz n
 09

tt 编_写哈希 01 h 02 -> u64  08
    tz i = 0
    ll  08
        lz i 8  08 ls  09
        tz sh = 01 01 7 - i 02 ht 4 02
        tz t = 01 01 h / 01 1 ht sh 02 02 % 16 02
        tz c = 01 48 ht t 02
        lh t 10  08
            c = 01 87 ht t 02
         09
        st 01 编状态 ht i 02 = c
        i = i ht 1
     09
    st 01 编状态 ht 8 02 = 0
    zz 0
 09

@ ============================================================
@ 快照 / 撤销
@ ============================================================
tt 编_存快照 01 02 -> u64  08
    lh 编快照数 4  08
        tz k = 0
        ll  08
            lz k 3  08 ls  09
            tz i = 0
            ll  08
                lz i 01 编快照长 ht 01 k ht 1 02 02  08 ls  09
                st 01 编快照 ht 01 k ht 512 ht i 02 02 = 01 编快照 ht 01 01 k ht 1 02 ht 512 ht i 02 02
                i = i ht 1
             09
            st 01 编快照长 ht k 02 = 01 编快照长 ht 01 k ht 1 02 02
            k = k ht 1
         09
        编快照数 = 3
     09
    tz 位 = 编快照数
    lh 编长 512  08
        zz 0
     09
    tz j = 0
    ll  08
        lz j 编长  08 ls  09
        st 01 编快照 ht 01 位 ht 512 ht j 02 02 = 01 编缓冲 ht j 02
        j = j ht 1
     09
    st 01 编快照长 ht 位 02 = 编长
    编快照数 = 01 编快照数 ht 1 02
    zz 0
 09

tt 编_回退 01 02 -> u64  08
    lh 编快照数 2  08
        zz 0
     09
    编快照数 = 01 编快照数 - 1 02
    tz 位 = 01 编快照数 - 1 02
    tz n = 01 编快照长 ht 位 02
    tz i = 0
    ll  08
        lz i n  08 ls  09
        st 01 编缓冲 ht i 02 = 01 编快照 ht 01 位 ht 512 ht i 02 02
        i = i ht 1
     09
    编长 = n
    lh 编光标 编长  08
        编光标 = 编长
     09
    zz 0
 09

@ ============================================================
@ 编辑操作
@ ============================================================
tt 编_算行列 01 02 -> u64  08
    tz i = 0
    tz 行 = 0
    tz 列 = 0
    ll  08
        lz i 编光标  08 ls  09
        lz 01 编缓冲 ht i 02 10  08
            行 = 01 行 ht 1 02
            列 = 0
         09
        列 = 01 列 ht 1 02
        i = i ht 1
     09
    编行 = 行
    编列 = 列
    zz 0
 09

tt 编_插 01 c 02 -> u64  08
    lh 编长 2000  08
        zz 0
     09
    zt 编_存快照 01 02
    tz j = 编长
    ll  08
        lh j 编光标  08 ls  09
        st 01 编缓冲 ht j 02 = 01 编缓冲 ht 01 j - 1 02 02
        j = 01 j - 1 02
     09
    st 01 编缓冲 ht 编光标 02 = c
    编长 = 01 编长 ht 1 02
    编光标 = 01 编光标 ht 1 02
    zz 0
 09

tt 编_删前 01 02 -> u64  08
    lz 编光标 0  08
        zz 0
     09
    zt 编_存快照 01 02
    tz i = 01 编光标 - 1 02
    ll  08
        lz i 01 编长 - 1 02  08 ls  09
        st 01 编缓冲 ht i 02 = 01 编缓冲 ht 01 i ht 1 02 02
        i = i ht 1
     09
    编长 = 01 编长 - 1 02
    编光标 = 01 编光标 - 1 02
    zz 0
 09

@ ============================================================
@ 画
@ ============================================================
tt 编_状态栏 01 左 02 -> u64  08
    光x = 01 编区x ht 6 02
    光y = 01 编区y ht 01 编区高 - 24 02
    绘块 01 编区x  01 编区y ht 01 编区高 - 26 02  编区宽  26  0x14203A 02
    屏设色 01 0x8FA6C8 02
    屏串 01 左 02
    光x = 01 编区x ht 01 编区宽 - 260 02
    屏设色 01 0x37C46A 02
    屏串 01 03哈希 04 02
    lh 编哈希 0  08
        zt 编_写哈希 01 编哈希 02
        屏串 01 编状态址 02
     09
    lz 编哈希 0  08
        屏串 01 03(新文档)04 02
     09
    光x = 01 编区x ht 01 编区宽 - 90 02
    屏设色 01 0x5F7A9C 02
    屏串 01 03行 04 02
    屏数 01 01 编行 ht 1 02 02
    zz 0
 09

tt 编_画 01 02 -> u64  08
    绘块 01 编区x  编区y  编区宽  01 编区高 - 28 02  0x0A0E18 02
    光x = 01 编区x ht 6 02
    光y = 01 编区y ht 6 02
    屏设色 01 0xE8F0FF 02
    tz i = 0
    ll  08
        lz i 编长  08 ls  09
        tz c = 01 编缓冲 ht i 02
        lz c 10  08
            屏换行 01 02
         09
        lh c 10  08
            屏出 01 c 02
         09
        lz 01 i ht 1 02 编光标  08
            绘块 01 光x  光y  2  18  0x37C46A 02
         09
        i = i ht 1
     09
    lh 编光标 编长  08
        绘块 01 光x  光y  2  18  0x37C46A 02
     09
    zt 编_状态栏 01 03  直接打字 · 退格删 · 方向键移动 · : 进命令04 02
    zz 0
 09

@ ============================================================
@ 文档存取
@ ============================================================
tt 编_存 01 名字 02 -> u64  08
    st 01 编缓冲 ht 编长 02 = 0
    tz h = zt 盘存对象 01 编地址 02
    编哈希 = h
    zz h
 09

tt 编_读 01 h 02 -> u64  08
    lz zt 盘取对象 01 h 02 0  08
        zz 0
     09
    tz n = 0
    ll  08
        tz c = fh 01 取回址 ht n 02
        lz c 0  08 ls  09
        lh n 2000  08 ls  09
        st 01 编缓冲 ht n 02 = c
        n = n ht 1
     09
    编长 = n
    编光标 = 0
    编哈希 = h
    zz n
 09

@ ============================================================
@ 命令
@ ============================================================
tt 编_执行命令 01 02 -> u64  08
    st 01 编命令址 ht 编命令长 02 = 0
    tz p = 编命令址
    ll  08
        tz c = fh 01 p 02
        lh c 32  08 ls  09
        p = p ht 1
     09
    tz 首 = fh 01 p 02
    lz 首 116  08
        tz c2 = fh 01 p ht 1 02
        lz c2 117  08
            zz 1
         09
     09
    lz 首 113  08
        tz a = zt 编_串转数 01 p ht 3 02
        lh a 0  08
            lh zt 编_读 01 a 02 0  08
                zz 0
             09
         09
        zz 0
     09
    lz 首 120  08
        zz 0
     09
    lz 首 99  08
        tz a2 = zt 编_串转数 01 p ht 4 02
        lh a2 0  08
            编哈希 = a2
         09
        zt 编_存 01 p 02
        zz 0
     09
    zz 0
 09

@ ============================================================
@ 入口
@ ============================================================
tt 编辑器主 01 x  y  w  h 02 -> u64  08
    编区x = x
    编区y = y
    编区宽 = w
    编区高 = h
    设区 01 x  y  w  h 02
    编长 = 0
    编光标 = 0
    编哈希 = 0
    编快照数 = 0
    编模式 = 0
    编命令长 = 0
    编命令址 = 01 编地址 ht 4096 02
    编状态址 = 01 编命令址 ht 64 02
    zt 编_画 01 02
    ll  08
        tz k = 键 01 02
        lz k 0  08
            睡 01 8 02
            lx
         09
        lz 编模式 1  08
            lz k 13  08
                编模式 = 0
                lz zt 编_执行命令 01 02 1  08
                    zz 0
                 09
                zt 编_画 01 02
                lx
             09
            lz k 8  08
                lh 编命令长 0  08
                    编命令长 = 01 编命令长 - 1 02
                 09
                lx
             09
            lh k 32  08
                lh 编命令长 40  08
                    st 01 编命令址 ht 编命令长 02 = k
                    编命令长 = 01 编命令长 ht 1 02
                 09
             09
            lx
         09
        lz k 58  08
            编模式 = 1
            编命令长 = 0
            lx
         09
        lz k 13  08
            zt 编_插 01 10 02
            zt 编_画 01 02
            lx
         09
        lz k 8  08
            zt 编_删前 01 02
            zt 编_画 01 02
            lx
         09
        lz k 19  08
            lh 编光标 0  08
                编光标 = 01 编光标 - 1 02
                zt 编_算行列 01 02
                zt 编_画 01 02
             09
            lx
         09
        lz k 20  08
            lh 编光标 编长  08
                编光标 = 01 编光标 ht 1 02
                zt 编_算行列 01 02
                zt 编_画 01 02
             09
            lx
         09
        lh k 32  08
            zt 编_插 01 k 02
            zt 编_算行列 01 02
            zt 编_画 01 02
         09
     09
    zz 0
 09
